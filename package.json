{
  "name": "minmin-calendar",
  "private": true,
  "description": "Local syntax, behavior, artifact and coordinate-hit verification for the Minmin Calendar mini program.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node cloudfunctions/_shared/syncRoomMembershipLifecycle.js --check",
    "verify": "node tests/tools/verify.cjs",
    "deps:install": "node tests/tools/dependencyTools.cjs install",
    "deps:check": "node tests/tools/dependencyTools.cjs check",
    "deps:report": "node tests/tools/dependencyTools.cjs report",
    "test:clock": "node tests/tools/clockRegression.cjs",
    "release:prepare": "node tests/tools/prepareRelease.cjs",
    "browser:install": "node tests/tools/installBrowser.cjs",
    "test:hit": "node tests/tools/navHitTest.cjs",
    "impeccable:audit": "node tests/impeccableAudit.mjs",
    "impeccable:detect": "node tests/impeccableDetect.mjs",
    "devtools:preflight": "node tests/tools/devtoolsPreflight.mjs",
    "devtools:resources": "node tests/tools/devtoolsResources.mjs",
    "devtools:timeline": "node tests/tools/devtoolsTimeline.mjs",
    "devtools:cli": "node tests/tools/devtoolsCli.mjs",
    "devtools:mcp": "node tests/tools/wechatMcp.mjs"
  },
  "devDependencies": {
    "jimp": "file:tests/tools/automator-image",
    "jimp-modern": "npm:jimp@1.6.1",
    "miniprogram-automator": "0.12.1",
    "playwright": "1.64.0"
  },
  "overrides": {
    "miniprogram-automator": {
      "jimp": "$jimp"
    },
    "zod": "4.6.7"
  }
}
