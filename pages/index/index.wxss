@import '../shared/confirmation-sheet.wxss';
@import '../shared/retry-row.wxss';
@import '../shared/empty-state.wxss';

/* ===== Aurora Bloom: Index ===== */
.page {
  overflow: hidden;
}
/* 导航标题使用共享顶栏的中性白；月份标题 .month-title 保持玫瑰，因为它打开选月。 */
.content {
  padding: 0 var(--space-page-gutter) 30rpx;
  position: relative;
  z-index: 1;
}
.content-refreshing .calendar-grid,
.content-refreshing .month-summary,
.content-refreshing .empty-guide,
.content-refreshing .quick-actions {
  opacity: 0.94;
}
/* 同步胶囊在顶栏标题槽里（挂载期间替换应用标题），按文案收缩、在槽内居中；
   顶栏在吸顶区之上，胶囊盖不住月份标题和状态行（issue #120、#151） */
.sync-pill {
  min-width: 0;
  min-height: 52rpx;
  margin: 0 auto;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  color: rgba(255,255,255,0.72);
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.13);
  box-shadow: 0 8rpx 26rpx rgba(0,0,0,0.14);
  pointer-events: none;
  opacity: 0;
  transform: translateY(-8rpx);
  transition: opacity var(--duration-exit) var(--ease-out), transform var(--duration-exit) var(--ease-out);
}
.sync-pill.sync-open {
  opacity: 1;
  transform: translateY(0);
  transition: opacity var(--duration-enter) var(--ease-out), transform var(--duration-enter) var(--ease-out);
}
.sync-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-circle);
  background: var(--aurora-gold);
}
.sync-pill.syncing .sync-dot {
  background: #E8909E;
  animation: syncDotPulse 1s ease-in-out infinite;
}
.sync-text {
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-title);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
@keyframes syncDotPulse {
  0%, 100% { opacity: 0.55; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.15); }
}

.partner-welcome,
.partner-invite {
  display: block;
  align-items: center;
  margin: 0;
  /* 各用 1px padding 吸收描边，文案、按钮与边框合计仍严守 103.2rpx 槽高。 */
  padding: calc(8rpx - 1px) 16rpx calc(12rpx - 1px);
  box-sizing: border-box;
  border: 1px solid rgba(232,144,158,0.2);
  border-radius: var(--radius-card);
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  text-align: left;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
}
.partner-welcome {
  color: rgba(255,255,255,0.85);
  transition: transform var(--duration-press) var(--ease-out);
}
.partner-welcome:active,
.partner-welcome.partner-welcome-hover {
  transform: scale(0.98);
}
.partner-invite {
  display: flex;
  align-items: center;
}
.partner-invite-copy {
  flex: 1;
  min-width: 0;
}
.partner-invite-title,
.partner-invite-desc {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.partner-invite-title {
  font-weight: var(--font-weight-control);
}
.home-share-invite {
  transition: transform var(--duration-press) var(--ease-out), background-color var(--duration-press) ease, border-color var(--duration-press) ease;
}
button.home-share-invite {
  flex: 0 0 auto;
  width: auto;
  min-width: 112rpx;
  min-height: 88rpx;
  /* 88 - 2 × 2.4 = 83.2rpx，与左侧两行 caption 同高，不撑大共享槽位。 */
  margin: -2.4rpx 0 -2.4rpx 12rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(232,144,158,0.32);
  border-radius: var(--radius-full);
  background: rgba(232,144,158,0.1);
  color: var(--aurora-pink);
  font-size: var(--font-size-caption);
  line-height: var(--line-height-title);
}
.home-share-invite:active,
.home-share-invite.home-share-invite-hover {
  transform: scale(0.96);
  background: rgba(232,144,158,0.16);
  border-color: rgba(232,144,158,0.45);
}

/* 刷新失败重试句的位置仍在月份导航与周头之间；整行玫瑰句外观共用 shared/retry-row.wxss（#234）。 */

/* ===== Month Navigation – Glassmorphism ===== */
.month-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx;
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.15);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.2);
  border-radius: var(--radius-card);
  margin: 10rpx 0 8rpx;
}
.month-nav::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -30%;
  width: 160%;
  height: 200%;
  background: radial-gradient(ellipse at 40% 30%, rgba(232,144,158,0.1) 0%, transparent 50%);
  pointer-events: none;
}
.month-title {
  font-size: var(--font-size-month-title);
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-title);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  position: relative;
  z-index: 1;
  color: #E8909E;
}
/* 最小宽度兜住最坏文案「2026年12月」：1 位数和 2 位数月份同宽，切月时胶囊不变宽、不挪位（issue #164） */
.month-title-trigger {
  min-height: 88rpx;
  min-width: 344rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  background: rgba(232,144,158,0.09);
  border: 1px solid rgba(232,144,158,0.22);
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.month-title-trigger:active,
.month-title-trigger.month-title-trigger-hover {
  transform: scale(0.97);
  background: rgba(232,144,158,0.16);
}
/* 和月份标题同一玫瑰：按吸顶区 → 月份导航 → 触发钮的实际合成面算，85% 玫瑰只有约 4.2:1（issue #163） */
.month-title-caret {
  font-size: 24rpx;
  line-height: 1;
  color: #E8909E;
  transform: translateY(-2rpx);
}
.nav-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: 1;
  text-align: center;
  font-size: 42rpx;
  color: #fff;
  border-radius: var(--radius-circle);
  background: var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.2);
  position: relative;
  z-index: 1;
  transition: border-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.nav-btn::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: var(--radius-circle);
  background-color: rgba(255,255,255,0.1);
  transition: background-color var(--duration-press) ease;
  pointer-events: none;
  z-index: -1;
}
/* 平涂层盖不到描边带：按下时描边和平涂层一起提亮（issue #166） */
.nav-btn:active,
.nav-btn.nav-btn-hover {
  transform: scale(0.96);
  border-color: rgba(255,255,255,0.3);
}
.nav-btn:active::before,
.nav-btn.nav-btn-hover::before {
  background-color: rgba(255,255,255,0.2);
}
/* 到了最早或最晚可看的月份（issue #159），那一侧的箭头禁用：变淡，按下不缩放、底色和描边不变 */
.nav-btn.disabled {
  opacity: 0.35;
}
.nav-btn:active.disabled,
.nav-btn.nav-btn-hover.disabled {
  transform: none;
  border-color: rgba(255,255,255,0.2);
}
.nav-btn:active.disabled::before,
.nav-btn.nav-btn-hover.disabled::before {
  background-color: rgba(255,255,255,0.1);
}

/* 顶栏图例入口的样式在 pages/shared/nav-bar.wxss。 */

/* 月份导航和状态行固定在顶栏下。页面根有 overflow:hidden，sticky 不可靠。 */
.home-sticky {
  position: fixed;
  top: var(--nav-bar-height, calc(env(safe-area-inset-top, 44px) + 44px));
  left: 0;
  right: 0;
  z-index: 8;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 0 var(--space-page-gutter);
  background: linear-gradient(180deg, rgba(10,14,39,0.86) 0%, rgba(10,14,39,0.94) 100%);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
/* 占位 = 月份导航 130 + 状态行 88（+「回到今天」88），另加月份导航 1px 上下描边与 R5 吸顶底边 1px，下方第一行不被吸顶区盖住 */
.home-sticky-spacer {
  height: calc(218rpx + 3px);
  flex-shrink: 0;
}
.home-sticky-spacer.with-back-today {
  height: calc(306rpx + 3px);
}
.back-today {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  border-radius: var(--radius-md);
  border: 1px solid rgba(255,255,255,0.28);
  background: transparent;
  color: var(--text-primary);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.back-today:active,
.back-today.back-today-hover {
  transform: scale(0.98);
  background: rgba(255,255,255,0.08);
}
.home-status {
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 0 4rpx;
  border-radius: var(--radius-md);
  color: var(--text-primary);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.home-status.neutral {
  color: var(--text-secondary);
}
.home-status-text {
  flex: 1;
  min-width: 0;
  /* issue #247：body-lg 34rpx 会让最长推迟句超过 88rpx 单行账本，保留旧值 32rpx；例外见 DESIGN。 */
  font-size: 32rpx;
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-body);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.home-status-countdown {
  flex: none;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  color: var(--text-secondary);
}
.home-status-arrow {
  flex: none;
  width: 16rpx;
  font-size: 32rpx;
  line-height: 1;
  text-align: center;
  color: var(--text-secondary);
}
.home-status:active,
.home-status.home-status-hover {
  transform: scale(0.98);
  background: rgba(255,255,255,0.06);
}

/* ===== Week Header ===== */
.week-header {
  display: flex;
  padding: 8rpx 10rpx;
  margin-bottom: 0;
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.08);
  border-bottom: 0;
  border-radius: var(--radius-card) var(--radius-card) 0 0;
}
.week-cell {
  flex: 1;
  text-align: center;
  /* 显式行盒，周头高度才是确定的首屏账本项（issue #153） */
  line-height: 34rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: rgba(255,255,255,0.72);
}

/* ===== Calendar Grid – Glass ===== */
.calendar-grid {
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 0 0 var(--radius-card) var(--radius-card);
  padding: 6rpx 10rpx;
  box-shadow: 0 16rpx 64rpx rgba(0,0,0,0.2);
  transition: opacity var(--duration-state) ease;
}
/* 格子外的一层（issue #165）：翻月滑入只动这一层，卡片、周头和月份标题不动。这一层没有盒子
   （无内外边距、无描边、不定宽高），日期格宽度仍按网格内容宽算，几何账本不变 */
.calendar-days {
  display: flex;
  flex-wrap: wrap;
}
/* 翻月滑入（issue #165）：新月份的格子与月标题同一次更新换上，再从翻月方向滑入 10rpx、透明度 0.5 → 1。
   10rpx 等于网格左右内边距，内容不出卡片、不用裁切。a、b 两份关键帧内容相同，记号交替才会从头重播；
   接续、反向与取消的策略在 index.js（_calendarMarks）。减弱动效下即时替换 */
.calendar-days.calendar-flip-next-a {
  animation: calendarFlipNextA var(--duration-enter) var(--ease-out);
}
.calendar-days.calendar-flip-next-b {
  animation: calendarFlipNextB var(--duration-enter) var(--ease-out);
}
.calendar-days.calendar-flip-prev-a {
  animation: calendarFlipPrevA var(--duration-enter) var(--ease-out);
}
.calendar-days.calendar-flip-prev-b {
  animation: calendarFlipPrevB var(--duration-enter) var(--ease-out);
}
@keyframes calendarFlipNextA {
  from { opacity: 0.5; transform: translateX(10rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes calendarFlipNextB {
  from { opacity: 0.5; transform: translateX(10rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes calendarFlipPrevA {
  from { opacity: 0.5; transform: translateX(-10rpx); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes calendarFlipPrevB {
  from { opacity: 0.5; transform: translateX(-10rpx); }
  to { opacity: 1; transform: translateX(0); }
}

/* Day Cells */
.day-cell {
  width: 14.28%;
  height: var(--calendar-row-height, 160rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  position: relative;
  /* 节日/调休标签裁在格子内，不画进相邻格子；读屏与当日详情仍用完整节日名 */
  overflow: hidden;
  border-radius: var(--radius-md);
  padding: 4rpx 0;
  box-sizing: border-box;
  transition: transform var(--duration-press) var(--ease-out);
}
.day-cell:active,
.day-cell.day-cell-hover {
  transform: scale(0.94);
}
.day-cell.empty {
  visibility: hidden;
}
.calendar-density-compact .day-cell {
  height: var(--calendar-row-height, 148rpx);
  justify-content: center;
  padding: 4rpx 0 12rpx;
}
.calendar-density-compact .day-num {
  font-size: var(--font-size-calendar-date-compact);
  line-height: 38rpx;
}
/* 清爽密度也读节日/调休：标签行占固定槽位，保证日期数字横向对齐 */
.calendar-density-compact .day-tag-line {
  height: 34rpx;
  margin-top: 2rpx;
}
.calendar-density-compact .day-tag {
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 8rpx;
  font-size: var(--font-size-calendar-micro);
}
.calendar-density-compact .day-marks {
  height: 30rpx;
  margin-top: 6rpx;
}
/* 清爽密度空间不足时（issue #153）：节日/调休与 ♥、「预」并成日期下的一行，信息一项不少、读屏名不变。
   内容顶对齐，日期与细色带共用常规清爽格的槽位；信息行按「预」胶囊高留足，不再向下垂出。
   几何账本 utils/calendarRowHeight.js 只在这个月每一天都并得进一行时才挂这个类，否则保持常规三行、页面滚动 */
.calendar-info-merged .day-cell {
  justify-content: flex-start;
  padding: 8rpx 0 4rpx;
}
.calendar-info-merged .day-info {
  flex-direction: row;
  justify-content: center;
  height: 42rpx;
  margin-top: 2rpx;
  gap: 4rpx;
}
.calendar-info-merged .day-tag-line {
  width: auto;
  min-width: 0;
  height: 42rpx;
  margin-top: 0;
}
.calendar-info-merged .day-marks {
  flex-shrink: 0;
  height: 42rpx;
  margin-top: 0;
}

/* 调休格的低对比底；今天只在日期上加胶囊，这层底照常铺（issue #162） */
.day-cell.workday {
  background: rgba(255,255,255,0.035);
}

/* Day Number */
.day-num {
  font-size: var(--font-size-calendar-date);
  font-weight: var(--font-weight-control);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.85);
  line-height: 32rpx;
}

/* Today number — 实色玫瑰，不用渐变文字 */
.day-cell.today .day-num {
  color: #E8909E;
  font-weight: var(--font-weight-title);
}
/* 今天（issue #162）：围住日期数字的紧凑胶囊——浅玫瑰底、薰衣草细描边，数字仍是玫瑰色。格子本身不上色，
   整日点按范围仍是整格；农历、节日/调休与标记都在胶囊外。胶囊挂在日期身后（日期自成叠放层，见下方 z-index 1）。
   完整密度：胶囊从格子顶画起（0–41rpx）。清爽与合并信息行：日期上方 5rpx 起。下沿都离下一槽
   （农历字框、节日/调休或信息行）留 2rpx：rpx 按段取整成整数 px，贴着槽顶画会在部分屏宽上压到「班」1px。
   经期中的今天同样显示这枚胶囊，下方色带独立表示经期。
   今天的状态强调（issue #165）用同一个框：两档密度的几何只写在这里，胶囊和光晕各自只写颜色 */
.day-cell.today .day-num::before,
.calendar-days.calendar-emphasis-today-a .day-cell.today .day-num::after,
.calendar-days.calendar-emphasis-today-b .day-cell.today .day-num::after {
  content: '';
  position: absolute;
  z-index: -1;
  top: -4rpx;
  left: 50%;
  width: 60rpx;
  height: 41rpx;
  margin-left: -30rpx;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  pointer-events: none;
}
.calendar-density-compact .day-cell.today .day-num::before,
.legend-sample.day-cell.today.calendar-density-compact .day-num::before,
.calendar-density-compact .calendar-days.calendar-emphasis-today-a .day-cell.today .day-num::after,
.calendar-density-compact .calendar-days.calendar-emphasis-today-b .day-cell.today .day-num::after {
  top: -5rpx;
  width: 64rpx;
  height: 43rpx;
  margin-left: -32rpx;
}
.day-cell.today .day-num::before {
  border: 2rpx solid rgba(196,160,210,0.55);
  background: rgba(232,144,158,0.14);
}
/* 今天的状态强调（issue #165）：回到今天时，日期胶囊的位置亮起一圈更亮、更粗的薰衣草描边再落回 0，只动透明度、播一次。
   形状、位置和胶囊重合（框见上），经期中的今天也照常围住日期，播完不留痕。
   不铺底：日期就在框里，再叠一层玫瑰底，峰值时玫瑰日期掉到约 3:1；描边 4rpx 落在框边，不压数字。
   只在 .calendar-days 带强调记号时存在，静止的日历不多一层；a、b 交替才会从头重播 */
.calendar-days.calendar-emphasis-today-a .day-cell.today .day-num::after,
.calendar-days.calendar-emphasis-today-b .day-cell.today .day-num::after {
  border: 4rpx solid rgba(196,160,210,0.95);
  opacity: 0;
}
.calendar-days.calendar-emphasis-today-a .day-cell.today .day-num::after {
  animation: calendarHaloA var(--duration-emphasis) var(--ease-out);
}
.calendar-days.calendar-emphasis-today-b .day-cell.today .day-num::after {
  animation: calendarHaloB var(--duration-emphasis) var(--ease-out);
}
/* 光晕：亮起再落回 0，播完什么都不留。a、b 内容相同 */
@keyframes calendarHaloA {
  0% { opacity: 0; }
  30% { opacity: 1; }
  100% { opacity: 0; }
}
@keyframes calendarHaloB {
  0% { opacity: 0; }
  30% { opacity: 1; }
  100% { opacity: 0; }
}

.day-lunar {
  width: 100%;
  min-width: 0;
  height: 34rpx;
  line-height: 34rpx;
  margin-top: 2rpx;
  font-size: var(--font-size-calendar-micro);
  font-weight: var(--font-weight-assist);
  color: rgba(255,255,255,0.6);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}
.day-cell.holiday .day-lunar {
  color: rgba(255,255,255,0.6);
}
/* 节日/调休行与标记行的容器：常规排版两行竖排，合并信息行时横成一行 */
.day-info {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.day-tag-line {
  width: 100%;
  height: 38rpx;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.day-tag {
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 10rpx;
  border-radius: var(--radius-full);
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  /* 超长节日名只在尾部被格边界裁掉、起点可读；放得下时盒宽=文宽，短名视觉不变 */
  text-align: left;
  white-space: nowrap;
  max-width: 100%;
}
.holiday-tag {
  color: var(--aurora-gold);
}
.workday-tag {
  color: rgba(255,255,255,0.72);
  background: rgba(255,255,255,0.12);
  box-sizing: border-box;
  border: 1px solid rgba(255,255,255,0.12);
}
.calendar-density-compact .workday-tag {
  padding: 0 6rpx;
}

/* Day Marks */
.day-marks {
  display: flex;
  gap: 4rpx;
  margin-top: 2rpx;
  height: 30rpx;
  align-items: center;
}
.mark {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-circle);
}

/* 完整模式：色带位于农历字框后；清爽模式：所有日期都预留独立细条槽。 */
.period-slot {
  position: absolute;
  top: 40rpx;
  width: 100%;
  height: 30rpx;
  z-index: 0;
  pointer-events: none;
}
.calendar-density-compact .period-slot {
  position: relative;
  top: auto;
  flex-shrink: 0;
  height: 12rpx;
  margin-top: 2rpx;
}
.period-band {
  position: absolute;
  inset: 0 0 auto;
  height: 100%;
  z-index: 0;
  pointer-events: none;
  background: rgba(232,144,158,0.22);
}
.calendar-density-full .period-band {
  box-sizing: border-box;
  border-top: 1px solid rgba(232,144,158,0.6);
  border-bottom: 1px solid rgba(232,144,158,0.6);
}
.calendar-density-compact .period-band {
  background: rgba(232,144,158,0.6);
}
.day-cell.period {
  border-radius: 0;
}
/* 只有向右延续的格子放出 1rpx 色带；长标签仍裁在本格的信息行内。 */
.day-cell.period-start,
.day-cell.period-middle {
  overflow: visible;
  z-index: 1;
}
.day-cell.period-start .day-tag-line,
.day-cell.period-middle .day-tag-line {
  overflow: hidden;
}
.day-num,
.day-lunar,
.day-tag-line,
.day-marks {
  position: relative;
  z-index: 1;
}
.day-cell.period-start .period-band {
  right: -1rpx;
  border-top-left-radius: var(--radius-full);
  border-bottom-left-radius: var(--radius-full);
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}
.day-cell.period-middle .period-band {
  right: -1rpx;
  border-radius: 0;
}
.day-cell.period-end .period-band {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  border-top-right-radius: var(--radius-full);
  border-bottom-right-radius: var(--radius-full);
}
.day-cell.period-single .period-band {
  border-radius: var(--radius-full);
}
.day-cell.period-open.period-end .period-band {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}
.day-cell.period-open.period-single .period-band {
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
}

/* Memory Mark */
.memory-mark {
  font-size: var(--font-size-calendar-micro);
  line-height: 1;
  width: auto;
  height: auto;
  border-radius: 0;
  overflow: visible;
  color: var(--color-memory);
}

/* Predict Mark – Gold */
.predict-mark {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  flex-shrink: 0;
  width: auto;
  min-width: 36rpx;
  height: 42rpx;
  line-height: 1;
  padding: 0 10rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  text-align: center;
  color: var(--aurora-gold);
  background: transparent;
  border: 1px solid rgba(212,165,116,0.55);
  /* 给强调光晕定位（issue #165）；没有偏移，不改排版 */
  position: relative;
}
/* 「预」的状态强调（issue #165）：关掉预测说明时，当月的「预」在描边处亮起一圈更亮的金再落回 0，
   画在字后面，只动透明度、播一次；只在 .calendar-days 带强调记号时存在 */
.calendar-days.calendar-emphasis-predict-a .predict-mark::after,
.calendar-days.calendar-emphasis-predict-b .predict-mark::after {
  content: '';
  position: absolute;
  z-index: -1;
  top: -1px;
  right: -1px;
  bottom: -1px;
  left: -1px;
  box-sizing: border-box;
  border: 1px solid rgba(212,165,116,0.95);
  border-radius: var(--radius-full);
  background: rgba(212,165,116,0.16);
  opacity: 0;
  pointer-events: none;
}
.calendar-days.calendar-emphasis-predict-a .predict-mark::after {
  animation: calendarHaloA var(--duration-emphasis) var(--ease-out);
}
.calendar-days.calendar-emphasis-predict-b .predict-mark::after {
  animation: calendarHaloB var(--duration-emphasis) var(--ease-out);
}

/* 记录成功反馈（issue #167）：新增欢乐时光、新增经期或给没有结束日的经期填上结束日，保存成功后首页（这时正被
   编辑页盖着）给这些日期格挂 record-feedback-memory / -period（index.js 的 recordFeedback）。♥ 从 0.6 倍淡入
   长到原大；色带在当月的每一格一起淡入，跨行的各段同时到位，连续段不断开。先等 --delay-return 让返回转场走完，
   再用 --duration-emphasis 播一次。首页不可见时按住：透明、不播，onShow 去掉 page-hidden 才从头开始；
   onHide 先收掉反馈再挂 page-hidden，离场途中 ♥ 和色带不消失。只在 .calendar-days 的日期格上，样本不受影响 */
.calendar-days .day-cell.record-feedback-memory .memory-mark {
  animation: recordBloom var(--duration-emphasis) var(--ease-out) var(--delay-return) both;
}
.calendar-days .day-cell.record-feedback-period .period-band {
  animation: fadeIn var(--duration-emphasis) var(--ease-out) var(--delay-return) both;
}
.page.page-hidden .calendar-days .day-cell.record-feedback-memory .memory-mark,
.page.page-hidden .calendar-days .day-cell.record-feedback-period .period-band {
  animation: none;
  opacity: 0;
}
@keyframes recordBloom {
  from { opacity: 0; transform: scale(0.6); }
  to { opacity: 1; transform: scale(1); }
}
.month-summary {
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  border-radius: var(--radius-card);
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.12);
  color: var(--text-primary);
  transition: opacity var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.month-summary-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.month-summary-arrow {
  flex: none;
  font-size: var(--font-size-caption);
  line-height: 1;
  color: var(--text-secondary);
}
.month-summary:active,
.month-summary.month-summary-hover {
  transform: scale(0.98);
}

/* ===== Quick Actions — 经期实色主操作 + 欢乐时光 button-ghost 次操作 ===== */
.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
  transition: opacity var(--duration-state) ease;
}
.quick-btn {
  flex: 1;
  /* 320px 宽上可点高度 ≥44px：104rpx ≈ 44.4px@320px（与 compact 日历格同换算），不缩字号 */
  min-height: 104rpx;
  box-sizing: border-box;
  gap: 12rpx;
  padding: 14rpx 24rpx;
  background: var(--aurora-pink);
  color: var(--text-on-accent);
  border-radius: var(--radius-card);
  border: 1px solid rgba(255,255,255,0.16);
  transition: transform var(--duration-press) var(--ease-out);
}
/* 柔光层同 .btn-premium（issue #166，结构和按下沉到 0.5 在 app.wxss「柔光层」）：这里只写光的大小 */
.quick-btn::before {
  box-shadow: 0 10rpx 26rpx rgba(232,144,158,0.22);
}
.quick-btn:active,
.quick-btn.quick-btn-hover {
  transform: scale(0.96);
}
/* 记录入口图标 = 日历图例标记：海军圆盘上承载图例的单日经期色带 / 欢乐时光浅色心（.action-sample / .memory-tone） */
.quick-icon {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: var(--radius-circle);
  font-size: 32rpx;
  background: var(--aurora-bg);
}
/* 进行中经期的「经期第 N 天 · 记结束」一行放不下（issue #159）：连写的中文不拆，只在空格处折成两行。
   issue #247：body 30rpx 会让三位数天数的第一行再折行，且两行盒超出 104rpx，故此处保留旧值 28rpx；
   两行紧行高仍在原按钮里，首屏账本的记录入口高度不变。例外见 DESIGN。 */
.quick-text {
  font-size: 28rpx;
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-title);
  word-break: keep-all;
  color: var(--text-on-accent);
}
/* 欢乐时光是次操作：画布海军底、玫瑰描边与玫瑰字都画在随按压缩放的按钮自身；
   宿主只负责半栏布局，不再留下静止黑边。 */
.quick-ghost-surface {
  flex: 1;
  min-width: 0;
  display: flex;
  border-radius: var(--radius-card);
}
.quick-btn.btn-ghost {
  background: var(--aurora-bg);
  color: #E8909E;
  border: 1.5px solid #E8909E;
  border-radius: var(--radius-card);
}
.quick-btn.btn-ghost::before {
  box-shadow: none;
}
.quick-btn.btn-ghost:active,
.quick-btn.btn-ghost.btn-ghost-hover {
  transform: scale(0.95);
}
.quick-btn.btn-ghost .quick-text {
  color: #E8909E;
}

/* ===== Empty Room Guidance ===== */
.empty-guide {
  margin-top: 20rpx;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-card);
  background: rgba(255,255,255,0.06);
  border-style: dashed;
  border-color: rgba(255,255,255,0.16);
  transition: opacity var(--duration-state) ease;
}
.empty-guide-text {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  text-align: center;
}

/* ===== No Room State ===== */
.no-room {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 0 60rpx;
  background: transparent;
  position: relative;
  z-index: 1;
}
.no-room-icon {
  font-size: 120rpx;
  /* 无房间心：玫瑰文本字形，与绑定页 hero / 设置资料卡同款（issue #77 模式，issue #106） */
  color: #E8909E;
  margin-bottom: 30rpx;
  animation: pulse 6s ease-in-out infinite;
}
.no-room-title {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-title);
  /* 未绑定/加载失败标题不可点：中性文字色，不用玫瑰（issue #77） */
  color: rgba(255,255,255,0.92);
}
.no-room-desc {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: var(--text-secondary);
  margin-top: 16rpx;
  text-align: center;
  line-height: var(--line-height-assist);
}
/* 主按钮在居中的列里按内容收缩，而基类左右内边距为 0（「重试」曾只有字宽）：
   两个方向都至少 88rpx 触控档，标签左右留 --space-lg；基类没有外边距，按钮曾贴着说明文字，上方同样留 --space-lg */
.no-room .btn-premium {
  min-width: 88rpx;
  min-height: 88rpx;
  margin-top: var(--space-lg);
  padding-left: var(--space-lg);
  padding-right: var(--space-lg);
  box-sizing: border-box;
}

/* ===== Calendar Month Jump Sheet ===== */
.jump-section {
  margin-top: 18rpx;
}
.jump-today {
  min-height: 88rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
  border-radius: var(--radius-lg);
  color: rgba(255,255,255,0.85);
  background: rgba(232,144,158,0.12);
  border: 1px solid rgba(232,144,158,0.24);
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.jump-today:active,
.jump-today.jump-today-hover {
  transform: scale(0.98);
  background: rgba(232,144,158,0.18);
}
.jump-today-label {
  flex: 0 0 auto;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  white-space: nowrap;
}
.jump-today-date {
  flex: 0 0 auto;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  white-space: nowrap;
}
.jump-section-title {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.72);
}
.jump-year-stepper {
  min-height: 88rpx;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.jump-year-step {
  flex: 0 0 auto;
  min-width: 96rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  font-size: 40rpx;
  font-weight: 800;
  color: rgba(255,255,255,0.85);
  background: rgba(255,255,255,0.075);
  border: 1px solid rgba(255,255,255,0.11);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out), opacity var(--duration-state) ease;
}
.jump-year-step:active,
.jump-year-step.jump-year-step-hover {
  transform: scale(0.94);
  background: rgba(255,255,255,0.14);
}
.jump-year-step.disabled {
  opacity: 0.35;
}
.jump-year-step:active.disabled,
.jump-year-step.jump-year-step-hover.disabled{
  transform: none;
  background: rgba(255,255,255,0.075);
}
.jump-year-value {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-control);
  text-align: center;
  /* 选月年份数字不是控件本体（步进箭头才是），用中性文字色（issue #77） */
  color: rgba(255,255,255,0.92);
  font-variant-numeric: tabular-nums;
}
.jump-month-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}
.jump-option {
  min-height: 88rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 8rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  white-space: nowrap;
  color: rgba(255,255,255,0.72);
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
  transition: background-color var(--duration-press) ease, color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.jump-option:active,
.jump-option.jump-option-hover {
  transform: scale(0.97);
  background: rgba(255,255,255,0.13);
}
.jump-option.real-today {
  color: var(--aurora-pink);
}
.jump-option.active {
  color: var(--text-on-accent);
  background: var(--aurora-pink);
  border-color: rgba(255,255,255,0.18);
  box-shadow: 0 12rpx 28rpx rgba(232,144,158,0.18);
}
.jump-real-today-dot {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-left: -4rpx;
  border-radius: var(--radius-circle);
  background: currentColor;
  pointer-events: none;
}

/* ===== Day Action Sheet Content ===== */
.sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.sheet-action {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 18rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.075);
  border: 1px solid rgba(255,255,255,0.11);
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.sheet-action:active,
.sheet-action.sheet-action-hover {
  transform: scale(0.98);
  background: rgba(255,255,255,0.13);
}
.sheet-action-icon {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: var(--radius-circle);
  font-size: 26rpx;
  font-weight: 800;
  background: var(--glass-bg);
}
.memory-tone {
  color: var(--color-memory);
  box-shadow: inset 0 0 0 1px rgba(240,196,192,0.28);
}
.detail-tone {
  color: rgba(255,255,255,0.72);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2);
}
.sheet-action-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sheet-action-title {
  display: block;
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  color: rgba(255,255,255,0.92);
  line-height: var(--line-height-title);
  word-break: break-word;
  overflow-wrap: anywhere;
}
.sheet-action-desc {
  display: block;
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  overflow-wrap: anywhere;
}
.sheet-action-arrow {
  flex: 0 0 auto;
  font-size: 42rpx;
  color: rgba(255,255,255,0.72);
  line-height: 1;
}
.day-detail-fade {
  animation: fadeIn var(--duration-state) var(--ease-out) both;
}
.day-detail-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.day-detail-empty {
  padding: 32rpx 24rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.06);
  border-style: dashed;
  border-color: rgba(255,255,255,0.14);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.detail-empty-title {
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.85);
  word-break: break-word;
  overflow-wrap: anywhere;
}
.detail-empty-desc {
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  overflow-wrap: anywhere;
}
.day-detail-row {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 18rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.day-detail-row:active,
.day-detail-row.day-detail-row-hover {
  transform: scale(0.98);
  background: rgba(255,255,255,0.13);
}
.detail-meaning-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.detail-meaning-list + .day-detail-list,
.detail-meaning-list + .sheet-actions {
  margin-top: 14rpx;
}
.detail-meaning {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.06);
}
.detail-meaning.predict .detail-meaning-title,
.detail-meaning.holiday .detail-meaning-title {
  color: var(--aurora-gold);
}
.detail-meaning-title {
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.85);
  word-break: break-word;
  overflow-wrap: anywhere;
}
.detail-meaning-text {
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  overflow-wrap: anywhere;
}
.detail-rail {
  width: 6rpx;
  min-height: 72rpx;
  border-radius: var(--radius-full);
  background: #E8909E;
  box-shadow: 0 0 16rpx rgba(232,144,158,0.35);
}
.memory-detail .detail-rail {
  background: var(--color-memory);
  box-shadow: 0 0 16rpx rgba(240,196,192,0.32);
}
.detail-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.detail-arrow {
  flex: 0 0 auto;
  align-self: center;
  font-size: 32rpx;
  color: var(--text-secondary);
  line-height: 1;
}
.detail-title {
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.85);
}
.period-detail .detail-title {
  color: #E8909E;
}
.memory-detail .detail-title {
  color: var(--color-memory);
}
.detail-main {
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  overflow-wrap: anywhere;
}
.detail-meta {
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  overflow-wrap: anywhere;
}
.detail-note {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.compact-actions {
  flex-direction: row;
  gap: 16rpx;
  margin-top: 16rpx;
}
.sheet-action.compact {
  flex: 1;
  min-height: 88rpx;
  justify-content: center;
}
.sheet-action.compact .sheet-action-copy {
  flex: 0 1 auto;
}

/* ===== Calendar Info Sheet Content ===== */
.legend-list,
.prediction-explanation,
.monthly-recap {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.legend-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
}
/* 图例样本就是一枚日历格（issue #162）：铺日历网格同款玻璃底、同款圆角，今天胶囊和各个标记落在和网格相同的合成面上。
   要写在 .day-cell.period 后面：同特异度，经期样本才不会被改成直角。经期色带在样本格里竖向居中 */
.legend-sample.day-cell {
  width: 72rpx;
  height: 72rpx;
  flex: none;
  padding: 0;
  justify-content: center;
  border-radius: var(--radius-md);
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
}
.legend-sample .period-band {
  top: 21rpx;
  height: 30rpx;
}
.legend-sample .predict-mark {
  align-self: center;
}
/* 经期记录动作的图标（issue #159）：就是图例那段单日色带，同一组 .day-cell.period.period-single 与 .period-band。
   这里只把它缩进圆盘、让色带铺满样本；颜色和胶囊形仍由色带自己的规则给。样本不接收点按，按压归外层按钮。
   圆盘保留原来的玫瑰细描边，和欢乐时光圆盘的浅色描边成对 */
.sample-plate {
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1px rgba(232,144,158,0.3);
}
.action-sample.day-cell {
  flex: none;
  width: 30rpx;
  height: 18rpx;
  padding: 0;
  pointer-events: none;
}
.sheet-action-icon .action-sample.day-cell {
  width: 40rpx;
  height: 24rpx;
}
.action-sample .period-band {
  top: 0;
  height: 100%;
}
.legend-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.legend-title {
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  color: rgba(255,255,255,0.85);
  line-height: var(--line-height-title);
  word-break: break-word;
  overflow-wrap: anywhere;
}
.legend-text {
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  overflow-wrap: anywhere;
}
.prediction-summary {
  min-width: 0;
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.92);
  overflow-wrap: anywhere;
}
.explain-line {
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  overflow-wrap: anywhere;
}
.recap-overview {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
}
.recap-summary {
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  overflow-wrap: anywhere;
}
.recap-main {
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
}
.recap-highlights {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.recap-highlight-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}
.recap-highlight-rail {
  width: 4rpx;
  flex: 0 0 4rpx;
  border-radius: var(--radius-full);
  background: var(--aurora-pink);
}
.recap-highlight-memory .recap-highlight-rail {
  background: var(--memory-gold);
}
.recap-highlight {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.72);
  overflow-wrap: anywhere;
}
.copy-recap {
  min-height: 88rpx;
  margin-top: 10rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  white-space: nowrap;
  color: var(--text-on-accent);
  background: var(--aurora-pink);
  transition: transform var(--duration-press) var(--ease-out);
}
/* 柔光层同 .btn-premium（issue #166，结构和按下沉到 0.5 在 app.wxss「柔光层」）：这里只写光的大小 */
.copy-recap::before {
  box-shadow: 0 14rpx 34rpx rgba(232,144,158,0.18);
}
.copy-recap:active,
.copy-recap.copy-recap-hover {
  transform: scale(0.96);
}
/* 骨架复用真实 .content 页边距、吸顶占位、周头和网格；只有父容器脉冲（issue #239） */
.calendar-skeleton {
  position: relative;
  z-index: 1;
  padding: 0 var(--space-page-gutter) 30rpx;
  pointer-events: none;
  animation: skeletonPulse 2.4s ease-in-out infinite;
}
.skeleton-month-title {
  min-height: 88rpx;
  min-width: 344rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  border: 1px solid rgba(255,255,255,0.08);
}
.skeleton-status-bar {
  height: 88rpx;
}
.skeleton-week-cell {
  height: 34rpx;
}
.skeleton-days {
  display: flex;
  flex-wrap: wrap;
}
.skeleton-cell {
  width: 14.28%;
  height: var(--calendar-row-height, 148rpx);
  padding: 4rpx 2rpx;
  box-sizing: border-box;
  background-clip: content-box;
}
.calendar-density-compact .skeleton-cell {
  padding-bottom: 12rpx;
}
.calendar-info-merged .skeleton-cell {
  padding: 8rpx 2rpx 4rpx;
}
.skeleton-control,
.skeleton-month-title,
.skeleton-status-bar,
.skeleton-week-cell,
.skeleton-cell {
  background: rgba(255,255,255,0.08);
}
/* 翻月圆钮不再叠加真实按钮的玻璃底与平涂层，和其他骨架块保持同一弱白亮度。 */
.nav-btn.skeleton-control {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.08);
}
.nav-btn.skeleton-control::before {
  background-color: transparent;
}
.skeleton-cell.skeleton-cell-empty {
  background: transparent;
}
.skeleton-quick-action {
  flex: 1;
  min-height: 104rpx;
  border-radius: var(--radius-card);
  background: rgba(255,255,255,0.08);
}
.skeleton-status-bar,
.skeleton-week-cell,
.skeleton-cell {
  border-radius: var(--radius-md);
}
@media (prefers-reduced-motion: reduce) {
  .sync-pill,
  .sync-pill.sync-open,
  .sync-pill.syncing .sync-dot,
  .month-title-trigger,
  .nav-btn,
  .nav-btn::before,
  .jump-option,
  .jump-year-step,
  .jump-today,
  .sheet-action,
  .day-detail-row,
  .day-detail-fade,
  .day-cell,
  .calendar-days.calendar-flip-next-a,
  .calendar-days.calendar-flip-next-b,
  .calendar-days.calendar-flip-prev-a,
  .calendar-days.calendar-flip-prev-b,
  .partner-welcome,
  .home-share-invite,
  .back-today,
  .home-status,
  .month-summary,
  .calendar-grid,
  .quick-actions,
  .empty-guide,
  .calendar-skeleton,
  .quick-btn,
  .copy-recap,
  .no-room-icon {
    animation: none;
    transition: none;
  }
  /* 记录成功的 ♥ 只淡入、不缩放；色带本来就只动透明度，照常（issue #167） */
  .calendar-days .day-cell.record-feedback-memory .memory-mark {
    animation: fadeIn var(--duration-emphasis) var(--ease-out) var(--delay-return) both;
  }
}
