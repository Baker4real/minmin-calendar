/* ===== Aurora Bloom: Index ===== */
.page {
  overflow: hidden;
}
/* 导航标题不可点：中性文字色（共享基类在 app.wxss，页面侧覆盖颜色，issue #77）；
   月份标题 .month-title 保持玫瑰——它本身是打开选月的控件 */
.nav-title {
  color: rgba(255,255,255,0.92);
}
.content {
  padding: 0 24rpx 30rpx;
  position: relative;
  z-index: 1;
}
.content-refreshing .calendar-grid,
.content-refreshing .status-card,
.content-refreshing .empty-guide,
.content-refreshing .quick-actions {
  opacity: 0.94;
}
.sync-pill {
  width: 300rpx;
  min-height: 52rpx;
  position: fixed;
  top: calc(var(--safe-top, env(safe-area-inset-top, 88rpx)) + 92rpx);
  left: 50%;
  z-index: 50;
  margin: 0 0 0 -150rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  color: rgba(255,255,255,0.78);
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.13);
  box-shadow: 0 8rpx 26rpx rgba(0,0,0,0.14);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  pointer-events: none;
  opacity: 0;
  transform: translateY(-8rpx);
  transition: opacity var(--duration-exit) var(--ease-out), transform var(--duration-exit) var(--ease-out);
}
.sync-pill.sync-open {
  opacity: 1;
  transform: translateY(0);
  transition: opacity var(--duration-enter) var(--ease-out), transform var(--duration-enter) var(--ease-out);
}
.sync-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-circle);
  background: var(--aurora-gold);
  box-shadow: 0 0 12rpx rgba(212,165,116,0.5);
}
.sync-pill.syncing .sync-dot {
  background: #E8909E;
  animation: syncDotPulse 1s ease-in-out infinite;
}
.sync-text {
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
@keyframes syncDotPulse {
  0%, 100% { opacity: 0.55; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.15); }
}

/* 刷新失败重试句（issue #79）：已加载后的后台刷新失败留驻的可点行。
   正常文档流（非 fixed/absolute）放在月份导航与周头之间，不遮月份标题；
   文案行玫瑰可点色，88rpx 触控高度。 */
.refresh-retry {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0 0 8rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  transition: transform var(--duration-press) var(--ease-out), background-color var(--duration-press) ease;
}
.refresh-retry:active {
  transform: scale(0.98);
  background: rgba(255,255,255,0.09);
}
.refresh-retry-text {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  color: #E8909E;
}

/* ===== Month Navigation – Glassmorphism ===== */
.month-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 24rpx;
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.15);
  box-shadow:
    0 8px 32px rgba(232,144,158,0.15),
    inset 0 1px 0 rgba(255,255,255,0.2);
  border-radius: var(--radius-card);
  margin: 10rpx 0 8rpx;
  position: relative;
  overflow: hidden;
}
.month-nav::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -30%;
  width: 160%;
  height: 200%;
  background: radial-gradient(ellipse at 40% 30%, rgba(232,144,158,0.1) 0%, transparent 50%);
  pointer-events: none;
}
.month-title {
  font-size: var(--font-size-month-title);
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-title);
  white-space: nowrap;
  position: relative;
  z-index: 1;
  color: #E8909E;
  text-shadow: 0 0 14rpx rgba(232,144,158,0.28);
}
.month-title-trigger {
  min-height: 88rpx;
  min-width: 260rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  background: rgba(232,144,158,0.09);
  border: 1px solid rgba(232,144,158,0.22);
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.month-title-trigger:active {
  transform: scale(0.97);
  background: rgba(232,144,158,0.16);
}
.month-title-caret {
  font-size: 24rpx;
  line-height: 1;
  color: rgba(232,144,158,0.85);
  transform: translateY(-2rpx);
}
.nav-btn {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 42rpx;
  color: #fff;
  border-radius: var(--radius-circle);
  background: linear-gradient(rgba(255,255,255,0.1), rgba(255,255,255,0.1)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.2);
  position: relative;
  z-index: 1;
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.nav-btn:active {
  transform: scale(0.96);
  background: linear-gradient(rgba(255,255,255,0.2), rgba(255,255,255,0.2)), var(--glass-fallback);
}

/* ===== Week Header ===== */
.week-header {
  display: flex;
  padding: 8rpx 0;
  margin-bottom: 0;
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-card) var(--radius-card) 0 0;
}
.week-cell {
  flex: 1;
  text-align: center;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: rgba(255,255,255,0.7);
}

/* ===== Calendar Grid – Glass ===== */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 0 0 var(--radius-card) var(--radius-card);
  padding: 6rpx 0;
  box-shadow: 0 8px 32px rgba(0,0,0,0.2);
}

/* Day Cells */
.day-cell {
  width: 14.28%;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  position: relative;
  /* 节日/调休标签裁在格子内，不画进相邻格子；读屏与当日详情仍用完整节日名 */
  overflow: hidden;
  border-radius: var(--radius-md);
  padding: 4rpx 0;
  box-sizing: border-box;
  transition: transform var(--duration-press) var(--ease-out);
}
.day-cell:active {
  transform: scale(0.94);
}
.day-cell.empty {
  visibility: hidden;
}
.calendar-density-compact .day-cell {
  height: 140rpx;
  justify-content: center;
  padding: 10rpx 0 12rpx;
}
.calendar-density-compact .day-num {
  font-size: var(--font-size-calendar-date-compact);
  line-height: 38rpx;
}
/* 清爽密度也读节日/调休：标签行占固定槽位，保证日期数字横向对齐 */
.calendar-density-compact .day-tag-line {
  height: 34rpx;
  margin-top: 2rpx;
}
.calendar-density-compact .day-tag {
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 8rpx;
  font-size: var(--font-size-calendar-micro);
}
.calendar-density-compact .day-marks {
  height: 30rpx;
  margin-top: 6rpx;
}

/* 今天标记 — 平静玫瑰底 + 薰衣草内描边（DESIGN.md todayBorder） */
.day-cell.today {
  background: rgba(232,144,158,0.16);
  box-shadow: inset 0 0 0 3rpx rgba(196,160,210,0.55);
}
.day-cell.holiday:not(.today) {
  background: rgba(212,165,116,0.08);
}
.day-cell.workday:not(.today) {
  background: rgba(255,255,255,0.035);
}

/* Day Number */
.day-num {
  font-size: var(--font-size-calendar-date);
  font-weight: var(--font-weight-control);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.8);
  line-height: 32rpx;
}

/* Today number — 实色玫瑰，不用渐变文字 */
.day-cell.today .day-num {
  color: #E8909E;
  font-weight: var(--font-weight-title);
}

.day-lunar {
  width: 100%;
  min-width: 0;
  height: 34rpx;
  line-height: 34rpx;
  margin-top: 2rpx;
  font-size: var(--font-size-calendar-micro);
  font-weight: var(--font-weight-assist);
  color: rgba(255,255,255,0.6);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
}
.day-cell.holiday .day-lunar {
  color: rgba(255,255,255,0.62);
}
.day-tag-line {
  width: 100%;
  height: 38rpx;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.day-tag {
  height: 38rpx;
  line-height: 38rpx;
  padding: 0 10rpx;
  border-radius: var(--radius-full);
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  /* 超长节日名只在尾部被格边界裁掉、起点可读；放得下时盒宽=文宽，短名视觉不变 */
  text-align: left;
  white-space: nowrap;
  max-width: 100%;
}
.holiday-tag {
  color: #0A0E27;
  background: rgba(212,165,116,0.9);
}
.workday-tag {
  color: rgba(255,255,255,0.72);
  background: rgba(255,255,255,0.12);
  box-sizing: content-box;
  border: 1px solid rgba(255,255,255,0.12);
}

/* Day Marks */
.day-marks {
  display: flex;
  gap: 4rpx;
  margin-top: 2rpx;
  height: 30rpx;
  align-items: center;
}
.mark {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-circle);
}

/* Period Mark – 静态玫瑰点，柔光 */
.period-mark {
  background: #E8909E;
  box-shadow: 0 0 10rpx rgba(232,144,158,0.45);
}

/* Memory Mark */
.memory-mark {
  font-size: var(--font-size-calendar-micro);
  line-height: 1;
  width: auto;
  height: auto;
  border-radius: 0;
  overflow: visible;
  color: #F0C4C0;
}

/* Predict Mark – Gold */
.predict-mark {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  flex-shrink: 0;
  width: auto;
  min-width: 36rpx;
  height: 42rpx;
  line-height: 1;
  padding: 0 10rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  text-align: center;
  color: var(--aurora-gold);
  background: rgba(212,165,116,0.14);
  border: 1px solid rgba(212,165,116,0.22);
}

/* ===== Status Card – Glass Card（issue #105 合并状态卡：条数现状 + 预测 + 提醒） ===== */
.status-card {
  margin-top: 20rpx;
  padding: 28rpx 20rpx;
}
.status-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 10rpx;
}
.status-figure {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.status-reminders {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
  transition: transform var(--duration-press) var(--ease-out);
}
.stat-item:active {
  transform: scale(0.98);
}
/* 数据实色化：玫瑰=经期数据 */
.stat-num {
  font-size: 36rpx;
  font-weight: var(--font-weight-control);
  color: #E8909E;
  font-variant-numeric: tabular-nums;
}
.predict-item {
  flex: 1.35;
}
.predict-value {
  min-height: 40rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  max-width: 100%;
  white-space: nowrap;
}
/* 柔金=预测元数据 */
.predict-date {
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-control);
  line-height: 1.15;
  color: var(--aurora-gold);
  font-variant-numeric: tabular-nums;
}
.predict-weekday {
  flex: 0 0 auto;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: 1.15;
  color: rgba(255,255,255,0.72);
}
.stat-label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: rgba(255,255,255,0.5);
  margin-top: 6rpx;
}
.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255,255,255,0.1);
}

/* ===== Cycle Reminders ===== */
.reminder-card {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  background: rgba(255,255,255,0.075);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-md);
  box-shadow: 0 6px 24px rgba(0,0,0,0.13);
  box-sizing: border-box;
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.reminder-card:active {
  transform: scale(0.98);
  background: rgba(255,255,255,0.12);
}
.reminder-rail {
  width: 6rpx;
  align-self: stretch;
  min-height: 52rpx;
  border-radius: var(--radius-full);
  background: var(--aurora-gold);
  box-shadow: 0 0 14rpx rgba(212,165,116,0.36);
}
.reminder-card.due .reminder-rail {
  background: #E8909E;
  box-shadow: 0 0 14rpx rgba(232,144,158,0.4);
}
.reminder-card.overdue .reminder-rail {
  background: #F97373;
  box-shadow: 0 0 14rpx rgba(249,115,115,0.38);
}
.reminder-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.reminder-title {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: rgba(255,255,255,0.88);
}
.reminder-text {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: rgba(255,255,255,0.5);
  line-height: var(--line-height-assist);
}
.reminder-action {
  min-width: 72rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  color: #0A0E27;
  background: var(--aurora-pink);
}

/* ===== Quick Actions — 首屏主操作：实色玫瑰填充 + 画布海军字 ===== */
.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
}
.quick-btn {
  flex: 1;
  /* 320px 宽上可点高度 ≥44px：104rpx ≈ 44.4px@320px（与 compact 日历格同换算），不缩字号 */
  min-height: 104rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: var(--aurora-pink);
  color: #0A0E27;
  border-radius: var(--radius-md);
  box-shadow: 0 10rpx 26rpx rgba(232,144,158,0.22);
  border: 1px solid rgba(255,255,255,0.16);
  transition: transform var(--duration-press) var(--ease-out);
}
.quick-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 14rpx rgba(232,144,158,0.18);
}
/* 记录入口图标 = 日历图例标记：海军圆盘上承载经期玫瑰圆点 / 欢乐时光浅色心（.period-tone / .memory-tone） */
.quick-icon {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: var(--radius-circle);
  font-size: 32rpx;
  background: #0A0E27;
}
.quick-text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  color: #0A0E27;
}

/* ===== Empty Room Guidance ===== */
.empty-guide {
  margin-top: 20rpx;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-card);
  background: rgba(255,255,255,0.06);
  border: 1px dashed rgba(255,255,255,0.16);
}
.empty-guide-text {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  text-align: center;
}

/* ===== No Room State ===== */
.no-room {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 0 60rpx;
  background: transparent;
  position: relative;
  z-index: 1;
}
.no-room-icon {
  font-size: 120rpx;
  /* 无房间心：玫瑰文本字形，与绑定页 hero / 设置资料卡同款（issue #77 模式，issue #106） */
  color: #E8909E;
  margin-bottom: 30rpx;
  animation: pulse 6s ease-in-out infinite;
}
.no-room-title {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-title);
  /* 未绑定/加载失败标题不可点：中性文字色，不用玫瑰（issue #77） */
  color: rgba(255,255,255,0.92);
}
.no-room-desc {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: rgba(255,255,255,0.5);
  margin-top: 16rpx;
  text-align: center;
  line-height: var(--line-height-assist);
}

/* ===== Calendar Month Jump Sheet ===== */
.month-jump-mask {
  z-index: 62;
}
.calendar-jump-sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 18rpx 22rpx 24rpx;
  padding-bottom: calc(24rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  box-sizing: border-box;
  background:
    linear-gradient(160deg, rgba(232,144,158,0.14), rgba(196,160,210,0.08) 45%, rgba(18,22,61,0.96) 100%),
    rgba(18,22,61,0.96);
  border: 1px solid rgba(255,255,255,0.16);
  border-radius: var(--radius-xl) var(--radius-xl) var(--radius-lg) var(--radius-lg);
  box-shadow:
    0 -18rpx 48rpx rgba(0,0,0,0.34),
    inset 0 1rpx 0 rgba(255,255,255,0.18);
}
.jump-section {
  margin-top: 18rpx;
}
.jump-today {
  min-height: 88rpx;
  margin-top: 16rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
  border-radius: var(--radius-lg);
  color: rgba(255,255,255,0.86);
  background: rgba(232,144,158,0.12);
  border: 1px solid rgba(232,144,158,0.24);
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.jump-today:active {
  transform: scale(0.98);
  background: rgba(232,144,158,0.18);
}
.jump-today-label {
  flex: 0 0 auto;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  white-space: nowrap;
}
.jump-today-date {
  flex: 0 0 auto;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  white-space: nowrap;
}
.jump-section-title {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.68);
}
.jump-year-stepper {
  min-height: 88rpx;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.jump-year-step {
  flex: 0 0 auto;
  min-width: 96rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  font-size: 40rpx;
  font-weight: 800;
  color: rgba(255,255,255,0.82);
  background: rgba(255,255,255,0.075);
  border: 1px solid rgba(255,255,255,0.11);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out), opacity var(--duration-state) ease;
}
.jump-year-step:active {
  transform: scale(0.94);
  background: rgba(255,255,255,0.14);
}
.jump-year-step.disabled {
  opacity: 0.35;
}
.jump-year-step.disabled:active {
  transform: none;
  background: rgba(255,255,255,0.075);
}
.jump-year-value {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-control);
  text-align: center;
  /* 选月年份数字不是控件本体（步进箭头才是），用中性文字色（issue #77） */
  color: rgba(255,255,255,0.9);
  font-variant-numeric: tabular-nums;
}
.jump-month-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}
.jump-option {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 8rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  white-space: nowrap;
  color: rgba(255,255,255,0.78);
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
  transition: background-color var(--duration-press) ease, color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.jump-option:active {
  transform: scale(0.97);
  background: rgba(255,255,255,0.13);
}
.jump-option.active {
  color: #0A0E27;
  background: var(--aurora-pink);
  border-color: rgba(255,255,255,0.18);
  box-shadow: 0 12rpx 28rpx rgba(232,144,158,0.18);
}
.jump-confirm {
  min-height: 88rpx;
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  white-space: nowrap;
  color: #0A0E27;
  background: var(--aurora-pink);
  box-shadow: 0 14rpx 36rpx rgba(232,144,158,0.2);
  transition: transform var(--duration-press) var(--ease-out);
}
.jump-confirm:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(232,144,158,0.16);
}

/* ===== Day Action Sheet ===== */
.day-sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  padding: 0 20rpx 0;
  box-sizing: border-box;
  background: rgba(10,14,39,0.88);
  /* 全屏遮罩 blur 压到 modal-overlay 登记的 8px：88% 不透明底上更大 blur 不可见，纯 GPU 开销（issue #58） */
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  opacity: 0;
  transition: opacity var(--duration-exit) var(--ease-out);
}
.day-sheet-mask.sheet-open {
  opacity: 1;
  transition: opacity var(--duration-enter) var(--ease-out);
}
.day-sheet-mask.sheet-leaving {
  pointer-events: none;
}
.sheet-slide {
  width: 100%;
  padding-bottom: 20rpx;
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform var(--duration-exit) var(--ease-out);
}
.day-sheet-mask.sheet-open .sheet-slide {
  transform: translateY(0);
  transition: transform var(--duration-sheet) var(--ease-out);
}
.day-action-sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 18rpx 22rpx 22rpx;
  padding-bottom: calc(22rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  box-sizing: border-box;
  background:
    linear-gradient(160deg, rgba(232,144,158,0.12), rgba(196,160,210,0.08) 42%, rgba(18,22,61,0.94) 100%),
    rgba(18,22,61,0.94);
  border: 1px solid rgba(255,255,255,0.16);
  border-radius: var(--radius-xl) var(--radius-xl) var(--radius-lg) var(--radius-lg);
  box-shadow:
    0 -18rpx 48rpx rgba(0,0,0,0.34),
    inset 0 1rpx 0 rgba(255,255,255,0.18);
}
.sheet-handle {
  width: 70rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.22);
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.sheet-date-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.sheet-title {
  display: block;
  min-width: 0;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-title);
  color: rgba(255,255,255,0.92);
  word-break: break-word;
  overflow-wrap: anywhere;
}
.sheet-subtitle {
  display: block;
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.78);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.sheet-close {
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--radius-circle);
  font-size: 46rpx;
  color: rgba(255,255,255,0.92);
  background: var(--glass-bg);
  border: 1px solid rgba(255,255,255,0.12);
}
.sheet-close:active {
  transform: scale(0.96);
  background: rgba(255,255,255,0.14);
}
.sheet-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.sheet-action {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 18rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.075);
  border: 1px solid rgba(255,255,255,0.11);
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.sheet-action:active {
  transform: scale(0.98);
  background: rgba(255,255,255,0.13);
}
.sheet-action-icon {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: var(--radius-circle);
  font-size: 26rpx;
  font-weight: 800;
  background: var(--glass-bg);
}
.period-tone {
  color: #E8909E;
  box-shadow: inset 0 0 0 1px rgba(232,144,158,0.3);
}
.memory-tone {
  color: #F0C4C0;
  box-shadow: inset 0 0 0 1px rgba(240,196,192,0.28);
}
.detail-tone {
  color: rgba(255,255,255,0.72);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.2);
}
.sheet-action-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.sheet-action-title {
  display: block;
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  color: rgba(255,255,255,0.9);
  line-height: 1.25;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.sheet-action-desc {
  display: block;
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.sheet-action-arrow {
  flex: 0 0 auto;
  font-size: 42rpx;
  color: rgba(255,255,255,0.78);
  line-height: 1;
}
.day-detail-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.day-detail-empty {
  padding: 32rpx 24rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.06);
  border: 1px dashed rgba(255,255,255,0.14);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.detail-empty-title {
  display: block;
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.86);
  word-break: break-word;
  overflow-wrap: anywhere;
}
.detail-empty-desc {
  display: block;
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.day-detail-row {
  display: flex;
  gap: 18rpx;
  padding: 20rpx 18rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
}
.detail-meaning-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.detail-meaning {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
}
.detail-meaning.today {
  border-color: rgba(232,144,158,0.3);
}
.detail-meaning.period {
  border-color: rgba(232,144,158,0.24);
}
.detail-meaning.memory {
  border-color: rgba(240,196,192,0.24);
}
.detail-meaning.predict,
.detail-meaning.holiday {
  border-color: rgba(212,165,116,0.24);
}
.detail-meaning-title {
  display: block;
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.86);
  word-break: break-word;
  overflow-wrap: anywhere;
}
.detail-meaning-text {
  display: block;
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.detail-rail {
  width: 6rpx;
  min-height: 72rpx;
  border-radius: var(--radius-full);
  background: #E8909E;
  box-shadow: 0 0 16rpx rgba(232,144,158,0.35);
}
.memory-detail .detail-rail {
  background: #F0C4C0;
  box-shadow: 0 0 16rpx rgba(240,196,192,0.32);
}
.detail-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.detail-title {
  display: block;
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--aurora-gold);
}
.detail-main {
  display: block;
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.88);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.detail-meta {
  display: block;
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.compact-actions {
  flex-direction: row;
  gap: 16rpx;
  margin-top: 16rpx;
}
.sheet-action.compact {
  flex: 1;
  min-height: 88rpx;
  justify-content: center;
}

/* ===== Calendar Info Sheet ===== */
.calendar-info-sheet {
  z-index: 64;
}
.calendar-info-panel {
  max-height: 84vh;
}
.legend-list,
.prediction-explanation,
.monthly-recap {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.legend-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
}
.legend-symbol {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: var(--radius-circle);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: #0A0E27;
  background: rgba(232,144,158,0.88);
}
.legend-row.memory .legend-symbol {
  background: rgba(240,196,192,0.9);
}
/* 今天图例 — 与 .day-cell.today 同款玫瑰光圈，不再是日历上不存在的「今」字 */
.legend-row.today .legend-symbol {
  color: #E8909E;
  background: rgba(232,144,158,0.16);
  box-shadow: inset 0 0 0 3rpx rgba(196,160,210,0.55);
}
.legend-row.predict .legend-symbol,
.legend-row.holiday .legend-symbol,
.legend-row.workday .legend-symbol {
  background: rgba(212,165,116,0.9);
}
/* 节日图例 — 金底海军字小标签，对应日历上的真实节日名称标签。
   「中秋」两字保持 caption 字号，加宽标签避免在 54rpx 圆槽里换行裁切。 */
.legend-row.holiday .legend-symbol {
  width: auto;
  min-width: 88rpx;
  box-sizing: border-box;
  padding: 0 12rpx;
  border-radius: var(--radius-sm);
  white-space: nowrap;
}
.legend-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.legend-title {
  display: block;
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  color: rgba(255,255,255,0.88);
  line-height: 1.25;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.legend-text {
  display: block;
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.prediction-summary {
  display: block;
  min-width: 0;
  padding: 22rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.9);
  background: rgba(212,165,116,0.12);
  border: 1px solid rgba(212,165,116,0.18);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.explain-line {
  min-width: 0;
  min-height: 64rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  background: rgba(255,255,255,0.065);
  border: 1px solid rgba(255,255,255,0.09);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.recap-summary {
  display: block;
  min-width: 0;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.82);
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.recap-highlights {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.recap-highlight {
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.78);
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  word-break: break-all;
  overflow-wrap: anywhere;
}
.copy-recap {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  white-space: nowrap;
  color: #0A0E27;
  background: var(--aurora-pink);
  box-shadow: 0 14rpx 34rpx rgba(232,144,158,0.18);
}
.copy-recap:active {
  transform: scale(0.98);
}
/* issue #118：弹层盖住首页时暂停这五层装饰，卸掉标记后从当前帧继续。减弱动效仍是 animation: none。 */
.page.page-obscured::before,
.page.page-obscured .glow-orb,
.page.page-obscured .header-gradient::before,
.page.page-obscured .header-gradient::after {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  .day-sheet-mask.sheet-open,
  .day-sheet-mask.sheet-open .sheet-slide,
  .sheet-slide,
  .sync-pill,
  .sync-pill.sync-open,
  .sync-pill.syncing .sync-dot,
  .refresh-retry,
  .day-sheet-mask,
  .day-action-sheet,
  .calendar-jump-sheet,
  .month-title-trigger,
  .nav-btn,
  .jump-option,
  .jump-confirm,
  .jump-year-step,
  .sheet-action,
  .sheet-close,
  .day-cell,
  .stat-item,
  .reminder-card,
  .quick-btn,
  .no-room-icon {
    animation: none;
    transition: none;
  }
}
