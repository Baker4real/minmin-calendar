<import src="/pages/shared/confirmation-sheet.wxml" />
<import src="/pages/shared/nav-bar.wxml" />
<page-meta page-style="{{pageObscured ? 'overflow: hidden;' : ''}}"></page-meta>
<template is="sharedSheetPage" data="{{sheetExitGuard: sheetExitGuard}}" />
<view class="page safe-top {{pageObscured ? 'page-obscured' : ''}} {{pageHidden ? 'page-hidden' : ''}}" style="--safe-top: {{safeTop}}px; --safe-bottom: {{safeBottom}}px; --nav-bar-height: {{navBarHeight}}px; --capsule-right: {{capsuleRight}}px; --nav-title-padding-left: {{navTitlePaddingLeft}}px; --nav-title-padding-right: {{navTitlePaddingRight}}px">
<wxs module="sheetDrag" src="../../utils/sheetDrag.wxs"></wxs>
<wxs module="monthSwipe">
var SWIPE_PX = 48

function touchStart(event, ownerInstance) {
  var instance = event.instance
  if (!instance) return
  var state = instance.getState()
  if (state.tracking) return
  var touch = event.touches && event.touches[0]
  if (!touch) return
  state.tracking = true
  state.identifier = touch.identifier
  state.startX = touch.pageX
  state.startY = touch.pageY
}

function touchMove(event, ownerInstance) {
  var instance = event.instance
  if (!instance) return
  var state = instance.getState()
  if (!state.tracking) return
  var touch = findTouch(event.touches, state.identifier)
  if (!touch) return
  if (horizontalWins(touch.pageX - state.startX, touch.pageY - state.startY)) return false
}

function touchEnd(event, ownerInstance) {
  var instance = event.instance
  if (!instance) return
  var state = instance.getState()
  if (!state.tracking) return
  var touch = findTouch(event.changedTouches, state.identifier)
  state.tracking = false
  if (!touch) return
  var dx = touch.pageX - state.startX
  var dy = touch.pageY - state.startY
  if (!horizontalWins(dx, dy)) return
  ownerInstance.callMethod('onCalendarSwipe', { dx: dx, dy: dy })
}

function touchCancel(event, ownerInstance) {
  var instance = event.instance
  if (!instance) return
  instance.getState().tracking = false
}

function horizontalWins(dx, dy) {
  var absX = dx < 0 ? -dx : dx
  var absY = dy < 0 ? -dy : dy
  return absX > SWIPE_PX && absX > absY
}

function findTouch(touches, identifier) {
  if (!touches) return null
  var index = 0
  for (index = 0; index < touches.length; index++) {
    if (touches[index].identifier === identifier) return touches[index]
  }
  return null
}

module.exports = {
  touchStart: touchStart,
  touchMove: touchMove,
  touchEnd: touchEnd,
  touchCancel: touchCancel
}
</wxs>
  <include src="/pages/shared/aurora.wxml" />

  <template is="sharedNavbar" data="{{variant: 'home', title: '美少女的日历', pageObscured: pageObscured, syncStatusMounted: syncStatusMounted, syncStatusPhase: syncStatusPhase, refreshing: refreshing, syncStatusText: syncStatusText}}" />

  <view wx:if="{{noRoom}}" class="no-room" aria-hidden="{{pageObscured}}">
    <!-- 爱心画面只属于未绑定/需要重新绑定；加载失败保持失败标题 + 重试，不复用这颗心（issue #79） -->
    <view wx:if="{{roomStatusAction == 'bind'}}" class="no-room-icon" aria-hidden="true">♥</view>
    <text class="text-pair-title no-room-title">{{roomStatusTitle}}</text>
    <text class="text-pair-desc no-room-desc">{{roomStatusDesc}}</text>
    <view class="btn-premium button-primary" bindtap="handleRoomStatusAction" aria-role="button" aria-label="{{roomStatusActionText}}" hover-start-time="20" hover-stay-time="70" hover-class="btn-premium-hover">{{roomStatusActionText}}</view>
  </view>

  <view wx:elif="{{loading && !hasLoadedHomeData}}" class="content calendar-skeleton" aria-role="status" aria-label="正在加载" aria-hidden="{{pageObscured}}">
    <!-- 骨架复用真实页边距、吸顶占位、周头和网格；唯一动画挂在整个父容器上（issue #239） -->
    <view class="home-sticky skeleton-sticky" aria-hidden="true">
      <view class="month-nav glass-surface skeleton-month-bar">
        <view class="nav-btn skeleton-control"></view>
        <view class="skeleton-month-title"></view>
        <view class="nav-btn skeleton-control"></view>
      </view>
      <view class="skeleton-status-bar"></view>
    </view>
    <view class="skeleton-sticky-spacer home-sticky-spacer"></view>
    <view class="week-header skeleton-week" aria-hidden="true">
      <view class="week-cell skeleton-week-cell" wx:for="{{[0, 1, 2, 3, 4, 5, 6]}}" wx:key="*this"></view>
    </view>
    <view class="skeleton-grid calendar-grid calendar-density-{{calendarDensity}}{{calendarInfoMerged ? ' calendar-info-merged' : ''}}" style="--calendar-row-height: {{calendarRowHeightPx}}px" aria-hidden="true">
      <view class="skeleton-days">
        <view class="skeleton-cell{{item.isEmpty ? ' skeleton-cell-empty' : ''}}" wx:for="{{days}}" wx:key="index"></view>
      </view>
    </view>
    <view class="quick-actions skeleton-quick-actions" aria-hidden="true">
      <view class="skeleton-quick-action"></view>
      <view class="skeleton-quick-action"></view>
    </view>
  </view>

  <view wx:else class="content {{refreshing ? 'content-refreshing' : ''}}" aria-hidden="{{pageObscured}}">
    <view class="home-sticky">
      <view class="month-nav glass-surface">
        <view class="nav-btn {{prevMonthDisabled ? 'disabled' : ''}}" hover-start-time="20" hover-stay-time="70" hover-class="nav-btn-hover" bindtap="prevMonth" aria-role="button" aria-label="上一个月" aria-disabled="{{prevMonthDisabled}}">
          <view class="ui-icon ui-icon-left ui-icon-36 ui-icon-circle" aria-hidden="true"></view>
        </view>
        <view
          class="month-title month-title-trigger"
          bindtap="openMonthPicker"
          aria-role="button"
          aria-label="{{year}}年{{month + 1}}月，选择年份和月份"
          hover-start-time="20" hover-stay-time="70" hover-class="month-title-trigger-hover"
        >
          <text>{{year}}年{{month + 1}}月</text>
          <view class="ui-icon ui-icon-down ui-icon-24 month-title-caret" aria-hidden="true"></view>
        </view>
        <view class="nav-btn {{nextMonthDisabled ? 'disabled' : ''}}" hover-start-time="20" hover-stay-time="70" hover-class="nav-btn-hover" bindtap="nextMonth" aria-role="button" aria-label="下一个月" aria-disabled="{{nextMonthDisabled}}">
          <view class="ui-icon ui-icon-right ui-icon-36 ui-icon-circle" aria-hidden="true"></view>
        </view>
      </view>
      <view
        wx:if="{{showBackToToday}}"
        class="back-today"
        hover-start-time="20" hover-stay-time="70" hover-class="back-today-hover"
        bindtap="jumpToToday"
        aria-role="button"
        aria-label="回到今天"
      >回到今天</view>
      <view
        class="home-status {{homeStatus.tone == 'neutral' ? 'neutral' : ''}}"
        hover-start-time="20" hover-stay-time="70" hover-class="home-status-hover"
        bindtap="openPredictionSheet"
        aria-role="button"
        aria-label="{{homeStatus.ariaLabel}}"
      >
        <text class="home-status-text">{{homeStatus.text}}</text>
        <text wx:if="{{homeStatus.countdownText}}" class="home-status-countdown">{{homeStatus.countdownText}}</text>
        <view class="ui-icon ui-icon-right ui-icon-24 home-status-arrow" aria-hidden="true"></view>
      </view>
    </view>
    <view class="home-sticky-spacer {{showBackToToday ? 'with-back-today' : ''}}"></view>
    <!-- 等待邀请与一次性欢迎共用同一个正常文档流槽位和日历账本项（issue #219） -->
    <view wx:if="{{partnerInvite}}" class="partner-invite">
      <view class="partner-invite-copy">
        <text class="text-pair-title partner-invite-title">TA 还没加入</text>
        <text class="text-pair-desc partner-invite-desc">发个邀请，TA 加入后你们看的是同一本日历</text>
      </view>
      <button class="share-invite home-share-invite" open-type="share" hover-start-time="20" hover-stay-time="70" hover-class="home-share-invite-hover" aria-role="button" aria-label="发邀请">发邀请</button>
    </view>
    <!-- 一次性配对欢迎条：吸顶占位之后的正常文档流；整条直达图例，高度计入日历行高（issue #149、#215） -->
    <view wx:if="{{partnerWelcome}}" class="partner-welcome" hover-start-time="20" hover-stay-time="70" hover-class="partner-welcome-hover" bindtap="openLegendSheet" aria-role="button" aria-label="已和 TA 连上。点按打开日历图例">已和 TA 连上。玫瑰色带是经期，♥ 是欢乐时光，「预」是可能开始的日子。点这里或左上角「图例」随时再看</view>

    <!-- 刷新失败重试句：正常文档流放在月份导航与日历之间，不遮月份标题；留驻到重试成功（issue #79） -->
    <view wx:if="{{refreshRetryVisible}}" class="refresh-retry" bindtap="retryRefresh" aria-role="button" aria-label="{{refreshRetryLabel}}" hover-start-time="20" hover-stay-time="70" hover-class="refresh-retry-hover">
      <text class="refresh-retry-text">{{refreshRetryText}}</text>
    </view>

    <view
      class="calendar-swipe"
      bindtouchstart="{{monthSwipe.touchStart}}"
      bindtouchmove="{{monthSwipe.touchMove}}"
      bindtouchend="{{monthSwipe.touchEnd}}"
      bindtouchcancel="{{monthSwipe.touchCancel}}"
    >
    <view class="week-header">
      <view class="week-cell" wx:for="{{weekDays}}" wx:key="*this">{{item}}</view>
    </view>

    <!-- 行高与清爽密度是否合并信息行都来自 utils/calendarRowHeight.js 的同一份几何账本（issue #153） -->
    <view class="calendar-grid calendar-density-{{calendarDensity}}{{calendarInfoMerged ? ' calendar-info-merged' : ''}}" style="--calendar-row-height: {{calendarRowHeightPx}}px">
      <!-- 翻月滑入只动这一层（issue #165）：方向记号与新月份的格子同一次更新换上；状态强调记号也挂在这里 -->
      <view class="calendar-days{{calendarFlip ? ' calendar-flip-' + calendarFlip : ''}}{{calendarEmphasis ? ' calendar-emphasis-' + calendarEmphasis : ''}}">
        <view
          class="day-cell {{item.isToday ? 'today' : ''}} {{item.isPeriod ? 'period' : ''}} {{item.periodSegment === 'start' ? 'period-start' : ''}} {{item.periodSegment === 'middle' ? 'period-middle' : ''}} {{item.periodSegment === 'end' ? 'period-end' : ''}} {{item.periodSegment === 'single' ? 'period-single' : ''}} {{item.periodOpenEnd ? 'period-open' : ''}} {{item.isMemory ? 'memory' : ''}} {{item.isPredict ? 'predict' : ''}} {{item.isHoliday ? 'holiday' : ''}} {{item.isWorkday ? 'workday' : ''}} {{item.isEmpty ? 'empty' : ''}} {{recordFeedback[item.date] === 'memory' || recordFeedback[item.date] === 'both' ? 'record-feedback-memory' : ''}} {{recordFeedback[item.date] === 'period' || recordFeedback[item.date] === 'both' ? 'record-feedback-period' : ''}}"
          wx:for="{{days}}"
          wx:key="index"
          bindtap="onDayTap"
          data-date="{{item.date}}"
          aria-role="button"
          aria-hidden="{{item.isEmpty}}"
          aria-label="{{item.ariaLabel}}"
          hover-start-time="20" hover-stay-time="70" hover-class="day-cell-hover"
        >
          <view class="day-num">{{item.day}}</view>
          <view class="period-slot" aria-hidden="true">
            <view wx:if="{{item.periodSegment != 'none'}}" class="period-band"></view>
          </view>
          <view wx:if="{{!item.isEmpty && calendarDensity == 'full'}}" class="day-lunar">{{item.lunarCellText}}</view>
          <view class="day-info">
            <view wx:if="{{!item.isEmpty}}" class="day-tag-line">
              <text wx:if="{{item.holidayName}}" class="day-tag holiday-tag">{{item.holidayName}}</text>
              <text wx:elif="{{item.isWorkday}}" class="day-tag workday-tag">班</text>
            </view>
            <view class="day-marks">
              <view wx:if="{{item.isMemory}}" class="mark memory-mark">♥</view>
              <view wx:if="{{item.isPredict}}" class="mark predict-mark">预</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    </view>

    <!-- 首页记录入口：图标用日历图例的单日经期色带与欢乐时光浅色心（海军圆盘承载），不用表情 -->
    <view class="quick-actions">
      <view class="quick-btn button-primary" bindtap="quickPeriod" aria-role="button" aria-label="{{periodQuickAriaLabel}}" hover-start-time="20" hover-stay-time="70" hover-class="quick-btn-hover">
        <view class="quick-icon sample-plate">
          <template is="periodBandSample" data="{{...periodBandSample, calendarDensity: calendarDensity}}" />
        </view>
        <text class="quick-text">{{periodQuickLabel}}</text>
      </view>
      <view class="quick-ghost-surface">
        <view class="quick-btn btn-ghost button-outline" bindtap="quickMemory" aria-role="button" aria-label="记欢乐时光" hover-start-time="20" hover-stay-time="70" hover-class="btn-ghost-hover">
          <text class="quick-icon memory-tone">♥</text>
          <text class="quick-text">记欢乐时光</text>
        </view>
      </view>
    </view>

    <view
      wx:if="{{hasRecords}}"
      class="month-summary"
      hover-start-time="20" hover-stay-time="70" hover-class="month-summary-hover"
      bindtap="openMonthlyRecap"
      aria-role="button"
      aria-label="查看本月小结，{{monthSummaryLine}}"
    >
      <text class="month-summary-text">{{monthSummaryLine}}</text>
      <view class="ui-icon ui-icon-right ui-icon-24 month-summary-arrow" aria-hidden="true"></view>
    </view>

    <view wx:if="{{!hasRecords}}" class="empty-state empty-guide">
      <text class="empty-guide-text">点今天或过去的一天开始记录</text>
    </view>
  </view>

  <template is="sharedBottomSheet" data="{{sheetId: 'monthPicker', sheetMounted: monthPickerMounted, sheetPhase: monthPickerPhase, sheetHostClass: 'month-jump-mask', sheetPanelClass: 'calendar-jump-sheet', sheetName: '月份选择', sheetTitle: '选择月份', sheetSubtitle: year + '年' + (month + 1) + '月', maskHandler: 'closeMonthPicker', closeHandler: 'closeMonthPicker', bodyTemplate: 'monthPickerSheetBody', sheetDragClear: sheetDragClear.monthPicker, year: year, month: month, jumpYear: jumpYear, jumpMonth: jumpMonth, jumpYearAtMin: jumpYearAtMin, jumpYearAtMax: jumpYearAtMax, jumpMonths: jumpMonths}}" />

  <template is="sharedBottomSheet" data="{{sheetId: 'dayActions', sheetMounted: dayActionsMounted, sheetPhase: dayActionsPhase, sheetHostClass: '', sheetPanelClass: '', sheetName: '当日操作', sheetTitle: selectedDateLabel, sheetSubtitle: selectedDateSubtitle, maskHandler: 'closeDayActions', closeHandler: 'closeDayActions', bodyTemplate: 'dayActionsSheetBody', sheetDragClear: sheetDragClear.dayActions, selectedDayDetail: selectedDayDetail, daySheetMode: daySheetMode, dayDetailFade: dayDetailFade, periodBandSample: periodBandSample, calendarDensity: calendarDensity}}" />

  <template is="sharedBottomSheet" data="{{sheetId: 'infoSheet', sheetMounted: infoSheetMounted, sheetPhase: infoSheetPhase, sheetHostClass: 'calendar-info-sheet', sheetPanelClass: 'calendar-info-panel', sheetName: infoSheetName, sheetTitle: infoSheetMode == 'legend' ? '日历图例' : infoSheetMode == 'prediction' ? predictionExplanation.title : monthlyRecap ? monthlyRecap.title : '', sheetSubtitle: infoSheetMode == 'recap' ? year + '年' + (month + 1) + '月' : '', maskHandler: 'closeInfoSheet', closeHandler: 'closeInfoSheet', bodyTemplate: 'infoSheetBody', sheetDragClear: sheetDragClear.infoSheet, infoSheetMode: infoSheetMode, predictionExplanation: predictionExplanation, monthlyRecap: monthlyRecap, legendItems: legendItems, calendarDensity: calendarDensity}}" />
</view>
