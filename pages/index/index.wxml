<view class="page safe-top {{pageObscured ? 'page-obscured' : ''}}" style="--safe-top: {{safeTop}}px; --safe-bottom: {{safeBottom}}px; --nav-bar-height: {{navBarHeight}}px; --capsule-right: {{capsuleRight}}px">
<wxs module="sheetDrag" src="../../utils/sheetDrag.wxs"></wxs>
<wxs module="monthSwipe" src="../../utils/monthSwipe.wxs"></wxs>
  <view class="reduced-motion-probe" aria-hidden="true"></view>
  <!-- Aurora Decorative Orbs -->
  <view class="glow-orb glow-orb-1"></view>
  <view class="glow-orb glow-orb-2"></view>

  <view class="nav-bar header-gradient">
    <view class="nav-placeholder"></view>
    <view class="nav-title">美少女的日历</view>
  </view>

  <view wx:if="{{noRoom}}" class="no-room">
    <!-- 爱心画面只属于未绑定/需要重新绑定；加载失败保持失败标题 + 重试，不复用这颗心（issue #79） -->
    <view wx:if="{{roomStatusAction == 'bind'}}" class="no-room-icon">♥</view>
    <text class="no-room-title">{{roomStatusTitle}}</text>
    <text class="no-room-desc">{{roomStatusDesc}}</text>
    <view class="btn-premium" bindtap="handleRoomStatusAction" aria-role="button" aria-label="{{roomStatusActionText}}">{{roomStatusActionText}}</view>
  </view>

  <view wx:elif="{{loading && !hasLoadedHomeData}}" class="loading-view">
    <view class="loading-spinner" aria-label="正在加载"></view>
  </view>

  <view wx:else class="content {{refreshing ? 'content-refreshing' : ''}}">
    <view wx:if="{{syncStatusMounted}}" class="sync-pill sync-{{syncStatusPhase}} {{refreshing ? 'syncing' : ''}}" aria-role="status" aria-label="{{syncStatusText}}">
      <view class="sync-dot"></view>
      <text class="sync-text">{{syncStatusText}}</text>
    </view>

    <view class="month-nav">
      <view class="nav-btn" hover-class="nav-btn-hover" bindtap="prevMonth" aria-role="button" aria-label="上一个月">‹</view>
      <view
        class="month-title month-title-trigger"
        bindtap="openMonthPicker"
        aria-role="button"
        aria-label="选择年份和月份"
      >
        <text>{{year}}年{{month + 1}}月</text>
        <text class="month-title-caret">⌄</text>
      </view>
      <!-- issue #105：图例/预测说明/本月小结收进月份标题旁的「…」菜单（⌄ 已用于选月 caret，不重复占用） -->
      <view class="nav-btn month-menu-trigger" bindtap="openMonthMenu" aria-role="button" aria-label="打开工具菜单">…</view>
      <view class="nav-btn" hover-class="nav-btn-hover" bindtap="nextMonth" aria-role="button" aria-label="下一个月">›</view>
    </view>

    <!-- 刷新失败重试句：正常文档流放在月份导航与日历之间，不遮月份标题；留驻到重试成功（issue #79） -->
    <view wx:if="{{refreshRetryVisible}}" class="refresh-retry" bindtap="retryRefresh" aria-role="button" aria-label="日历刷新失败，点按重试">
      <text class="refresh-retry-text">刷新失败，点按重试</text>
    </view>

    <view
      class="calendar-swipe"
      bindtouchstart="{{monthSwipe.touchStart}}"
      bindtouchmove="{{monthSwipe.touchMove}}"
      bindtouchend="{{monthSwipe.touchEnd}}"
      bindtouchcancel="{{monthSwipe.touchEnd}}"
    >
    <view class="week-header">
      <view class="week-cell" wx:for="{{weekDays}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="calendar-grid calendar-density-{{calendarDensity}}">
      <view
        class="day-cell {{item.isToday ? 'today' : ''}} {{item.isPeriod ? 'period' : ''}} {{item.periodSegment === 'start' ? 'period-start' : ''}} {{item.periodSegment === 'middle' ? 'period-middle' : ''}} {{item.periodSegment === 'end' ? 'period-end' : ''}} {{item.periodSegment === 'single' ? 'period-single' : ''}} {{item.periodOpenEnd ? 'period-open' : ''}} {{item.isMemory ? 'memory' : ''}} {{item.isPredict ? 'predict' : ''}} {{item.isHoliday ? 'holiday' : ''}} {{item.isWorkday ? 'workday' : ''}} {{item.isEmpty ? 'empty' : ''}}"
        wx:for="{{days}}"
        wx:key="index"
        bindtap="onDayTap"
        data-date="{{item.date}}"
        aria-role="button"
        aria-hidden="{{item.isEmpty}}"
        aria-label="{{item.ariaLabel}}"
      >
        <view wx:if="{{item.periodSegment != 'none'}}" class="period-band"></view>
        <view class="day-num">{{item.day}}</view>
        <view wx:if="{{!item.isEmpty && calendarDensity == 'full'}}" class="day-lunar">{{item.lunarCellText}}</view>
        <view wx:if="{{!item.isEmpty}}" class="day-tag-line">
          <text wx:if="{{item.holidayName}}" class="day-tag holiday-tag">{{item.holidayName}}</text>
          <text wx:elif="{{item.isWorkday}}" class="day-tag workday-tag">班</text>
        </view>
        <view class="day-marks">
          <view wx:if="{{item.isMemory}}" class="mark memory-mark">♥</view>
          <view wx:if="{{item.isPredict}}" class="mark predict-mark">预</view>
        </view>
      </view>
    </view>
    </view>

    <!-- 首页记录入口：图标用日历图例的经期圆点与欢乐时光浅色心（海军圆盘承载），不用表情 -->
    <view class="quick-actions">
      <view class="quick-btn" bindtap="quickPeriod" aria-role="button" aria-label="{{periodQuickAriaLabel}}">
        <text class="quick-icon period-tone">●</text>
        <text class="quick-text">{{periodQuickLabel}}</text>
      </view>
      <view class="quick-btn" bindtap="quickMemory" aria-role="button" aria-label="记录欢乐时光">
        <text class="quick-icon memory-tone">♥</text>
        <text class="quick-text">欢乐时光</text>
      </view>
    </view>

    <!-- issue #105：合并状态卡——经期记录条数（不可点现状）+ 下次预测，卡内并入超期进行中与周期提醒；
         经期/欢乐时光列表由「记录」tab 分段承接，首页不再放列表入口 -->
    <view wx:if="{{hasRecords}}" class="status-card premium-card">
      <view class="status-row">
        <view class="status-figure">
          <text class="stat-num">{{periodCount}}</text>
          <text class="stat-label">经期记录</text>
        </view>
        <view class="stat-divider"></view>
        <view
          class="stat-item predict-item"
          bindtap="openPredictionSheet"
          aria-role="button"
          aria-label="{{nextPredictWeekday ? '查看经期预测，' + nextPredictDisplay + ' ' + nextPredictWeekday : '查看经期预测，暂无下次日期'}}"
        >
          <view class="predict-value">
            <text class="predict-date">{{nextPredictDisplay || '--'}}</text>
            <text wx:if="{{nextPredictWeekday}}" class="predict-weekday">{{nextPredictWeekday}}</text>
          </view>
          <text class="stat-label">预测下次</text>
        </view>
      </view>

      <!-- issue #98：超期进行中记录的一次非阻塞完成提示：同一记录只提示一次，点击打开同一条记录补填结束日期 -->
      <view wx:if="{{ongoingCompletionReminder}}" class="status-reminders">
        <view
          class="reminder-card {{ongoingCompletionReminder.type}}"
          bindtap="onOngoingReminderTap"
          aria-role="button"
          aria-label="{{ongoingCompletionReminder.title}}，{{ongoingCompletionReminder.text}}，点按去补填"
        >
          <view class="reminder-rail"></view>
          <view class="reminder-copy">
            <text class="reminder-title">{{ongoingCompletionReminder.title}}</text>
            <text class="reminder-text">{{ongoingCompletionReminder.text}}</text>
          </view>
          <text class="reminder-action">去补填</text>
        </view>
      </view>

      <view wx:if="{{cycleReminders.length}}" class="status-reminders">
        <view
          class="reminder-card {{item.type}}"
          wx:for="{{cycleReminders}}"
          wx:key="type"
          data-index="{{index}}"
          bindtap="onReminderTap"
          aria-role="button"
          aria-label="{{item.title}}，{{item.text}}，点按记录"
        >
          <view class="reminder-rail"></view>
          <view class="reminder-copy">
            <text class="reminder-title">{{item.title}}</text>
            <text class="reminder-text">{{item.text}}</text>
          </view>
          <text class="reminder-action">记录</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-guide">
      <text class="empty-guide-text">点日历任意一天开始记录</text>
    </view>
  </view>

  <view wx:if="{{monthPickerMounted}}" class="sheet-host month-jump-mask">
    <view class="day-sheet-mask sheet-{{monthPickerPhase}}" bindtap="closeMonthPicker" aria-role="button" aria-label="关闭月份选择"></view>
    <view class="sheet-slide sheet-slide-monthPicker sheet-{{monthPickerPhase}}" change:reset="{{sheetDrag.clearInline}}" reset="{{sheetDragClear.monthPicker}}">
    <view class="calendar-jump-sheet safe-bottom" catchtap="noop">
      <view class="sheet-drag-zone" data-sheet="monthPicker" bindtouchstart="{{sheetDrag.touchStart}}" bindtouchmove="{{sheetDrag.touchMove}}" bindtouchend="{{sheetDrag.touchEnd}}" bindtouchcancel="{{sheetDrag.touchEnd}}">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-date-copy">
          <text class="sheet-title">选择月份</text>
          <text class="sheet-subtitle">{{jumpYear}}年{{jumpMonth + 1}}月</text>
        </view>
        <view class="sheet-close" bindtap="closeMonthPicker" aria-role="button" aria-label="关闭">×</view>
      </view>
      </view>

      <view
        class="jump-today"
        bindtap="jumpToToday"
        aria-role="button"
        aria-label="回到今天所在月份"
      >
        <text class="jump-today-label">回到今天</text>
        <text class="jump-today-date">定位到当前月份</text>
      </view>

      <view class="jump-section">
        <text class="jump-section-title">年份</text>
        <view class="jump-year-stepper">
          <view
            class="jump-year-step {{jumpYearAtMin ? 'disabled' : ''}}"
            data-delta="-1"
            bindtap="shiftJumpYear"
            aria-role="button"
            aria-label="上一年"
            aria-disabled="{{jumpYearAtMin}}"
          >‹</view>
          <text class="jump-year-value">{{jumpYear}}年</text>
          <view
            class="jump-year-step {{jumpYearAtMax ? 'disabled' : ''}}"
            data-delta="1"
            bindtap="shiftJumpYear"
            aria-role="button"
            aria-label="下一年"
            aria-disabled="{{jumpYearAtMax}}"
          >›</view>
        </view>
      </view>

      <view class="jump-section">
        <text class="jump-section-title">月份</text>
        <view class="jump-month-grid">
          <view
            class="jump-option month-option {{item.value == jumpMonth ? 'active' : ''}}"
            wx:for="{{jumpMonths}}"
            wx:key="value"
            data-month="{{item.value}}"
            bindtap="selectJumpMonth"
            aria-role="radio"
            aria-label="选择{{item.label}}"
            aria-checked="{{item.value == jumpMonth}}"
          >{{item.label}}</view>
        </view>
      </view>
    </view>
    </view>
  </view>

  <view wx:if="{{dayActionMounted}}" class="sheet-host">
    <view class="day-sheet-mask sheet-{{dayActionPhase}}" bindtap="closeDayActions" aria-role="button" aria-label="关闭当日操作"></view>
    <view class="sheet-slide sheet-slide-dayActions sheet-{{dayActionPhase}}" change:reset="{{sheetDrag.clearInline}}" reset="{{sheetDragClear.dayActions}}">
    <view class="day-action-sheet safe-bottom" catchtap="noop">
      <view class="sheet-drag-zone" data-sheet="dayActions" bindtouchstart="{{sheetDrag.touchStart}}" bindtouchmove="{{sheetDrag.touchMove}}" bindtouchend="{{sheetDrag.touchEnd}}" bindtouchcancel="{{sheetDrag.touchEnd}}">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-date-copy">
          <text class="sheet-title">{{selectedDateLabel}}</text>
          <text class="sheet-subtitle">{{selectedDateSubtitle}}</text>
        </view>
        <view class="sheet-close" bindtap="closeDayActions" aria-role="button" aria-label="关闭">×</view>
      </view>
      </view>

      <block wx:if="{{daySheetMode == 'actions'}}">
        <view class="sheet-actions">
          <view wx:if="{{!selectedDateIsFuture}}" class="sheet-action" data-action="period" bindtap="onDayActionTap" aria-role="button" aria-label="记录经期">
            <text class="sheet-action-icon period-tone">●</text>
            <view class="sheet-action-copy">
              <text class="sheet-action-title">记录经期</text>
              <text class="sheet-action-desc">添加这一天的经期记录</text>
            </view>
            <text class="sheet-action-arrow">›</text>
          </view>
          <view class="sheet-action" data-action="memory" bindtap="onDayActionTap" aria-role="button" aria-label="记录欢乐时光">
            <text class="sheet-action-icon memory-tone">♥</text>
            <view class="sheet-action-copy">
              <text class="sheet-action-title">欢乐时光</text>
              <text class="sheet-action-desc">写下这一天的特别记忆</text>
            </view>
            <text class="sheet-action-arrow">›</text>
          </view>
          <view class="sheet-action" data-action="detail" bindtap="onDayActionTap" aria-role="button" aria-label="查看详情">
            <text class="sheet-action-icon detail-tone">i</text>
            <view class="sheet-action-copy">
              <text class="sheet-action-title">查看详情</text>
              <text class="sheet-action-desc">经期与记忆都在这里</text>
            </view>
            <text class="sheet-action-arrow">›</text>
          </view>
        </view>
      </block>

      <view wx:elif="{{daySheetMode == 'detail'}}" class="{{dayDetailFade ? 'day-detail-fade' : ''}}">
        <view class="day-detail-list">
          <view wx:if="{{selectedDayDetail.meanings && selectedDayDetail.meanings.length}}" class="detail-meaning-list">
            <view
              wx:for="{{selectedDayDetail.meanings}}"
              wx:key="key"
              class="detail-meaning {{item.key}}"
            >
              <text class="detail-meaning-title">{{item.title}}</text>
              <text class="detail-meaning-text">{{item.text}}</text>
            </view>
          </view>

          <view wx:if="{{selectedDayDetail.empty}}" class="day-detail-empty">
            <text class="detail-empty-title">当天无记录</text>
            <text class="detail-empty-desc">可以从这里补一条经期或记忆</text>
          </view>

          <view
            wx:for="{{selectedDayDetail.periods}}"
            wx:key="key"
            class="day-detail-row period-detail"
          >
            <view class="detail-rail"></view>
            <view class="detail-copy">
              <text class="detail-title">经期</text>
              <text class="detail-main">{{item.range}}</text>
              <text wx:if="{{item.metaText}}" class="detail-meta">{{item.metaText}}</text>
            </view>
          </view>

          <view
            wx:for="{{selectedDayDetail.memories}}"
            wx:key="key"
            class="day-detail-row memory-detail"
          >
            <view class="detail-rail"></view>
            <view class="detail-copy">
              <text class="detail-title">欢乐时光</text>
              <text class="detail-main">{{item.note}}</text>
            </view>
          </view>
        </view>

        <view class="sheet-actions compact-actions">
          <view wx:if="{{!selectedDateIsFuture}}" class="sheet-action compact" data-action="period" bindtap="onDayActionTap" aria-role="button" aria-label="补经期">
            <text class="sheet-action-icon period-tone">●</text>
            <text class="sheet-action-title">补经期</text>
          </view>
          <view class="sheet-action compact" data-action="memory" bindtap="onDayActionTap" aria-role="button" aria-label="补欢乐时光">
            <text class="sheet-action-icon memory-tone">♥</text>
            <text class="sheet-action-title">补欢乐时光</text>
          </view>
        </view>
      </view>
    </view>
    </view>
  </view>

  <!-- issue #105：月份工具菜单——图例 / 预测说明 / 本月小结的常驻入口从工具条收进这里，sheet 本体复用 -->
  <view wx:if="{{monthMenuMounted}}" class="sheet-host">
    <view class="day-sheet-mask sheet-{{monthMenuPhase}}" bindtap="closeMonthMenu" aria-role="button" aria-label="关闭工具菜单"></view>
    <view class="sheet-slide sheet-slide-toolsMenu sheet-{{monthMenuPhase}}" change:reset="{{sheetDrag.clearInline}}" reset="{{sheetDragClear.toolsMenu}}">
    <view class="day-action-sheet safe-bottom" catchtap="noop">
      <view class="sheet-drag-zone" data-sheet="toolsMenu" bindtouchstart="{{sheetDrag.touchStart}}" bindtouchmove="{{sheetDrag.touchMove}}" bindtouchend="{{sheetDrag.touchEnd}}" bindtouchcancel="{{sheetDrag.touchEnd}}">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-date-copy">
          <text class="sheet-title">工具</text>
          <text class="sheet-subtitle">{{year}}年{{month + 1}}月</text>
        </view>
        <view class="sheet-close" bindtap="closeMonthMenu" aria-role="button" aria-label="关闭">×</view>
      </view>
      </view>

      <view class="sheet-actions">
        <view class="sheet-action" data-action="legend" bindtap="onMonthMenuTap" aria-role="button" aria-label="打开日历图例">
          <text class="sheet-action-icon detail-tone">?</text>
          <view class="sheet-action-copy">
            <text class="sheet-action-title">图例</text>
            <text class="sheet-action-desc">日历标记的含义</text>
          </view>
          <text class="sheet-action-arrow">›</text>
        </view>
        <view class="sheet-action" data-action="prediction" bindtap="onMonthMenuTap" aria-role="button" aria-label="查看经期预测">
          <text class="sheet-action-icon detail-tone">预</text>
          <view class="sheet-action-copy">
            <text class="sheet-action-title">预测说明</text>
            <text class="sheet-action-desc">下次经期怎么算出来的</text>
          </view>
          <text class="sheet-action-arrow">›</text>
        </view>
        <view class="sheet-action" data-action="recap" bindtap="onMonthMenuTap" aria-role="button" aria-label="查看本月小结">
          <text class="sheet-action-icon detail-tone">月</text>
          <view class="sheet-action-copy">
            <text class="sheet-action-title">本月小结</text>
            <text class="sheet-action-desc">经期与欢乐时光的回顾</text>
          </view>
          <text class="sheet-action-arrow">›</text>
        </view>
      </view>
    </view>
    </view>
  </view>

  <view wx:if="{{infoSheetMounted}}" class="sheet-host calendar-info-sheet">
    <view class="day-sheet-mask sheet-{{infoSheetPhase}}{{infoSheetHandoff ? ' sheet-handoff' : ''}}" bindtap="closeInfoSheet" aria-role="button" aria-label="关闭面板"></view>
    <view class="sheet-slide sheet-slide-info sheet-{{infoSheetPhase}}" change:reset="{{sheetDrag.clearInline}}" reset="{{sheetDragClear.info}}">
    <view class="day-action-sheet calendar-info-panel safe-bottom" catchtap="noop">
      <view class="sheet-drag-zone" data-sheet="info" bindtouchstart="{{sheetDrag.touchStart}}" bindtouchmove="{{sheetDrag.touchMove}}" bindtouchend="{{sheetDrag.touchEnd}}" bindtouchcancel="{{sheetDrag.touchEnd}}">
      <view class="sheet-handle"></view>
      <view class="sheet-head">
        <view class="sheet-date-copy">
          <text wx:if="{{infoSheetMode == 'legend'}}" class="sheet-title">日历图例</text>
          <text wx:elif="{{infoSheetMode == 'prediction'}}" class="sheet-title">{{predictionExplanation.title}}</text>
          <text wx:elif="{{infoSheetMode == 'recap' && monthlyRecap}}" class="sheet-title">{{monthlyRecap.title}}</text>
          <text class="sheet-subtitle">{{year}}年{{month + 1}}月</text>
        </view>
        <view class="sheet-close" bindtap="closeInfoSheet" aria-role="button" aria-label="关闭">×</view>
      </view>
      </view>

      <view wx:if="{{infoSheetMode == 'legend'}}" class="legend-list">
        <view wx:for="{{legendItems}}" wx:key="key" class="legend-row">
          <view class="legend-sample day-cell {{item.cellClass}}">
            <block wx:for="{{item.parts}}" wx:for-item="part" wx:key="className">
              <view wx:if="{{part.kind == 'band' || part.kind == 'num' || part.kind == 'mark'}}" class="{{part.className}}">{{part.text}}</view>
              <text wx:elif="{{part.kind == 'tag'}}" class="{{part.className}}">{{part.text}}</text>
            </block>
          </view>
          <view class="legend-copy">
            <text class="legend-title">{{item.title}}</text>
            <text class="legend-text">{{item.text}}</text>
          </view>
        </view>
      </view>

      <view wx:elif="{{infoSheetMode == 'prediction'}}" class="prediction-explanation">
        <text class="prediction-summary">{{predictionExplanation.summary}}</text>
        <view
          wx:for="{{predictionExplanation.lineItems}}"
          wx:key="key"
          class="explain-line"
        >{{item.text}}</view>
      </view>

      <view wx:elif="{{infoSheetMode == 'recap' && monthlyRecap}}" class="monthly-recap">
        <text class="recap-summary">{{monthlyRecap.periodSummary}}</text>
        <text class="recap-summary">{{monthlyRecap.memorySummary}}</text>
        <text class="recap-summary">{{monthlyRecap.predictionSummary}}</text>
        <view wx:if="{{monthlyRecap.highlightItems.length}}" class="recap-highlights">
          <view
            wx:for="{{monthlyRecap.highlightItems}}"
            wx:key="key"
            class="recap-highlight"
          >{{item.text}}</view>
        </view>
        <view class="copy-recap" bindtap="copyMonthlyRecap" aria-role="button" aria-label="复制小结">复制小结</view>
      </view>
    </view>
    </view>
  </view>
  <page-container
    show="{{sheetExitGuard}}"
    overlay="{{false}}"
    duration="0"
    z-index="1"
    position="bottom"
    custom-style="height:0;width:0;overflow:hidden;opacity:0;pointer-events:none;background:transparent;"
    bindbeforeleave="onSheetSystemBack"
  ></page-container>
</view>
