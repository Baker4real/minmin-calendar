          >{{item.text}}</text>
        </view>
        <view class="copy-recap" bindtap="copyMonthlyRecap" aria-role="button" aria-label="复制小结" hover-class="copy-recap-hover">复制小结</view>
      </view>
    </view>
    </view>
  </view>
  <!-- 不弹层时不要把 page-container 留在树上。show 为 false 时它仍是原生层，会吃掉页面点击，底部 tab 不受影响。 -->
  <page-container
    wx:if="{{sheetExitGuard}}"
    show="{{true}}"
    overlay="{{false}}"
    duration="0"
    z-index="1"
    position="bottom"
    custom-style="height:0;width:0;overflow:hidden;opacity:0;pointer-events:none;background:transparent;"
    bindbeforeleave="onSheetSystemBack"
  ></page-container>
</view>
