/* ===== Aurora Bloom: Period ===== */
/* 导航标题不可点：中性文字色（共享基类在 app.wxss，页面侧覆盖颜色，issue #77） */
.nav-title {
  color: rgba(255,255,255,0.92);
}
.content {
  padding: 0 24rpx 30rpx;
  position: relative;
  z-index: 1;
}

/* Cycle Card – 玫瑰薰衣草渐变 + Glass */
.cycle-card {
  background: linear-gradient(135deg, rgba(232,144,158,0.18), rgba(196,160,210,0.12)), var(--glass-fallback);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin: 24rpx 0 20rpx;
  box-shadow: 0 8px 32px rgba(232,144,158,0.15);
  position: relative;
  overflow: hidden;
}
.card-label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--text-secondary);
  position: relative;
}
.cycle-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  position: relative;
}
.cycle-item {
  text-align: center;
}
.cycle-num {
  font-size: 44rpx;
  font-weight: var(--font-weight-control);
  color: #fff;
  font-variant-numeric: tabular-nums;
}
.cycle-label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.5);
  margin-top: 8rpx;
  display: block;
}

/* Btn Premium */
.btn-premium {
  margin-bottom: 20rpx;
  line-height: var(--line-height-assist);
}

/* List Items */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.list-item:last-child {
  border-bottom: none;
}
.list-item:active,
.list-item.list-item-hover {
  background: rgba(255,255,255,0.05);
}
.item-left {
  flex: 1;
  min-width: 0;
}
.item-date {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.85);
}
.item-note {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.5);
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.item-tag {
  min-height: 38rpx;
  line-height: 38rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: var(--text-secondary);
  background: var(--glass-bg);
  border: 1px solid rgba(255,255,255,0.1);
}
/* 经量标签 = 编辑页选中芯片的玫瑰角色；症状标签保持上面的中性样式 */
.item-tag.flow {
  color: #0A0E27;
  background: rgba(232,144,158,0.92);
  border-color: rgba(232,144,158,0.95);
}
.item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.item-duration {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: #E8909E;
  background: rgba(232,144,158,0.12);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-md);
}
/* 进行中/结束日期不详：状态文案占住时长位置，语义不靠空白日期表达 */
.item-duration.ongoing {
  color: #E8909E;
  background: rgba(232,144,158,0.28);
}
.item-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

/* Skeleton Loading – 列表条目形状的哑光占位 */
.skeleton-card {
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-card);
  overflow: hidden;
}
.skeleton-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.skeleton-item:last-child {
  border-bottom: none;
}
.skeleton-body {
  flex: 1;
}
.skeleton-line {
  height: 28rpx;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}
.skeleton-line-title {
  width: 56%;
}
.skeleton-line-sub {
  width: 36%;
  height: 22rpx;
  margin-top: 12rpx;
}
.skeleton-pill {
  width: 88rpx;
  height: 40rpx;
  margin-left: 24rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}
@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* Segment Control – 记录分类（经期 / 欢乐时光）：弱态单选，选中项玫瑰描边+玫瑰字，
   不用主操作的实色填充（同设置页密度控件形态，issue #103） */
.segment-control {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin: 24rpx 0 20rpx;
  padding: 4rpx;
  box-sizing: border-box;
  border-radius: var(--radius-card);
  background: rgba(255,255,255,0.055);
  border: 1px solid rgba(255,255,255,0.11);
}
.segment-option {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  color: rgba(255,255,255,0.68);
  border: 1px solid transparent;
  transition: background-color var(--duration-press) ease, color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.segment-option:active,
.segment-option.segment-option-hover {
  transform: scale(0.98);
  background: rgba(255,255,255,0.1);
}
.segment-option.active {
  color: #E8909E;
  background: rgba(232,144,158,0.08);
  border-color: rgba(232,144,158,0.45);
}

/* Memory Segment – 欢乐时光月份分组（issue #108）：每月一张卡复用 app 级 .premium-card 玻璃面，
   本文件不新增玻璃/阴影面（per-file backdrop-filter/box-shadow 预算已满）。
   卡头可点切换展开/收起（issue #109）：即时生效、无动画（不写 transition/animation），
   右侧「展开/收起」是文字不是字形（「›」表示点开编辑、「⌄」已用于首页选月，见 DESIGN.md） */
.month-card {
  margin-bottom: 20rpx;
}
.month-card:last-child {
  margin-bottom: 0;
}
.month-header {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
/* 收起时卡头是卡内唯一子节点：不出悬空分隔线 */
.month-header:last-child {
  border-bottom: none;
}
.month-header:active,
.month-header.month-header-hover {
  background: rgba(255,255,255,0.05);
}
.month-header-text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  white-space: nowrap;
}
/* 次级可点入口：caption 字号 + 不弱于 --text-secondary 的文字色（登记见 DESIGN.md 与对比度护栏） */
.month-toggle {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--text-secondary);
  white-space: nowrap;
}
/* 欢乐时光列表行（与 pages/memory/memory.wxss 同款，分段内嵌拷贝） */
.memory-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.memory-info {
  min-width: 0;
}
.memory-heart {
  font-size: 36rpx;
  color: #F0C4C0;
  filter: drop-shadow(0 0 10px rgba(240,196,192,0.3));
}
.memory-date {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.85);
}
.memory-note {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.memory-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}
/* 欢乐时光骨架是圆点变体（经期侧是 pill），复用已注册的 skeletonPulse */
.skeleton-dot {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-circle);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  .skeleton-line,
  .skeleton-pill,
  .skeleton-dot {
    animation: none;
  }
  .load-failed,
  .list-retry,
  .segment-option {
    transition: none;
  }
}

/* Empty State */
.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: rgba(255,255,255,0.5);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-card);
}

/* Load Failure —— 重试是可识别的操作（玫瑰小操作按钮），不是空列表的安静说明 */
.load-failed {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  transition: transform var(--duration-press) var(--ease-out);
}
.load-failed:active,
.load-failed.load-failed-hover {
  transform: scale(0.98);
}
.retry-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  border-radius: var(--radius-sm);
  background: var(--aurora-pink);
  color: #0A0E27;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
}
.retry-btn:active,
.retry-btn.retry-btn-hover {
  transform: scale(0.96);
}

/* 已有数据后刷新失败：列表与数字保留，重试行留在列表区域 */
.list-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 88rpx;
  margin-top: 16rpx;
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.list-retry:active,
.list-retry.list-retry-hover {
  background: rgba(255,255,255,0.05);
  transform: scale(0.97);
}
.list-retry-text {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--text-secondary);
}
