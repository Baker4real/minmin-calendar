/* ===== Aurora Bloom: Period ===== */
.content {
  padding: 0 24rpx 30rpx;
  position: relative;
  z-index: 1;
}

/* Cycle Card – 玫瑰薰衣草渐变 + Glass */
.cycle-card {
  background: linear-gradient(135deg, rgba(232,144,158,0.18), rgba(196,160,210,0.12)), var(--glass-fallback);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin: 24rpx 0 20rpx;
  box-shadow: 0 8px 32px rgba(232,144,158,0.15);
  position: relative;
  overflow: hidden;
}
.card-label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--text-secondary);
  position: relative;
}
.cycle-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  position: relative;
}
.cycle-item {
  text-align: center;
}
.cycle-num {
  font-size: 44rpx;
  font-weight: var(--font-weight-control);
  color: #fff;
  font-variant-numeric: tabular-nums;
}
.cycle-label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.5);
  margin-top: 8rpx;
  display: block;
}

/* Btn Premium */
.btn-premium {
  margin-bottom: 20rpx;
  line-height: var(--line-height-assist);
}

/* List Items */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color 0.3s ease, transform 0.3s ease;
}
.list-item:last-child {
  border-bottom: none;
}
.list-item:active {
  background: rgba(255,255,255,0.05);
}
.item-left {
  flex: 1;
}
.item-date {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.85);
}
.item-note {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.5);
  margin-top: 6rpx;
}
.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.item-tag {
  min-height: 38rpx;
  line-height: 38rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: var(--text-secondary);
  background: var(--glass-bg);
  border: 1px solid rgba(255,255,255,0.1);
}
.item-tag.flow {
  color: #0A0E27;
  background: rgba(212,165,116,0.86);
  border-color: rgba(212,165,116,0.9);
}
.item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.item-duration {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: #E8909E;
  background: rgba(232,144,158,0.12);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-md);
}
.item-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

/* Skeleton Loading – 列表条目形状的哑光占位 */
.skeleton-card {
  background: var(--glass-bg), var(--glass-fallback);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-card);
  overflow: hidden;
}
.skeleton-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.skeleton-item:last-child {
  border-bottom: none;
}
.skeleton-body {
  flex: 1;
}
.skeleton-line {
  height: 28rpx;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}
.skeleton-line-title {
  width: 56%;
}
.skeleton-line-sub {
  width: 36%;
  height: 22rpx;
  margin-top: 12rpx;
}
.skeleton-pill {
  width: 88rpx;
  height: 40rpx;
  margin-left: 24rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}
@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}
@media (prefers-reduced-motion: reduce) {
  .skeleton-line,
  .skeleton-pill {
    animation: none;
  }
}

/* Empty State */
.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: rgba(255,255,255,0.5);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  background: rgba(255,255,255,0.05), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-card);
}
