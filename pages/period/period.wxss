@import '../shared/segmented-control.wxss';
@import '../shared/retry-row.wxss';
@import '../shared/empty-state.wxss';

/* ===== Aurora Bloom: Period ===== */
/* 导航标题使用 pages/shared/nav-bar.wxss 的中性白。 */
.content {
  padding: 0 var(--space-page-gutter) 30rpx;
  position: relative;
  z-index: 1;
}

/* Cycle Card – 玫瑰薰衣草渐变 + Glass */
.cycle-card {
  background: linear-gradient(135deg, rgba(232,144,158,0.18), rgba(196,160,210,0.12)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-card);
  padding: 32rpx;
  /* 顶上不再多出 4rpx：与「欢乐时光」段的第一块同样离分段控件一个块间距（issue #164） */
  margin: 0 0 var(--space-page-block-gap);
  box-shadow: 0 16rpx 64rpx rgba(232,144,158,0.15);
}
.card-label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--text-secondary);
  position: relative;
}
.cycle-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  position: relative;
}
.cycle-item {
  text-align: center;
}
/* 三列统一标签在上、数字在下，间距落在数字上 */
.cycle-num {
  display: block;
  box-sizing: border-box;
  height: 52.8rpx;
  line-height: 52.8rpx;
  margin-top: var(--space-xs);
  font-size: 44rpx;
  font-weight: var(--font-weight-control);
  color: #fff;
  font-variant-numeric: tabular-nums;
}
/* 统计标签走次要文字档：在画布、玻璃回退和渐变两端都 ≥4.5:1（issue #158） */
.cycle-label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--text-secondary);
  display: block;
}

/* Btn Premium */
.btn-premium {
  margin-bottom: var(--space-page-block-gap);
  line-height: var(--line-height-assist);
}

/* 年份可独立折叠，展开后恢复各月份自己的选择。 */
.period-year + .period-year {
  margin-top: 28rpx;
}
.period-year-title {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 6rpx;
  margin-bottom: 12rpx;
  transition: opacity var(--duration-press) ease;
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-title);
  font-variant-numeric: tabular-nums;
  color: var(--text-secondary);
}

.year-toggle {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
}
.period-year-title:active,
.period-year-title.period-year-title-hover {
  opacity: 0.75;
}

/* List Items */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx var(--space-page-row-inset);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.list-item:last-child {
  border-bottom: none;
}
.list-item:active,
.list-item.list-item-hover {
  background: rgba(255,255,255,0.05);
}
.item-left {
  flex: 1;
  min-width: 0;
}
.item-date {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.85);
  overflow-wrap: anywhere;
}
.item-note {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--text-secondary);
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.item-tag {
  min-height: 38rpx;
  line-height: 38rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  color: var(--text-secondary);
  background: var(--glass-bg);
  border: 1px solid rgba(255,255,255,0.1);
}
/* 经量标签 = 分段选中态的弱态玫瑰角色；症状标签保持上面的中性样式（issue #225） */
.item-tag.flow {
  color: #E8909E;
  background: rgba(232,144,158,0.08);
  border-color: rgba(232,144,158,0.45);
}
.item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.item-duration {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  font-variant-numeric: tabular-nums;
  color: #E8909E;
  background: rgba(232,144,158,0.12);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-md);
}
/* 进行中/结束日期不详：状态文案占住时长位置。
   胶囊保留海军字叠 92% 玫瑰的实色强调，列表卡合成面上 ≥4.5:1（issue #143、#225） */
.item-duration.ongoing {
  color: var(--text-on-accent);
  background: rgba(232,144,158,0.92);
}
.item-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

/* Skeleton Loading – 列表条目形状的哑光占位 */
.skeleton-card {
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-card);
}
.skeleton-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx var(--space-page-row-inset);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.skeleton-item:last-child {
  border-bottom: none;
}
.skeleton-body {
  flex: 1;
}
.skeleton-line {
  height: 28rpx;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}
.skeleton-line-title {
  width: 56%;
}
.skeleton-line-sub {
  width: 36%;
  height: 22rpx;
  margin-top: 12rpx;
}
.skeleton-pill {
  width: 88rpx;
  height: 40rpx;
  margin-left: 24rpx;
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}

/* 记录分类使用 shared/segmented-control.wxss 的画布上变体；本页只保留节奏外边距。 */
.segment-control {
  margin: var(--space-page-first-block) 0 var(--space-page-block-gap);
}

/* 原生下拉期间补一行自有状态；不可点，不新增动效（issue #244）。 */
.refresh-status {
  box-sizing: border-box;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 0 20rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--text-secondary);
}

/* Memory Segment – 欢乐时光月份分组（issue #108）：每月一张卡复用 app 级 .premium-card 玻璃面，
   不另做一种卡面。
   卡头可点切换展开/收起（issue #109）：即时生效、无动画（不写 transition/animation），
   右侧「展开/收起」是文字不是字形（「›」表示点开编辑、「⌄」已用于首页选月，见 DESIGN.md） */
.month-card {
  margin-bottom: var(--space-page-block-gap);
}
.month-card:last-child {
  margin-bottom: 0;
}
.month-header {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx var(--space-page-row-inset);
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
/* 收起时卡头是卡内唯一子节点：不出悬空分隔线 */
.month-header:last-child {
  border-bottom: none;
}
.month-header:active,
.month-header.month-header-hover {
  background: rgba(255,255,255,0.05);
}
.month-header-main {
  flex: 1;
  min-width: 0;
}
.month-header-text {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-body);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.85);
  white-space: nowrap;
}
/* 收起卡头的备注摘要：单行，超出截断。读屏名在 aria-label 里，这里不再念一遍 */
.month-excerpt {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 次级可点入口：caption 字号 + 不弱于 --text-secondary 的文字色（登记见 DESIGN.md 与对比度护栏） */
.month-toggle {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--text-secondary);
  white-space: nowrap;
}
/* 欢乐时光列表行（与 pages/memory/memory.wxss 同款，分段内嵌拷贝） */
.memory-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.memory-info {
  min-width: 0;
}
.memory-heart {
  font-size: 36rpx;
  color: var(--color-memory);
  text-shadow: 0 0 10px rgba(240,196,192,0.3);
}
.memory-date {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.85);
}
.memory-note {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--text-secondary);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.memory-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}
/* 欢乐时光骨架是圆点变体（经期侧是 pill），复用已注册的 skeletonPulse */
.skeleton-dot {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-circle);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}

/* 空态结构共用 pages/shared/empty-state.wxss；本修饰类保留记录页的既有值。 */
.record-empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: var(--text-secondary);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  border-style: solid;
  border-color: rgba(255,255,255,0.08);
  border-radius: var(--radius-card);
}

/* Load Failure —— 重试是可识别的操作（玫瑰小操作按钮），不是空列表的安静说明 */
.load-failed {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  transition: transform var(--duration-press) var(--ease-out);
}
.load-failed:active,
.load-failed.load-failed-hover {
  transform: scale(0.98);
}
/* 未同步的分段在失败卡下面照常列出本机已保存的记录（#194），两块之间与月份卡同一档间距 */
.load-failed + .period-year-list,
.load-failed + .memory-month-list {
  margin-top: 20rpx;
}
.retry-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  border-radius: var(--radius-sm);
  background: var(--aurora-pink);
  color: var(--text-on-accent);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  transition: transform var(--duration-press) var(--ease-out);
}
.retry-btn:active,
.retry-btn.retry-btn-hover {
  transform: scale(0.96);
}

/* 已有数据后刷新失败：列表与数字保留；两段重试行共用 shared/retry-row.wxss（#234），本页只留位置间距。 */
.list-retry {
  margin-top: 16rpx;
}

/* 减弱动效：本页声明的动画和过渡都在这里覆盖，写在文件末尾才压得住它们（app.wxss 的同名覆盖会被本页规则盖过） */
@media (prefers-reduced-motion: reduce) {
  .skeleton-line,
  .skeleton-pill,
  .skeleton-dot {
    animation: none;
  }
  .list-item,
  .load-failed,
  .retry-btn,
  .period-year-title {
    transition: none;
  }
}
