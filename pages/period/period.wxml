<view class="page safe-top" style="--safe-top: {{safeTop}}px; --safe-bottom: {{safeBottom}}px; --nav-bar-height: {{navBarHeight}}px; --capsule-right: {{capsuleRight}}px">
  <view class="nav-bar header-gradient">
    <view class="nav-placeholder"></view>
    <view class="nav-title">记录</view>
  </view>

  <view class="content">
    <!-- 记录分类：经期 / 欢乐时光 同级可达，单选 radio 语义（issue #103） -->
    <view class="segment-control" aria-label="记录分类">
      <view
        class="segment-option {{segment === 'period' ? 'active' : ''}}"
        data-segment="period"
        bindtap="selectSegment"
        aria-role="radio"
        aria-label="经期记录"
        aria-checked="{{segment === 'period'}}"
      >经期</view>
      <view
        class="segment-option {{segment === 'memory' ? 'active' : ''}}"
        data-segment="memory"
        bindtap="selectSegment"
        aria-role="radio"
        aria-label="欢乐时光"
        aria-checked="{{segment === 'memory'}}"
      >欢乐时光</view>
    </view>

    <view wx:if="{{segment === 'period'}}">
      <view class="cycle-card">
        <text class="card-label">周期概览</text>
        <view class="cycle-stats">
          <view class="cycle-item">
            <!-- 首次加载失败时不给确信的 0；已成功加载过则保留上次的数字 -->
            <text wx:if="{{!loading && (!loadFailed || hasLoaded)}}" class="cycle-num">{{periods.length}}</text>
            <text wx:elif="{{!loading}}" class="cycle-num">--</text>
            <text class="cycle-label">总记录</text>
          </view>
          <view class="cycle-item">
            <text wx:if="{{!loading}}" class="cycle-num">{{avgCycle || '--'}}</text>
            <text class="cycle-label">平均周期</text>
          </view>
          <view class="cycle-item">
            <text wx:if="{{!loading}}" class="cycle-num">{{avgDuration || '--'}}</text>
            <text class="cycle-label">持续天数</text>
          </view>
        </view>
      </view>

      <view class="btn-premium" bindtap="addPeriod" aria-role="button" aria-label="新增经期记录">＋ 新增经期记录</view>

      <!-- 首次加载失败：重试是可识别的操作，不是与空列表一样的安静说明 -->
      <view wx:if="{{loadFailed && !hasLoaded && !loading}}" class="empty-state load-failed" bindtap="loadData" aria-role="button" aria-label="加载失败，点按重试">
        <text class="load-failed-text">经期记录加载失败</text>
        <view class="retry-btn">重试</view>
      </view>
      <view wx:elif="{{periods.length > 0 && !loading}}" class="premium-card">
        <view class="list-item" wx:for="{{periods}}" wx:key="_id" wx:for-index="i" bindtap="editPeriod" data-index="{{i}}" aria-role="button" aria-label="编辑经期记录 {{item.rangeSummary}}">
          <view class="item-left">
            <view class="item-date">{{item.dateLabel}}</view>
            <view wx:if="{{item.flowLabel || item.symptomText}}" class="item-tags">
              <text wx:if="{{item.flowLabel}}" class="item-tag flow">{{item.flowLabel}}</text>
              <text
                wx:for="{{item.symptomLabels}}"
                wx:for-item="tag"
                wx:key="*this"
                class="item-tag"
              >{{tag}}</text>
            </view>
            <view wx:if="{{item.note}}" class="item-note">{{item.note}}</view>
          </view>
          <view class="item-right">
            <text wx:if="{{item.status === 'known-end'}}" class="item-duration">{{item.durationText}}</text>
            <text wx:else class="item-duration ongoing">{{item.durationText}}</text>
            <text class="item-arrow">›</text>
          </view>
        </view>
      </view>
      <!-- 空态断言句只在确认没有失败时出现：成功加载 0 条后再刷新失败时，数字保留 0，语境由重试行解释 -->
      <view wx:elif="{{periods.length === 0 && !loading && !loadFailed}}" class="empty-state">
        <text>还没有经期记录\n点上面按钮新增</text>
      </view>

      <!-- 已成功加载过再失败：保留上次列表与数字，重试留在列表区域 -->
      <view wx:if="{{loadFailed && hasLoaded && !loading}}" class="list-retry" bindtap="loadData" aria-role="button" aria-label="刷新失败，点按重试">
        <text class="list-retry-text">刷新失败，正在显示上次的内容</text>
        <view class="retry-btn">重试</view>
      </view>

      <view wx:if="{{loading}}" class="skeleton-card">
        <view class="skeleton-item" wx:for="{{[0, 1, 2]}}" wx:key="*this">
          <view class="skeleton-body">
            <view class="skeleton-line skeleton-line-title"></view>
            <view class="skeleton-line skeleton-line-sub"></view>
          </view>
          <view class="skeleton-pill"></view>
        </view>
      </view>
    </view>

    <view wx:else>
      <view class="btn-premium" bindtap="addMemory" aria-role="button" aria-label="记录欢乐时光">＋ 记录欢乐时光</view>

      <!-- 从未成功加载就失败：重试是可识别的操作，不是与空列表一样的安静说明 -->
      <view wx:if="{{memoryLoadFailed && !memoryHasLoaded && !memoryLoading}}" class="empty-state load-failed" bindtap="loadMemoryData" aria-role="button" aria-label="加载失败，点按重试">
        <text class="load-failed-text">欢乐时光加载失败</text>
        <view class="retry-btn">重试</view>
      </view>
      <!-- 欢乐时光月份分组（issue #108）：每月一张玻璃卡，卡头写年月与条数；
           点卡头切换展开/收起，默认只展开最近一个有记录的月份，收起时组内行不渲染（issue #109） -->
      <view wx:elif="{{memories.length > 0 && !memoryLoading}}" class="memory-month-list">
        <view class="premium-card month-card" wx:for="{{memoryGroups}}" wx:key="key" wx:for-item="group">
          <view class="month-header" bindtap="toggleMonth" data-key="{{group.key}}" aria-role="button" aria-label="{{group.ariaLabel}}" aria-expanded="{{group.expanded}}">
            <text class="month-header-text">{{group.title}}</text>
            <text class="month-toggle">{{group.toggleLabel}}</text>
          </view>
          <view class="list-item" wx:if="{{group.expanded}}" wx:for="{{group.records}}" wx:key="_id" bindtap="editMemory" data-id="{{item._id}}" aria-role="button" aria-label="编辑 {{item.dayLabel}} 的欢乐时光">
            <view class="memory-left">
              <text class="memory-heart">♥</text>
              <view class="memory-info">
                <view class="memory-date">{{item.dayLabel}}</view>
                <view wx:if="{{item.note}}" class="memory-note">{{item.note}}</view>
              </view>
            </view>
            <view class="memory-arrow">›</view>
          </view>
        </view>
      </view>

      <!-- 空态断言句只在确认没有失败时出现，与经期列表的失败语境规则一致 -->
      <view wx:elif="{{memories.length === 0 && !memoryLoading && !memoryLoadFailed}}" class="empty-state">
        <text>还没有记录\n点上面按钮新增</text>
      </view>

      <!-- 已成功加载过再失败：保留上次列表，重试留在列表区域 -->
      <view wx:if="{{memoryLoadFailed && memoryHasLoaded && !memoryLoading}}" class="list-item" bindtap="loadMemoryData" aria-role="button" aria-label="刷新失败，点按重试">
        <text class="memory-note">刷新失败，正在显示上次的内容</text>
        <view class="retry-btn">重试</view>
      </view>

      <view wx:if="{{memoryLoading}}" class="skeleton-card">
        <view class="skeleton-item" wx:for="{{[0, 1, 2]}}" wx:key="*this">
          <view class="skeleton-dot"></view>
          <view class="skeleton-body">
            <view class="skeleton-line skeleton-line-title"></view>
            <view class="skeleton-line skeleton-line-sub"></view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
