<view class="page safe-top">
  <view class="nav-bar header-gradient">
    <view class="nav-back" bindtap="goBack">‹</view>
    <view class="nav-title">经期记录</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="content">
    <view class="cycle-card fade-in">
      <text class="card-label">周期概览</text>
      <view class="cycle-stats">
        <view class="cycle-item">
          <text class="cycle-num">{{periods.length}}</text>
          <text class="cycle-label">总记录</text>
        </view>
        <view class="cycle-item">
          <text class="cycle-num">{{avgCycle || '--'}}</text>
          <text class="cycle-label">平均周期</text>
        </view>
        <view class="cycle-item">
          <text class="cycle-num">{{avgDuration || '--'}}</text>
          <text class="cycle-label">持续天数</text>
        </view>
      </view>
    </view>

    <view class="btn-premium fade-in fade-in-d1" bindtap="addPeriod">＋ 新增经期记录</view>

    <view wx:if="{{!loading}}" class="premium-card fade-in fade-in-d2">
      <view class="list-item" wx:for="{{periods}}" wx:key="_id" wx:for-index="i" bindtap="editPeriod" data-index="{{i}}" style="animation-delay:{{(i * 0.05) + 0.3}}s">
        <view class="item-left">
          <view class="item-date">{{item.startDate}} ~ {{item.endDate}}</view>
          <view wx:if="{{item.flowLabel || item.symptomText}}" class="item-tags">
            <text wx:if="{{item.flowLabel}}" class="item-tag flow">{{item.flowLabel}}</text>
            <text
              wx:for="{{item.symptomLabels}}"
              wx:for-item="tag"
              wx:key="*this"
              class="item-tag"
            >{{tag}}</text>
          </view>
          <view class="item-note">{{item.note || '无备注'}}</view>
        </view>
        <view class="item-right">
          <text class="item-duration">{{item.duration}}天</text>
          <text class="item-arrow">›</text>
        </view>
      </view>
      <view wx:if="{{periods.length === 0}}" class="empty-state">
        <text>还没有经期记录\n点上面按钮新增</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-view">
      <view class="loading-spinner"></view>
    </view>
  </view>
</view>
