@import '../../shared/confirmation-sheet.wxss';
@import '../../shared/record-form.wxss';
@import '../../shared/segmented-control.wxss';

/* ===== Aurora Bloom: Period Edit ===== */
/* 导航标题使用 pages/shared/nav-bar.wxss 的中性白。 */
.content {
  padding: var(--space-page-first-block) var(--space-page-gutter) calc(144rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  position: relative;
  z-index: 1;
}

/* Form Card */
.premium-card {
  padding: 36rpx;
  box-sizing: border-box;
}
.optional-card {
  margin-top: 20rpx;
}
.form-section-title {
  margin-bottom: 24rpx;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-title);
  color: rgba(255,255,255,0.92);
}
.record-author {
  margin-bottom: 24rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--text-secondary);
}

/* Period-specific labels, consequences and inline ownership */
.form-hint {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--text-secondary);
}
.period-length-hint,
.status-hint {
  display: block;
  margin-top: 12rpx;
}
.start-date-owner {
  margin-top: 12rpx;
}
.start-date-owner-action:active,
.start-date-owner-action.start-date-owner-action-hover {
  transform: scale(0.96);
  transition: transform var(--duration-press-in) var(--ease-out);
}

.end-date-disclosure {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows var(--duration-state) var(--ease-out);
}
.end-date-disclosure.end-date-expanded {
  grid-template-rows: 1fr;
}
.end-date-inner {
  min-height: 0;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--duration-state) var(--ease-out);
}
.end-date-disclosure.end-date-expanded .end-date-inner {
  opacity: 1;
  pointer-events: auto;
}

.symptom-group + .symptom-group {
  margin-top: 20rpx;
}
.symptom-group-label {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.status-options {
  background: rgba(10,14,39,0.88);
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.28);
}
.status-options .segment-option.disabled {
  opacity: 0.5;
  pointer-events: none;
}
.flow-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}
.symptom-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.flow-chip,
.symptom-chip {
  min-height: 88rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.72);
  background: rgba(255,255,255,0.065);
  border: 1px solid rgba(255,255,255,0.12);
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.flow-chip {
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
  padding: 12rpx 8rpx;
  border-radius: var(--radius-md);
}
.symptom-chip {
  padding: 0 24rpx;
  border-radius: var(--radius-full);
}
.flow-degree {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 8rpx;
}
.flow-degree-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: var(--radius-circle);
  background: currentColor;
}
.flow-chip::after,
.symptom-chip::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  box-shadow: 0 0 18rpx rgba(232,144,158,0.22);
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--duration-state) ease;
}
.flow-chip.active::after,
.symptom-chip.active::after {
  opacity: 1;
}
.flow-chip:active,
.flow-chip.flow-chip-hover,
.symptom-chip:active,
.symptom-chip.symptom-chip-hover {
  transform: scale(0.96);
  background: rgba(255,255,255,0.12);
  transition: background-color var(--duration-press-in) ease, transform var(--duration-press-in) var(--ease-out);
}
.flow-chip.disabled,
.symptom-chip.disabled {
  opacity: 0.5;
  pointer-events: none;
}
.flow-chip.active {
  color: var(--aurora-pink);
  background: rgba(232,144,158,0.08);
  border-color: rgba(232,144,158,0.45);
  box-shadow: none;
}
.symptom-chip.active {
  color: var(--color-memory);
  background: rgba(232,144,158,0.16);
  border-color: rgba(232,144,158,0.62);
  box-shadow: none;
}

/* 减弱动效：边框、底色与按压缩放的过渡即时切换，不做渐进
   （issue #106；DESIGN.md 动效政策——按压=即时 scale + 既有底色变化） */
@media (prefers-reduced-motion: reduce) {
  .end-date-disclosure,
  .end-date-inner,
  .flow-chip,
  .symptom-chip,
  .flow-chip::after,
  .symptom-chip::after,
  .start-date-owner-action {
    transition: none;
  }
  .start-date-owner-action:active,
  .start-date-owner-action.start-date-owner-action-hover,
  .flow-chip:active,
  .flow-chip.flow-chip-hover,
  .symptom-chip:active,
  .symptom-chip.symptom-chip-hover {
    transition: none;
  }
}
