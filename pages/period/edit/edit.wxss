/* ===== Aurora Bloom: Period Edit ===== */
.content {
  padding: 24rpx;
  position: relative;
  z-index: 1;
}

/* Form Card */
.premium-card {
  padding: 36rpx;
}

/* Form Items */
.form-item {
  margin-bottom: 36rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}
.form-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.form-label-row .form-label {
  margin-bottom: 0;
}
.form-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  font-weight: 500;
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  color: rgba(255,255,255,0.85);
  font-weight: 600;
  padding: 22rpx;
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: var(--radius-sm);
  border: 1px solid rgba(255,255,255,0.12);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
.form-picker-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
  line-height: 1;
}
.form-picker:active {
  border-color: rgba(232,144,158,0.4);
  box-shadow: 0 0 20px rgba(232,144,158,0.1);
}
.form-input {
  font-size: 32rpx;
  color: rgba(255,255,255,0.85);
  padding: 22rpx;
  background: rgba(255,255,255,0.06);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: var(--radius-sm);
  border: 1px solid rgba(255,255,255,0.12);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
.form-input:focus {
  border-color: rgba(232,144,158,0.4);
  box-shadow: 0 0 20px rgba(232,144,158,0.1);
}

.flow-options,
.symptom-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.flow-chip,
.symptom-chip {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  line-height: 1.2;
  padding: 0 28rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  font-size: 25rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.66);
  background: rgba(255,255,255,0.065);
  border: 1px solid rgba(255,255,255,0.12);
  transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
}
.flow-chip:active,
.symptom-chip:active {
  transform: scale(0.96);
  background: rgba(255,255,255,0.12);
}
.flow-chip.active,
.symptom-chip.active {
  color: #0A0E27;
  background: rgba(232,144,158,0.92);
  border-color: rgba(232,144,158,0.95);
  box-shadow: 0 0 18rpx rgba(232,144,158,0.22);
}
.symptom-chip.active {
  background: rgba(212,165,116,0.92);
  border-color: rgba(212,165,116,0.95);
  box-shadow: 0 0 18rpx rgba(212,165,116,0.2);
}

/* Buttons */
.btns {
  margin-top: 30rpx;
}
.btn-premium {
  margin-bottom: 20rpx;
}
