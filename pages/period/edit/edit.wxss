/* ===== Aurora Bloom: Period Edit ===== */
.content {
  padding: 24rpx 24rpx calc(24rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  position: relative;
  z-index: 1;
}

/* Form Card */
.premium-card {
  padding: 36rpx;
  box-sizing: border-box;
}

/* Form Items */
.form-item {
  margin-bottom: 36rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  font-size: var(--font-size-caption);
  color: rgba(255,255,255,0.6);
  display: block;
  margin-bottom: 12rpx;
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
}
.form-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.form-label-row .form-label {
  margin-bottom: 0;
}
.form-hint {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.5);
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  font-size: var(--font-size-input);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  padding: 22rpx;
  background: rgba(255,255,255,0.06), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: var(--radius-sm);
  border: 1px solid rgba(255,255,255,0.12);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
.form-picker-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
  line-height: 1;
}
.form-picker:active {
  border-color: rgba(232,144,158,0.4);
  box-shadow: 0 0 20px rgba(232,144,158,0.1);
}
.form-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  font-size: var(--font-size-input);
  font-weight: var(--font-weight-body);
  line-height: 88rpx;
  color: rgba(255,255,255,0.85);
  padding: 0 22rpx;
  background: rgba(255,255,255,0.06), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: var(--radius-sm);
  border: 1px solid rgba(255,255,255,0.12);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
.form-input:focus {
  border-color: rgba(232,144,158,0.4);
  box-shadow: 0 0 20px rgba(232,144,158,0.1);
}
.input-placeholder {
  line-height: 88rpx;
}

.symptom-group + .symptom-group {
  margin-top: 20rpx;
}
.symptom-group-label {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.5);
  margin-bottom: 12rpx;
}
.flow-options,
.symptom-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.flow-chip,
.symptom-chip {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.66);
  background: rgba(255,255,255,0.065);
  border: 1px solid rgba(255,255,255,0.12);
  transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
}
.flow-chip:active,
.symptom-chip:active {
  transform: scale(0.96);
  background: rgba(255,255,255,0.12);
}
.flow-chip.active,
.symptom-chip.active {
  color: #0A0E27;
  background: rgba(232,144,158,0.92);
  border-color: rgba(232,144,158,0.95);
  box-shadow: 0 0 18rpx rgba(232,144,158,0.22);
}

/* Buttons */
.btns {
  margin-top: 30rpx;
}
.btn-premium,
.btn-danger {
  line-height: var(--line-height-assist);
}
.btn-premium {
  margin-bottom: 20rpx;
}
