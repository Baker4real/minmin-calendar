@import '../../shared/confirmation-sheet.wxss';
@import '../../shared/record-form.wxss';

/* ===== Aurora Bloom: Period Edit ===== */
/* 导航标题使用 pages/shared/nav-bar.wxss 的中性白。 */
.content {
  padding: var(--space-page-first-block) var(--space-page-gutter) calc(144rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  position: relative;
  z-index: 1;
}

/* Form Card */
.premium-card {
  padding: 36rpx;
  box-sizing: border-box;
}
.optional-card {
  margin-top: 20rpx;
}
.form-section-title {
  margin-bottom: 24rpx;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-title);
  color: rgba(255,255,255,0.92);
}
.record-author {
  margin-bottom: 24rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--text-secondary);
}

/* Period-specific labels, consequences and inline ownership */
.form-hint {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--text-secondary);
}
.period-length-hint,
.status-hint {
  display: block;
  margin-top: 12rpx;
}
.start-date-owner {
  margin-top: 12rpx;
}
.start-date-owner-action:active,
.start-date-owner-action.start-date-owner-action-hover {
  transform: scale(0.96);
  transition: transform var(--duration-press-in) var(--ease-out);
}

.symptom-group + .symptom-group {
  margin-top: 20rpx;
}
.symptom-group-label {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.flow-options,
.symptom-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.flow-chip,
.symptom-chip {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.72);
  background: rgba(255,255,255,0.065);
  border: 1px solid rgba(255,255,255,0.12);
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.flow-chip:active,
.flow-chip.flow-chip-hover,
.symptom-chip:active,
.symptom-chip.symptom-chip-hover {
  transform: scale(0.96);
  background: rgba(255,255,255,0.12);
  transition: background-color var(--duration-press-in) ease, transform var(--duration-press-in) var(--ease-out);
}
.flow-chip.disabled,
.symptom-chip.disabled {
  opacity: 0.5;
  pointer-events: none;
}
.flow-chip.active,
.symptom-chip.active {
  color: var(--text-on-accent);
  background: rgba(232,144,158,0.92);
  border-color: rgba(232,144,158,0.95);
  box-shadow: 0 0 18rpx rgba(232,144,158,0.22);
}

/* 减弱动效：边框、底色与按压缩放的过渡即时切换，不做渐进
   （issue #106；DESIGN.md 动效政策——按压=即时 scale + 既有底色变化） */
@media (prefers-reduced-motion: reduce) {
  .flow-chip,
  .symptom-chip,
  .start-date-owner-action {
    transition: none;
  }
  .start-date-owner-action:active,
  .start-date-owner-action.start-date-owner-action-hover,
  .flow-chip:active,
  .flow-chip.flow-chip-hover,
  .symptom-chip:active,
  .symptom-chip.symptom-chip-hover {
    transition: none;
  }
}
