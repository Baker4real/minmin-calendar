<import src="/pages/shared/confirmation-sheet.wxml" />
<import src="/pages/shared/nav-bar.wxml" />
<view class="page safe-top {{pageObscured ? 'page-obscured' : ''}} {{pageHidden ? 'page-hidden' : ''}}" style="--safe-top: {{safeTop}}px; --safe-bottom: {{safeBottom}}px; --nav-bar-height: {{navBarHeight}}px; --capsule-right: {{capsuleRight}}px">
  <wxs module="sheetDrag" src="../../../utils/sheetDrag.wxs"></wxs>
  <include src="/pages/shared/aurora.wxml" />
  <template is="sharedNavbar" data="{{variant: 'back', title: pageTitle, pageObscured: pageObscured}}" />

  <view class="content" aria-hidden="{{pageObscured}}">
    <view class="premium-card">
      <view wx:if="{{authorLabel}}" class="record-author">{{authorLabel}}</view>
      <view wx:if="{{draftRestored}}" class="draft-notice" aria-role="alert">
        <text>{{draftNoticeText}} · </text>
        <text class="draft-discard" hover-class="draft-discard-hover" bindtap="discardDraft" aria-role="button" aria-label="{{draftDiscardText}}">{{draftDiscardText}}</text>
      </view>
      <view class="form-item" id="field-startDate">
        <text class="form-label">开始日期</text>
        <picker mode="date" value="{{startDate}}" end="{{maxDate}}" disabled="{{saving}}" bindchange="onStartChange" aria-role="button" aria-disabled="{{saving}}" aria-label="开始日期，{{startDateLabel}}，点按修改{{fieldErrors.startDate ? '，' + fieldErrors.startDate : ''}}">
          <view class="form-picker{{saving ? ' disabled' : ''}}" hover-class="form-picker-hover">
            <text>{{startDateLabel}}</text>
            <text class="form-picker-arrow">›</text>
          </view>
        </picker>
        <text wx:if="{{fieldErrors.startDate}}" class="field-error" aria-role="alert">{{fieldErrors.startDate}}</text>
        <view wx:if="{{startDateOwnerText}}" class="form-hint start-date-owner">
          <text>{{startDateOwnerText}}</text>
          <text class="start-date-owner-action" hover-class="start-date-owner-action-hover" bindtap="openStartDateOwner" aria-role="button" aria-label="打开那条">打开那条</text>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">经期状态</text>
        <view class="flow-options" aria-role="radiogroup" aria-label="经期状态">
          <view
            wx:for="{{statusOptions}}"
            wx:key="value"
            class="flow-chip {{status === item.value ? 'active' : ''}}{{saving ? ' disabled' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectStatus"
            aria-role="radio"
            aria-label="经期状态 {{item.label}}，{{item.hint}}"
            aria-checked="{{status === item.value}}"
            aria-disabled="{{saving}}" hover-class="flow-chip-hover">{{item.label}}</view>
        </view>
        <text class="form-hint status-hint" aria-role="status">{{statusHint}}</text>
      </view>
      <view class="form-item" wx:if="{{status === 'known-end'}}" id="field-endDate">
        <text class="form-label">结束日期</text>
        <picker mode="date" value="{{endDate}}" start="{{startDate}}" end="{{maxDate}}" disabled="{{saving}}" bindchange="onEndChange" aria-role="button" aria-disabled="{{saving}}" aria-label="结束日期，{{endDate ? endDateLabel + '，点按修改' : '还没选，点按选择'}}{{fieldErrors.endDate ? '，' + fieldErrors.endDate : ''}}">
          <view class="form-picker{{saving ? ' disabled' : ''}}" hover-class="form-picker-hover">
            <text class="{{endDate ? '' : 'input-placeholder'}}">{{endDate ? endDateLabel : '选择结束日期'}}</text>
            <text class="form-picker-arrow">›</text>
          </view>
        </picker>
        <text wx:if="{{fieldErrors.endDate}}" class="field-error" aria-role="alert">{{fieldErrors.endDate}}</text>
        <text wx:if="{{periodDayCountText}}" class="form-hint period-length-hint">{{periodDayCountText}}</text>
        <text wx:if="{{periodLengthHint}}" class="form-hint period-length-hint">{{periodLengthHint}}</text>
      </view>
    </view>
    <view class="premium-card optional-card">
      <view class="form-section-title">选填</view>
      <view class="form-item">
        <view class="form-label-row">
          <text class="form-label">经量</text>
          <text class="form-hint">再点可取消</text>
        </view>
        <view class="flow-options">
          <view
            wx:for="{{flowOptions}}"
            wx:key="value"
            class="flow-chip {{flow === item.value ? 'active' : ''}}{{saving ? ' disabled' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectFlow"
            aria-role="checkbox"
            aria-label="经量 {{item.label}}，单选，再点取消"
            aria-checked="{{flow === item.value}}"
            aria-disabled="{{saving}}" hover-class="flow-chip-hover">{{item.label}}</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label-row">
          <text class="form-label">症状</text>
          <text class="form-hint">可多选</text>
        </view>
        <view
          wx:for="{{symptomGroups}}"
          wx:key="key"
          wx:for-item="group"
          class="symptom-group"
        >
          <text class="symptom-group-label">{{group.label}}</text>
          <view class="symptom-options">
            <view
              wx:for="{{group.options}}"
              wx:key="value"
              class="symptom-chip {{selectedSymptoms[item.value] ? 'active' : ''}}{{saving ? ' disabled' : ''}}"
              data-value="{{item.value}}"
              bindtap="toggleSymptom"
              aria-role="checkbox"
              aria-label="症状 {{item.label}}"
              aria-checked="{{selectedSymptoms[item.value]}}"
              aria-disabled="{{saving}}" hover-class="symptom-chip-hover">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">备注</text>
        <textarea class="form-input" placeholder-class="input-placeholder" placeholder="补充一点实际情况" value="{{note}}" bindinput="onNoteInput" maxlength="500" auto-height disabled="{{saving}}" aria-label="备注"/>
      </view>
    </view>

    <view class="btns">
      <view wx:if="{{!saving && !deleting && !submitted}}" class="btn-premium" bindtap="save" aria-role="button" aria-label="保存" hover-class="btn-premium-hover">保存</view>
      <view wx:elif="{{saving}}" class="btn-premium loading" aria-role="button" aria-disabled="true">保存中...</view>
      <view wx:else class="btn-premium disabled" aria-role="button" aria-disabled="true">保存</view>
    </view>
    <view wx:if="{{isEdit}}" class="delete-zone">
      <view wx:if="{{isEdit && !deleting && !saving && !submitted}}" class="btn-danger" hover-class="btn-danger-hover" bindtap="delete" aria-role="button" aria-label="删除此记录">删除此记录</view>
      <view wx:elif="{{isEdit && deleting}}" class="btn-danger loading" aria-role="button" aria-disabled="true">删除中...</view>
      <view wx:elif="{{isEdit}}" class="btn-danger disabled" aria-role="button" aria-disabled="true">删除此记录</view>
    </view>
  </view>
  <template is="confirmationSheet" data="{{confirmationName: confirmationName, confirmationTitle: confirmationTitle, confirmationDateText: confirmationDateText, confirmationContent: confirmationContent, confirmationActions: confirmationActions, confirmationMounted: confirmationMounted, confirmationPhase: confirmationPhase, confirmationDragClear: confirmationDragClear, sheetExitGuard: sheetExitGuard}}" />
</view>
