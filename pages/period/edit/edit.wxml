<view class="page safe-top" style="--safe-top: {{safeTop}}px; --safe-bottom: {{safeBottom}}px; --nav-bar-height: {{navBarHeight}}px; --capsule-right: {{capsuleRight}}px">
  <view class="nav-bar header-gradient">
    <view class="nav-back" hover-class="nav-back-hover" bindtap="goBack" aria-role="button" aria-label="返回">
      <view class="nav-back-surface"></view>
      <text class="nav-back-icon">‹</text>
    </view>
    <view wx:if="{{isEdit}}" class="nav-title">编辑经期</view>
    <view wx:else class="nav-title">新增经期</view>
  </view>

  <view class="content">
    <view class="premium-card">
      <view wx:if="{{draftRestored}}" class="draft-notice">已恢复上次未完成的输入</view>
      <view class="form-item">
        <text class="form-label">开始日期</text>
        <picker mode="date" value="{{startDate}}" end="{{maxDate}}" disabled="{{saving}}" bindchange="onStartChange" aria-role="button" aria-label="选择开始日期">
          <view class="form-picker" hover-class="form-picker-hover">
            <text>{{startDateLabel}}</text>
            <text class="form-picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <view class="form-label-row">
          <text class="form-label">经期状态</text>
          <text class="form-hint">{{statusHint}}</text>
        </view>
        <view class="flow-options">
          <view
            wx:for="{{statusOptions}}"
            wx:key="value"
            class="flow-chip {{status === item.value ? 'active' : ''}}{{saving ? ' disabled' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectStatus"
            aria-role="radio"
            aria-label="经期状态 {{item.label}}"
            aria-checked="{{status === item.value}}"
            aria-disabled="{{saving}}" hover-class="flow-chip-hover">{{item.label}}</view>
        </view>
      </view>
      <view class="form-item" wx:if="{{status === 'known-end'}}">
        <text class="form-label">结束日期</text>
        <picker mode="date" value="{{endDate}}" start="{{startDate}}" end="{{maxDate}}" disabled="{{saving}}" bindchange="onEndChange" aria-role="button" aria-label="选择结束日期">
          <view class="form-picker" hover-class="form-picker-hover">
            <text>{{endDateLabel}}</text>
            <text class="form-picker-arrow">›</text>
          </view>
        </picker>
        <text wx:if="{{periodDayCountText}}" class="form-hint period-length-hint">{{periodDayCountText}}</text>
        <text wx:if="{{periodLengthHint}}" class="form-hint period-length-hint">{{periodLengthHint}}</text>
      </view>
      <view class="form-item">
        <view class="form-label-row">
          <text class="form-label">经量</text>
          <text class="form-hint">再点可取消</text>
        </view>
        <view class="flow-options">
          <view
            wx:for="{{flowOptions}}"
            wx:key="value"
            class="flow-chip {{flow === item.value ? 'active' : ''}}{{saving ? ' disabled' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectFlow"
            aria-role="checkbox"
            aria-label="经量 {{item.label}}"
            aria-checked="{{flow === item.value}}"
            aria-disabled="{{saving}}" hover-class="flow-chip-hover">{{item.label}}</view>
        </view>
      </view>
      <view class="form-item">
        <view class="form-label-row">
          <text class="form-label">症状</text>
          <text class="form-hint">可多选</text>
        </view>
        <view
          wx:for="{{symptomGroups}}"
          wx:key="key"
          wx:for-item="group"
          class="symptom-group"
        >
          <text class="symptom-group-label">{{group.label}}</text>
          <view class="symptom-options">
            <view
              wx:for="{{group.options}}"
              wx:key="value"
              class="symptom-chip {{item.selected ? 'active' : ''}}{{saving ? ' disabled' : ''}}"
              data-value="{{item.value}}"
              bindtap="toggleSymptom"
              aria-role="checkbox"
              aria-label="症状 {{item.label}}"
              aria-checked="{{item.selected}}"
              aria-disabled="{{saving}}" hover-class="symptom-chip-hover">{{item.label}}</view>
          </view>
        </view>
      </view>
      <view class="form-item form-item-last">
        <text class="form-label">备注</text>
        <textarea class="form-input" placeholder-class="input-placeholder" placeholder="补充一点实际情况" value="{{note}}" bindinput="onNoteInput" maxlength="500" auto-height disabled="{{saving}}" aria-label="备注"/>
      </view>
    </view>

    <view class="btns">
      <view wx:if="{{!saving && !deleting && !submitted}}" class="btn-premium" bindtap="save" aria-role="button" aria-label="保存" hover-class="btn-premium-hover">保存</view>
      <view wx:elif="{{saving}}" class="btn-premium loading" aria-role="button" aria-disabled="true">保存中...</view>
      <view wx:else class="btn-premium disabled" aria-role="button" aria-disabled="true">保存</view>
    </view>
    <view wx:if="{{isEdit}}" class="delete-zone">
      <view wx:if="{{isEdit && !deleting && !saving && !submitted}}" class="btn-danger" hover-class="btn-danger-hover" bindtap="delete" aria-role="button" aria-label="删除此记录">删除此记录</view>
      <view wx:elif="{{isEdit && deleting}}" class="btn-danger" style="opacity: 0.5;" aria-role="button" aria-disabled="true">删除中...</view>
      <view wx:elif="{{isEdit}}" class="btn-danger" style="opacity: 0.5;" aria-role="button" aria-disabled="true">删除此记录</view>
    </view>
  </view>
</view>
