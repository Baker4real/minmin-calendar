<import src="/pages/shared/confirmation-sheet.wxml" />
<import src="/pages/shared/nav-bar.wxml" />
<import src="/pages/shared/form-controls.wxml" />
<view class="page safe-top {{pageObscured ? 'page-obscured' : ''}} {{pageHidden ? 'page-hidden' : ''}}" style="--safe-top: {{safeTop}}px; --safe-bottom: {{safeBottom}}px; --nav-bar-height: {{navBarHeight}}px; --capsule-right: {{capsuleRight}}px">
  <wxs module="sheetDrag" src="../../../utils/sheetDrag.wxs"></wxs>
  <include src="/pages/shared/aurora.wxml" />
  <template is="sharedNavbar" data="{{variant: 'back', title: pageTitle, pageObscured: pageObscured}}" />

  <view class="content" aria-hidden="{{pageObscured}}">
    <view class="premium-card glass-surface">
      <view wx:if="{{authorLabel}}" class="record-author">{{authorLabel}}</view>
      <view wx:if="{{draftRestored}}" class="draft-notice" aria-role="alert">
        <text>{{draftNoticeText}} · </text>
        <text class="draft-discard" hover-class="draft-discard-hover" bindtap="discardDraft" aria-role="button" aria-label="{{draftDiscardText}}">{{draftDiscardText}}</text>
      </view>
      <view class="form-item" id="field-startDate">
        <template is="sharedDateField" data="{{label: '开始日期', value: startDate, displayValue: startDateLabel, placeholder: '', ariaLabel: '开始日期，' + startDateLabel + '，点按修改', error: fieldErrors.startDate, maxDate: maxDate, saving: saving, changeHandler: 'onStartChange'}}" />
        <view wx:if="{{startDateOwnerText}}" class="form-hint start-date-owner">
          <text>{{startDateOwnerText}}</text>
          <text class="start-date-owner-action" hover-class="start-date-owner-action-hover" bindtap="openStartDateOwner" aria-role="button" aria-label="打开那条">打开那条</text>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">经期状态</text>
        <view class="flow-options" aria-role="radiogroup" aria-label="经期状态">
          <template is="sharedChoiceChip" wx:for="{{statusOptions}}" wx:key="value" data="{{item: item, chipClass: 'flow-chip', checked: status === item.value, saving: saving, tapHandler: 'selectStatus', role: 'radio', ariaLabel: '经期状态 ' + item.label + '，' + item.hint}}" />
        </view>
        <text class="form-hint status-hint" aria-role="status">{{statusHint}}</text>
      </view>
      <view class="form-item" wx:if="{{status === 'known-end'}}" id="field-endDate">
        <template is="sharedDateField" data="{{label: '结束日期', value: endDate, displayValue: endDateLabel, placeholder: '选择结束日期', ariaLabel: endDate ? '结束日期，' + endDateLabel + '，点按修改' : '结束日期，还没选，点按选择', error: fieldErrors.endDate, startDate: startDate, maxDate: maxDate, saving: saving, changeHandler: 'onEndChange'}}" />
        <text wx:if="{{periodDayCountText}}" class="form-hint period-length-hint">{{periodDayCountText}}</text>
        <text wx:if="{{periodLengthHint}}" class="form-hint period-length-hint">{{periodLengthHint}}</text>
      </view>
    </view>
    <view class="premium-card glass-surface optional-card">
      <view class="form-section-title">选填</view>
      <view class="form-item">
        <view class="form-label-row">
          <text class="form-label">经量</text>
          <text class="form-hint">再点可取消</text>
        </view>
        <view class="flow-options">
          <template is="sharedChoiceChip" wx:for="{{flowOptions}}" wx:key="value" data="{{item: item, chipClass: 'flow-chip', checked: flow === item.value, saving: saving, tapHandler: 'selectFlow', role: 'checkbox', ariaLabel: '经量 ' + item.label + '，单选，再点取消'}}" />
        </view>
      </view>
      <view class="form-item">
        <view class="form-label-row">
          <text class="form-label">症状</text>
          <text class="form-hint">可多选</text>
        </view>
        <view
          wx:for="{{symptomGroups}}"
          wx:key="key"
          wx:for-item="group"
          class="symptom-group"
        >
          <text class="symptom-group-label">{{group.label}}</text>
          <view class="symptom-options">
            <template is="sharedChoiceChip" wx:for="{{group.options}}" wx:key="value" data="{{item: item, chipClass: 'symptom-chip', checked: selectedSymptoms[item.value], saving: saving, tapHandler: 'toggleSymptom', role: 'checkbox', ariaLabel: '症状 ' + item.label}}" />
          </view>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">备注</text>
        <textarea class="form-input form-control" placeholder-class="input-placeholder" placeholder="补充一点实际情况" value="{{note}}" bindinput="onNoteInput" maxlength="500" auto-height disabled="{{saving}}" aria-label="备注"/>
      </view>
    </view>

    <template is="sharedRecordActions" data="{{saving: saving, deleting: deleting, submitted: submitted, isEdit: isEdit}}" />
  </view>
  <template is="sharedBottomSheet" data="{{sheetId: 'confirmation', sheetMounted: confirmationMounted, sheetPhase: confirmationPhase, sheetHostClass: '', sheetPanelClass: 'confirmation-panel', sheetName: confirmationName, sheetTitle: confirmationTitle, sheetSubtitle: '', maskHandler: 'onConfirmationMask', closeHandler: 'onConfirmationClose', bodyTemplate: 'confirmationSheetBody', sheetDragClear: confirmationDragClear, body: {confirmationDateText: confirmationDateText, confirmationContent: confirmationContent, confirmationActions: confirmationActions}}}" />
  <template is="sharedSheetPage" data="{{sheetExitGuard: sheetExitGuard}}" />
</view>
