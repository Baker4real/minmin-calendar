<view class="page safe-top" style="--safe-top: {{safeTop}}px">
  <view class="nav-bar header-gradient">
    <view class="nav-back" bindtap="goBack">
      <view class="nav-back-surface"></view>
      <text class="nav-back-icon">‹</text>
    </view>
    <view wx:if="{{isEdit}}" class="nav-title">编辑经期</view>
    <view wx:else class="nav-title">新增经期</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="content">
    <view class="premium-card">
      <view class="form-item">
        <text class="form-label">开始日期</text>
        <picker mode="date" value="{{startDate}}" end="{{endDate}}" bindchange="onStartChange">
          <view class="form-picker">
            <text>{{startDate}}</text>
            <text class="form-picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">结束日期</text>
        <picker mode="date" value="{{endDate}}" start="{{startDate}}" bindchange="onEndChange">
          <view class="form-picker">
            <text>{{endDate}}</text>
            <text class="form-picker-arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder-class="input-placeholder" placeholder="补充一点实际情况" value="{{note}}" bindinput="onNoteInput" maxlength="500"/>
      </view>
      <view class="form-item">
        <view class="form-label-row">
          <text class="form-label">经量</text>
          <text class="form-hint">再点可取消</text>
        </view>
        <view class="flow-options">
          <view
            wx:for="{{flowOptions}}"
            wx:key="value"
            class="flow-chip {{flow === item.value ? 'active' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectFlow"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="form-item form-item-last">
        <view class="form-label-row">
          <text class="form-label">症状</text>
          <text class="form-hint">可多选</text>
        </view>
        <view
          wx:for="{{symptomGroups}}"
          wx:key="key"
          wx:for-item="group"
          class="symptom-group"
        >
          <text class="symptom-group-label">{{group.label}}</text>
          <view class="symptom-options">
            <view
              wx:for="{{group.options}}"
              wx:key="value"
              class="symptom-chip {{item.selected ? 'active' : ''}}"
              data-value="{{item.value}}"
              bindtap="toggleSymptom"
            >{{item.label}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="btns">
      <view wx:if="{{!saving && !deleting}}" class="btn-premium" bindtap="save">保存</view>
      <view wx:elif="{{saving}}" class="btn-premium loading">保存中...</view>
      <view wx:else class="btn-premium disabled">保存</view>
      <view wx:if="{{isEdit && !deleting}}" class="btn-danger" bindtap="delete">删除此记录</view>
      <view wx:elif="{{isEdit}}" class="btn-danger" style="opacity: 0.5;">删除中...</view>
    </view>
  </view>
</view>
