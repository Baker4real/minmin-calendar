<view class="page safe-top">
  <view class="nav-bar header-gradient">
    <view class="nav-back" bindtap="goBack">‹</view>
    <view wx:if="{{isEdit}}" class="nav-title">编辑经期</view>
    <view wx:else class="nav-title">新增经期</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="content">
    <view class="premium-card fade-in">
      <view class="form-item">
        <text class="form-label">开始日期</text>
        <picker mode="date" value="{{startDate}}" bindchange="onStartChange">
          <view class="form-picker">{{startDate}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">结束日期</text>
        <picker mode="date" value="{{endDate}}" bindchange="onEndChange">
          <view class="form-picker">{{endDate}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="补充一点实际情况" value="{{note}}" bindinput="onNoteInput"/>
      </view>
      <view class="form-item">
        <text class="form-label">经量</text>
        <view class="flow-options">
          <view
            wx:for="{{flowOptions}}"
            wx:key="value"
            class="flow-chip {{flow === item.value ? 'active' : ''}}"
            data-value="{{item.value}}"
            bindtap="selectFlow"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="form-item form-item-last">
        <text class="form-label">身体状态</text>
        <view class="symptom-options">
          <view
            wx:for="{{symptomOptions}}"
            wx:key="value"
            class="symptom-chip {{item.selected ? 'active' : ''}}"
            data-value="{{item.value}}"
            bindtap="toggleSymptom"
          >{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="btns fade-in fade-in-d1">
      <view wx:if="{{!saving}}" class="btn-premium" bindtap="save">保存</view>
      <view wx:else class="btn-premium loading">保存中...</view>
      <view wx:if="{{isEdit}}" class="btn-danger" bindtap="delete">删除此记录</view>
    </view>
  </view>
</view>
