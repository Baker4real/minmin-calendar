/* ===== Aurora Bloom: Settings ===== */
/* 第一组离顶栏 24rpx，与记录页、编辑页的首块顶距同一角色（issue #164） */
.content {
  padding: 24rpx 24rpx 30rpx;
  position: relative;
  z-index: 1;
}

.settings-group {
  margin-bottom: 28rpx;
}
.settings-group-title {
  display: block;
  padding: 8rpx 8rpx 12rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.92);
}
/* 危险区与上面的常规分组拉开一档：相邻外边距合并取大值，必须大于分组的 28rpx 才有效（issue #164） */
.settings-danger-zone {
  margin-top: var(--space-lg);
}
.premium-card {
  margin-bottom: 0;
}

/* Menu Items */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:not(.non-interactive):not(.danger):active,
.menu-item:not(.non-interactive):not(.danger).menu-item-hover {
  background: rgba(255,255,255,0.05);
}
.menu-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  color: rgba(255,255,255,0.85);
}
.menu-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}
.settings-version {
  flex-shrink: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  color: rgba(255,255,255,0.85);
}
/* 使用说明弹层（issue #154）：进出与首页底部弹层同一套。宿主只负责铺满与叠层，自己不是关闭控件；
   遮罩只动透明度（按压着色在 ::after 上，同首页），面板 translateY(100%) 升降，离场时两者都不拦截点按。
   遮罩和首页弹层遮罩同一种材质：88% 海军加 blur(8px)，把帮助面板和后面的页面分开（issue #163）。 */
.help-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  pointer-events: none;
}
.help-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: auto;
  background: rgba(10,14,39,0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  opacity: 0;
  transition: opacity var(--duration-exit) var(--ease-out);
}
.help-mask::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(10,14,39,0);
  transition: background-color var(--duration-press) ease;
  pointer-events: none;
}
.help-mask:active::after,
.help-mask.help-mask-hover::after {
  background-color: rgba(10,14,39,0.28);
}
.help-mask.sheet-open {
  opacity: 1;
  transition: opacity var(--duration-enter) var(--ease-out);
}
.help-mask.sheet-leaving,
.help-slide.sheet-leaving {
  pointer-events: none;
}
.help-slide {
  position: relative;
  z-index: 1;
  width: 100%;
  pointer-events: auto;
  transform: translateY(100%);
  transition: transform var(--duration-exit) var(--ease-out);
}
.help-slide.sheet-open {
  transform: translateY(0);
  transition: transform var(--duration-sheet) var(--ease-out);
}
/* 标题与内容错相（issue #166），同首页弹层：说明文字 .sheet-body 晚一拍跟上，规则在 app.wxss「弹层内容块」 */
.help-sheet {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  box-sizing: border-box;
  margin: 0;
  padding: 32rpx 32rpx calc(32rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  border-radius: var(--radius-card) var(--radius-card) 0 0;
}
.help-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.help-title {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-title);
  color: rgba(255,255,255,0.92);
}
/* 可见关闭键与首页弹层 .sheet-close 同款：88rpx 圆钮、×、按压 0.96 */
.sheet-close {
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--radius-circle);
  font-size: 46rpx;
  color: rgba(255,255,255,0.92);
  background: var(--glass-bg);
  border: 1px solid rgba(255,255,255,0.12);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.sheet-close:active,
.sheet-close.sheet-close-hover {
  transform: scale(0.96);
  background: rgba(255,255,255,0.14);
}
.help-copy {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
}

/* 导航标题不可点：中性文字色（共享基类在 app.wxss，页面侧覆盖颜色，issue #77） */
.nav-title {
  color: rgba(255,255,255,0.92);
}

/* 页底危险区：解除绑定在点之前就是危险样式（issue #77 / #139）——警告红字 + 警告红描边，
   与 .btn-danger 同族同红，不是第二种红；导出保持上面的普通行 */
.menu-item.danger {
  position: relative;
  z-index: 0;
  margin: 0;
  border: 1px solid rgba(249,115,115,0.28);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  background: var(--glass-fallback);
  transition: border-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.menu-item.danger::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: var(--radius-md);
  background-color: var(--glass-bg);
  transition: background-color var(--duration-press) ease;
  pointer-events: none;
  z-index: -1;
}
.menu-item.danger .menu-text {
  color: #F97373;
}
/* 平涂层盖不到描边带：按下时描边同色提亮，和红色平涂层一起亮（issue #166） */
.menu-item.danger:active,
.menu-item.danger.danger-hover {
  transform: scale(0.95);
  border-color: rgba(249,115,115,0.4);
}
.menu-item.danger:active::before,
.menu-item.danger.danger-hover::before {
  background-color: rgba(249,115,115,0.12);
}

/* Room Code Item */
.room-code-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.room-code-label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
}
.room-code-value {
  font-size: 36rpx;
  font-weight: var(--font-weight-control);
  letter-spacing: var(--letter-spacing-room-code);
  text-indent: var(--letter-spacing-room-code);
  margin-top: 4rpx;
  line-height: var(--line-height-assist);
  color: #E8909E;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}
.room-code-value.muted {
  color: var(--text-secondary);
  font-weight: var(--font-weight-body);
  letter-spacing: 0;
  text-indent: 0;
}

/* Copy Button — 实色玫瑰 */
.copy-btn {
  flex-shrink: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
  background: var(--aurora-pink);
  color: #0A0E27;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  position: relative;
  transition: transform var(--duration-press) var(--ease-out);
}
/* 柔光层同 .btn-premium（issue #166）：按下沉到 0.5，和缩放同一拍 */
.copy-btn::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: var(--radius-sm);
  box-shadow: 0 4px 15px rgba(232,144,158,0.28);
  transition: opacity var(--duration-press) ease;
  pointer-events: none;
}
.copy-btn:active,
.copy-btn.copy-btn-hover {
  transform: scale(0.94);
}
.copy-btn:active::before,
.copy-btn.copy-btn-hover::before {
  opacity: 0.5;
}

/* 拿不到房间码时的下一步操作（issue #79）：重试/去绑定。
   弱态玫瑰描边按钮（与密度选项同族的弱选中态），不做第二颗实色主按钮；
   88rpx 触控高度，不加阴影（本文件阴影预算已满）。 */
.room-code-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 30rpx 28rpx;
}
.room-action-btn {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  color: #E8909E;
  background: rgba(232,144,158,0.08);
  border: 1px solid rgba(232,144,158,0.45);
  transition: transform var(--duration-press) var(--ease-out), background-color var(--duration-press) ease;
}
.room-action-btn:active,
.room-action-btn.room-action-btn-hover {
  transform: scale(0.95);
  background: rgba(232,144,158,0.14);
}

/* Calendar Density Preference — 首页日历密度的设置入口（issue #55 迁入） */
.density-menu-desc {
  display: block;
  padding: 28rpx 30rpx 8rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
}
.density-control {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin: 0 30rpx 28rpx;
  box-sizing: border-box;
}
.density-option {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  color: rgba(255,255,255,0.68);
  border: 1px solid transparent;
  transition: background-color var(--duration-press) ease, color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.density-option:active,
.density-option.density-option-hover {
  transform: scale(0.98);
  background: rgba(255,255,255,0.1);
}
/* 密度偏好是弱态设置：选中项用玫瑰描边+玫瑰字，不用主操作的实色填充 */
.density-option.active {
  color: #E8909E;
  background: rgba(232,144,158,0.08);
  border-color: rgba(232,144,158,0.45);
  box-shadow: none;
}
/* 减弱动效探针（同首页）：逻辑层读它的宽度，决定帮助弹层藏起与恢复 tabBar 时是否播动画 */
.reduced-motion-probe {
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
  pointer-events: none;
}
@media (prefers-reduced-motion: reduce) {
  .reduced-motion-probe {
    width: 1px;
  }
  .copy-btn,
  .copy-btn::before,
  .density-option,
  .room-action-btn,
  .menu-item.danger,
  .menu-item.danger::before,
  .help-mask,
  .help-mask::after,
  .help-mask.sheet-open,
  .help-slide,
  .help-slide.sheet-open,
  .sheet-close {
    animation: none;
    transition: none;
  }
}
