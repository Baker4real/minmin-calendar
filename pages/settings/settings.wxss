/* ===== Aurora Bloom: Settings ===== */
.content {
  padding: 0 24rpx 30rpx;
  position: relative;
  z-index: 1;
}

/* Profile Card */
.profile-card {
  padding: 40rpx;
  text-align: center;
  margin: 24rpx 0;
}
.profile-avatar {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 0 20px rgba(232,144,158,0.3));
}
.profile-name {
  font-size: 34rpx;
  font-weight: 800;
  color: rgba(255,255,255,0.9);
}
.profile-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 8rpx;
  display: block;
}

.premium-card {
  margin-bottom: 20rpx;
}

/* Menu Items */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color 0.3s ease, transform 0.3s ease;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: rgba(255,255,255,0.05);
}
.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}
.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  font-weight: 500;
}
.menu-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

/* Room Code Item */
.room-code-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.room-code-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
}
.room-code-value {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  margin-top: 4rpx;
  color: #E8909E;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}
.room-code-value.muted {
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0;
  text-indent: 0;
}

/* Copy Button — 实色玫瑰 */
.copy-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #E8909E;
  color: #0A0E27;
  padding: 0 28rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4px 15px rgba(232,144,158,0.28);
  transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
}
.copy-btn:active {
  transform: scale(0.94);
}
