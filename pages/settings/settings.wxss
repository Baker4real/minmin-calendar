/* ===== Aurora Bloom: Settings ===== */
.content {
  padding: 0 24rpx 30rpx;
  position: relative;
  z-index: 1;
}

/* Profile Card */
.profile-card {
  padding: 40rpx;
  text-align: center;
  margin: 24rpx 0;
}
.profile-avatar {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 0 20px rgba(232,144,158,0.3));
}
.profile-name {
  font-size: var(--font-size-title);
  font-weight: 800;
  color: rgba(255,255,255,0.9);
}
.profile-desc {
  font-size: var(--font-size-caption);
  line-height: 1.4;
  color: rgba(255,255,255,0.5);
  margin-top: 8rpx;
  display: block;
}

.premium-card {
  margin-bottom: 20rpx;
}

/* Menu Items */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color 0.3s ease, transform 0.3s ease;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:active {
  background: rgba(255,255,255,0.05);
}
.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}
.menu-text {
  flex: 1;
  font-size: var(--font-size-body);
  color: rgba(255,255,255,0.85);
  font-weight: 500;
}
.menu-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

/* Room Code Item */
.room-code-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.room-code-label {
  font-size: var(--font-size-caption);
  line-height: 1.4;
  color: rgba(255,255,255,0.5);
}
.room-code-value {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
  margin-top: 4rpx;
  color: #E8909E;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}
.room-code-value.muted {
  color: var(--text-secondary);
  font-weight: 400;
  letter-spacing: 0;
  text-indent: 0;
}

/* Copy Button — 实色玫瑰 */
.copy-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--aurora-pink);
  color: #0A0E27;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-caption);
  font-weight: 600;
  box-shadow: 0 4px 15px rgba(232,144,158,0.28);
  transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
}
.copy-btn:active {
  transform: scale(0.94);
}

/* Calendar Density Preference — 首页日历密度的设置入口（issue #55 迁入） */
.density-menu-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.density-menu-desc {
  font-size: var(--font-size-caption);
  line-height: 1.4;
  color: rgba(255,255,255,0.5);
}
.density-control {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin: 0 30rpx 28rpx;
  padding: 4rpx;
  box-sizing: border-box;
  border-radius: var(--radius-card);
  background: rgba(255,255,255,0.055);
  border: 1px solid rgba(255,255,255,0.11);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.09);
}
.density-option {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: 800;
  color: rgba(255,255,255,0.68);
  border: 1px solid transparent;
  transition: background-color 0.22s ease, color 0.22s ease, transform 0.22s ease;
}
.density-option:active {
  transform: scale(0.98);
  background: rgba(255,255,255,0.1);
}
/* 密度偏好是弱态设置：选中项用玫瑰描边+玫瑰字，不用主操作的实色填充 */
.density-option.active {
  color: #E8909E;
  background: rgba(232,144,158,0.08);
  border-color: rgba(232,144,158,0.45);
  box-shadow: none;
}
@media (prefers-reduced-motion: reduce) {
  .density-option {
    animation: none;
    transition: none;
  }
}
