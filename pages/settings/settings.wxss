/* ===== Aurora Bloom: Settings ===== */
.content {
  padding: 0 24rpx 30rpx;
  position: relative;
  z-index: 1;
}

/* Profile Card */
.profile-card {
  padding: 40rpx;
  text-align: center;
  margin: 24rpx 0;
}
.profile-avatar {
  font-size: 72rpx;
  /* 品牌心：玫瑰文本字形，不再用红色心形表情（issue #77） */
  color: #E8909E;
  margin-bottom: 16rpx;
  filter: drop-shadow(0 0 20px rgba(232,144,158,0.3));
}
.profile-name {
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-title);
  color: rgba(255,255,255,0.9);
}
.profile-desc {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.78);
  margin-top: 8rpx;
  display: block;
}
.premium-card {
  margin-bottom: 20rpx;
}

/* Menu Items */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:not(.non-interactive):active {
  background: rgba(255,255,255,0.05);
}
.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}
.menu-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  color: rgba(255,255,255,0.85);
}
.menu-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

/* 导航标题不可点：中性文字色（共享基类在 app.wxss，页面侧覆盖颜色，issue #77） */
.nav-title {
  color: rgba(255,255,255,0.92);
}

/* 欢乐时光入口的浅色心 = 日历欢乐时光标记色（issue #77） */
.menu-heart {
  color: #F0C4C0;
}

/* 清除本地数据：点之前就是危险样式（issue #77）——警告红字 + 警告红描边，
   与 .btn-danger 同族同红，不是第二种红；导出保持上面的普通行 */
.menu-item.danger {
  margin: 20rpx 20rpx 24rpx;
  border: 1px solid rgba(249,115,115,0.28);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
}
.menu-item.danger .menu-text {
  color: #F97373;
}
.menu-item.danger:active {
  background: linear-gradient(rgba(249,115,115,0.12), rgba(249,115,115,0.12)), var(--glass-fallback);
  transform: scale(0.95);
}

/* Room Code Item */
.room-code-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.room-code-label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
}
.room-code-value {
  font-size: 36rpx;
  font-weight: var(--font-weight-control);
  letter-spacing: var(--letter-spacing-room-code);
  text-indent: var(--letter-spacing-room-code);
  margin-top: 4rpx;
  line-height: var(--line-height-assist);
  color: #E8909E;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}
.room-code-value.muted {
  color: var(--text-secondary);
  font-weight: var(--font-weight-body);
  letter-spacing: 0;
  text-indent: 0;
}

/* Copy Button — 实色玫瑰 */
.copy-btn {
  flex-shrink: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
  background: var(--aurora-pink);
  color: #0A0E27;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  box-shadow: 0 4px 15px rgba(232,144,158,0.28);
  transition: transform var(--duration-press) var(--ease-out);
}
.copy-btn:active {
  transform: scale(0.94);
}

/* 拿不到房间码时的下一步操作（issue #79）：重试/去绑定。
   弱态玫瑰描边按钮（与密度选项同族的弱选中态），不做第二颗实色主按钮；
   88rpx 触控高度，不加阴影（本文件阴影预算已满）。 */
.room-code-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 30rpx 28rpx;
}
.room-action-btn {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  color: #E8909E;
  background: rgba(232,144,158,0.08);
  border: 1px solid rgba(232,144,158,0.45);
  transition: transform var(--duration-press) var(--ease-out), background-color var(--duration-press) ease;
}
.room-action-btn:active {
  transform: scale(0.95);
  background: rgba(232,144,158,0.14);
}

/* Calendar Density Preference — 首页日历密度的设置入口（issue #55 迁入） */
.density-menu-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.density-menu-desc {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
}
.density-control {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin: 0 30rpx 28rpx;
  padding: 4rpx;
  box-sizing: border-box;
  border-radius: var(--radius-card);
  background: rgba(255,255,255,0.055);
  border: 1px solid rgba(255,255,255,0.11);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.09);
}
.density-option {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  color: rgba(255,255,255,0.68);
  border: 1px solid transparent;
  transition: background-color var(--duration-press) ease, color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.density-option:active {
  transform: scale(0.98);
  background: rgba(255,255,255,0.1);
}
/* 密度偏好是弱态设置：选中项用玫瑰描边+玫瑰字，不用主操作的实色填充 */
.density-option.active {
  color: #E8909E;
  background: rgba(232,144,158,0.08);
  border-color: rgba(232,144,158,0.45);
  box-shadow: none;
}
@media (prefers-reduced-motion: reduce) {
  .copy-btn,
  .density-option,
  .room-action-btn,
  .menu-item.danger {
    animation: none;
    transition: none;
  }
}
