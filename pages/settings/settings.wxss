@import '../shared/confirmation-sheet.wxss';
@import '../shared/room-code.wxss';
@import '../shared/segmented-control.wxss';

/* ===== Aurora Bloom: Settings ===== */
/* 第一组离顶栏 24rpx，与记录页、编辑页的首块顶距同一角色（issue #164） */
.content {
  padding: var(--space-page-first-block) var(--space-page-gutter) 30rpx;
  position: relative;
  z-index: 1;
}

.settings-group {
  margin-bottom: var(--space-settings-group-gap);
}
.settings-group-title {
  display: block;
  padding: 8rpx 8rpx 12rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.92);
}
/* 危险区与上面的常规分组拉开一档：相邻外边距合并取大值，必须大于分组的 28rpx 才有效（issue #164） */
.settings-danger-zone {
  margin-top: var(--space-lg);
}
.premium-card {
  margin-bottom: 0;
}
.room-card-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx var(--space-page-row-inset) 30rpx;
}
button.settings-share-invite {
  width: 100%;
  margin: 0;
}
.resync-room-btn {
  margin: 0;
}

/* Menu Items */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx var(--space-page-row-inset);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-item:not(.non-interactive):not(.danger):active,
.menu-item:not(.non-interactive):not(.danger).menu-item-hover {
  background: rgba(255,255,255,0.05);
  transition: background-color var(--duration-press-in) ease, transform var(--duration-press-in) var(--ease-out);
}
.menu-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  color: rgba(255,255,255,0.85);
}
.menu-arrow {
  color: var(--text-secondary);
}
.settings-version {
  flex-shrink: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  color: var(--text-secondary);
}
/* 使用说明按主题分块；弹层 chrome 与几何统一由 shared/confirmation-sheet 提供（issue #235）。 */
.help-topic {
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: var(--radius-md);
  background: rgba(255,255,255,0.035);
}
.help-topic:last-child {
  margin-bottom: 0;
}
.help-topic-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.92);
}
.help-topic .help-copy:last-child {
  margin-bottom: 0;
}
.help-copy {
  display: block;
  margin-bottom: 16rpx;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  overflow-wrap: normal;
}

/* 导航标题使用 pages/shared/nav-bar.wxss 的中性白。 */

/* 页底危险区：解除绑定在点之前就是危险样式（issue #77 / #139）——警告红字 + 警告红描边，
   与 .btn-danger 同族同红，不是第二种红；导出保持上面的普通行 */
.menu-item.danger {
  margin: 0;
  border: 1px solid rgba(249,115,115,0.28);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  background: var(--glass-fallback);
  transition: border-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.menu-item.danger::before {
  border-radius: var(--radius-md);
  background-color: var(--glass-bg);
  transition: background-color var(--duration-press) ease;
}
.menu-item.danger .menu-text {
  color: var(--color-danger);
}
/* 平涂层盖不到描边带：按下时描边同色提亮，和红色平涂层一起亮（issue #166） */
.menu-item.danger:active,
.menu-item.danger.danger-hover {
  transform: scale(0.95);
  border-color: rgba(249,115,115,0.4);
  transition: border-color var(--duration-press-in) ease, transform var(--duration-press-in) var(--ease-out);
}
.menu-item.danger:active::before,
.menu-item.danger.danger-hover::before {
  background-color: rgba(249,115,115,0.12);
  transition: background-color var(--duration-press-in) ease;
}

/* Room Code Item */
.room-code-item {
  padding: 28rpx var(--space-page-row-inset) 0;
}
.room-code-heading {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  min-width: 0;
  margin-bottom: 16rpx;
}
.room-code-label {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
}
.room-member-badge {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: 1;
}
.room-member-badge.paired {
  color: var(--aurora-pink);
  background: rgba(232,144,158,0.12);
}
.room-member-badge.waiting {
  color: rgba(255,255,255,0.72);
  background: rgba(255,255,255,0.06);
}
/* 展示、凭证票根与复制胶囊均与绑定页共用 shared/room-code.wxss（#271）。 */

/* 拿不到房间码时的下一步操作（issue #79）：重试/去绑定。
   弱态玫瑰描边按钮（与密度选项同族的弱选中态），不做第二颗实色主按钮；
   88rpx 触控高度，不加阴影（本文件阴影预算已满）。 */
.room-code-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx var(--space-page-row-inset) 28rpx;
}
.room-action-btn {
  flex: 1;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  color: var(--aurora-pink);
  background: rgba(232,144,158,0.08);
  border: 1px solid rgba(232,144,158,0.45);
  transition: transform var(--duration-press) var(--ease-out), background-color var(--duration-press) ease;
}
.room-action-btn:active,
.room-action-btn.room-action-btn-hover {
  transform: scale(0.95);
  background: rgba(232,144,158,0.14);
  transition: transform var(--duration-press-in) var(--ease-out), background-color var(--duration-press-in) ease;
}

/* Calendar Density Preference — 首页日历密度的设置入口（issue #55 迁入） */
.density-menu-desc {
  display: block;
  padding: 28rpx var(--space-page-row-inset) 8rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
}
/* 密度选项与记录、绑定共用 shared/segmented-control.wxss 的卡内变体；本页只保留外边距。 */
.density-menu-desc-full {
  white-space: nowrap;
}
.density-control {
  margin: 0 var(--space-page-row-inset) 28rpx;
}
@media (prefers-reduced-motion: reduce) {
  .room-action-btn,
  .menu-item,
  .menu-item.danger,
  .menu-item.danger::before {
    animation: none;
    transition: none;
  }
  .menu-item:not(.non-interactive):not(.danger):active,
  .menu-item:not(.non-interactive):not(.danger).menu-item-hover,
  .menu-item.danger:active,
  .menu-item.danger.danger-hover,
  .menu-item.danger:active::before,
  .menu-item.danger.danger-hover::before,
  .room-action-btn:active,
  .room-action-btn.room-action-btn-hover {
    transition: none;
  }
}
