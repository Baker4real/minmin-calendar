<view class="page safe-top" style="--safe-top: {{safeTop}}px; --safe-bottom: {{safeBottom}}px">
  <view class="nav-bar header-gradient">
    <view class="nav-placeholder"></view>
    <view class="nav-title">设置</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="content">
    <!-- 用户卡片：品牌心是文本字形（颜色走 wxss），不用红色心形表情（issue #77） -->
    <view class="profile-card premium-card">
      <view class="profile-avatar">♥</view>
      <view class="profile-name">美少女的日历</view>
      <text class="profile-desc">记录属于你们的每一天</text>
    </view>

    <!-- 房间号（菜单表情只重复标签，不再使用，issue #77） -->
    <view class="premium-card">
      <view class="menu-item room-code-item non-interactive">
        <view class="room-code-content">
          <text class="room-code-label">我的房间码</text>
          <text class="room-code-value {{roomCode ? '' : 'muted'}}">{{roomCodeDisplay || roomCode || '未绑定'}}</text>
        </view>
        <view wx:if="{{roomCode}}" class="copy-btn" bindtap="copyRoomCode" aria-role="button" aria-label="复制房间码" hover-class="copy-btn-hover">复制</view>
      </view>
      <!-- 拿不到房间码时给下一步：重试解析或去绑定，不再是死句子（issue #79） -->
      <view wx:if="{{roomCodeLoaded && !roomCode}}" class="room-code-actions">
        <view class="room-action-btn" bindtap="retryRoomResolve" aria-role="button" aria-label="重试获取房间码" hover-class="room-action-btn-hover">重试</view>
        <view class="room-action-btn" bindtap="goBind" aria-role="button" aria-label="去绑定房间" hover-class="room-action-btn-hover">去绑定</view>
      </view>
      <!-- issue #102：「解除绑定」从绑定页已绑定卡移到本卡，警示红菜单行族，二次确认文案不变 -->
      <view wx:if="{{roomCode}}" class="menu-item danger" hover-class="danger-hover" bindtap="unbind" aria-role="button" aria-label="解除绑定">
        <text class="menu-text">解除绑定</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 日历显示密度（首页日历的密度偏好入口） -->
    <view class="premium-card">
      <view class="menu-item non-interactive">
        <view class="density-menu-copy">
          <text class="menu-text">日历显示</text>
          <text class="density-menu-desc">清爽只看日期与标记，完整加显农历与节日</text>
        </view>
      </view>
      <view class="density-control" aria-label="日历信息密度">
        <view
          class="density-option {{calendarDensity == 'compact' ? 'active' : ''}}"
          data-density="compact"
          bindtap="setCalendarDensity"
          aria-role="radio"
          aria-label="清爽显示日历"
          aria-checked="{{calendarDensity == 'compact'}}" hover-class="density-option-hover">清爽</view>
        <view
          class="density-option {{calendarDensity == 'full' ? 'active' : ''}}"
          data-density="full"
          bindtap="setCalendarDensity"
          aria-role="radio"
          aria-label="完整显示农历和节假日"
          aria-checked="{{calendarDensity == 'full'}}" hover-class="density-option-hover">完整</view>
      </view>
    </view>

    <!-- 功能菜单：欢乐时光入口用欢乐时光标记的浅色心，不用表情（issue #77） -->
    <view class="premium-card">
      <view class="menu-item" bindtap="goMemory" aria-role="button" aria-label="查看欢乐时光" hover-class="menu-item-hover">
        <text class="menu-icon menu-heart">♥</text>
        <text class="menu-text">欢乐时光</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="premium-card">
      <view class="menu-item" bindtap="exportData" aria-role="button" aria-label="导出数据" hover-class="menu-item-hover">
        <text class="menu-text">导出数据</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 清除本地数据：点之前就是危险样式——警告红字 + 警告红描边（issue #77） -->
    <view class="premium-card">
      <view class="menu-item danger" hover-class="danger-hover" bindtap="clearData" aria-role="button" aria-label="清除本地数据">
        <text class="menu-text">清除本地数据</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="premium-card">
      <view class="menu-item" bindtap="about" aria-role="button" aria-label="关于" hover-class="menu-item-hover">
        <text class="menu-text">关于</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
</view>
