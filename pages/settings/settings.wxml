<import src="/pages/shared/confirmation-sheet.wxml" />
<import src="/pages/shared/nav-bar.wxml" />
<page-meta page-style="{{pageObscured ? 'overflow: hidden;' : ''}}"></page-meta>
<template is="sharedSheetPage" data="{{sheetExitGuard: sheetExitGuard}}" />
<view class="page safe-top {{pageObscured ? 'page-obscured' : ''}} {{pageHidden ? 'page-hidden' : ''}}" style="--safe-top: {{safeTop}}px; --safe-bottom: {{safeBottom}}px; --nav-bar-height: {{navBarHeight}}px; --capsule-right: {{capsuleRight}}px; --nav-title-padding-left: {{navTitlePaddingLeft}}px; --nav-title-padding-right: {{navTitlePaddingRight}}px">
  <include src="/pages/shared/aurora.wxml" />
  <!-- sheetDrag is declared by the shared bottom-sheet template -->
  <template is="sharedNavbar" data="{{variant: 'placeholder', title: '设置', pageObscured: pageObscured}}" />

  <view class="content" aria-hidden="{{pageObscured}}">
    <view class="settings-group">
      <text class="settings-group-title">房间</text>
      <view class="premium-card glass-surface">
        <view class="room-code-item non-interactive">
          <view class="room-code-heading">
            <text class="room-code-label">我的房间码</text>
            <text wx:if="{{roomMemberLabel}}" class="room-member-badge {{roomStatus === 'paired' ? 'paired' : 'waiting'}}">{{roomMemberLabel}}</text>
          </view>
          <view class="room-credential-ticket">
            <text class="room-code-value {{roomCode ? '' : 'muted'}}">{{roomCodeDisplay || roomCode || '未绑定'}}</text>
            <view wx:if="{{roomCode}}" class="copy-btn button-primary" bindtap="copyRoomCode" aria-role="button" aria-label="复制房间码" hover-start-time="20" hover-stay-time="70" hover-class="copy-btn-hover"><text class="copy-btn-surface">复制</text></view>
          </view>
        </view>
        <view wx:if="{{roomCode}}" class="room-card-actions">
          <button wx:if="{{roomStatus === 'waiting' && roomCode}}" class="btn-premium share-invite settings-share-invite button-primary" open-type="share" hover-start-time="20" hover-stay-time="70" hover-class="share-invite-hover" aria-role="button" aria-label="再发邀请">再发邀请</button>
        </view>
        <view wx:if="{{roomCodeLoaded && !roomCode}}" class="room-code-actions">
          <view class="room-action-btn button-outline" bindtap="retryRoomResolve" aria-role="button" aria-label="重试获取房间码" hover-start-time="20" hover-stay-time="70" hover-class="room-action-btn-hover">重试</view>
          <view class="room-action-btn button-outline" bindtap="goBind" aria-role="button" aria-label="去绑定房间" hover-start-time="20" hover-stay-time="70" hover-class="room-action-btn-hover">去绑定</view>
        </view>
      </view>
    </view>

    <view class="settings-group">
      <text class="settings-group-title">日历显示</text>
      <view class="premium-card glass-surface quiet-card">
        <text class="density-menu-desc">清爽只看日期与标记（含节日和调休）；<text class="density-menu-desc-full">完整另外显示农历</text></text>
        <view class="density-control" aria-role="radiogroup" aria-label="日历信息密度">
          <view class="segment-thumb segment-thumb-index-{{calendarDensity == 'full' ? 1 : 0}}" aria-hidden="true"></view>
          <view
            class="density-option {{calendarDensity == 'compact' ? 'active' : ''}}"
            data-density="compact"
            bindtap="setCalendarDensity"
            aria-role="radio"
            aria-label="清爽显示日期与标记"
            aria-checked="{{calendarDensity == 'compact'}}"
            hover-start-time="20" hover-stay-time="70" hover-class="density-option-hover"
          >清爽</view>
          <view
            class="density-option {{calendarDensity == 'full' ? 'active' : ''}}"
            data-density="full"
            bindtap="setCalendarDensity"
            aria-role="radio"
            aria-label="完整显示农历"
            aria-checked="{{calendarDensity == 'full'}}"
            hover-start-time="20" hover-stay-time="70" hover-class="density-option-hover"
          >完整</view>
        </view>
      </view>
    </view>

    <view class="settings-group">
      <text class="settings-group-title">数据</text>
      <view class="premium-card glass-surface quiet-card">
        <view class="menu-item resync-room-btn" bindtap="clearData" aria-role="button" aria-label="重新同步房间" hover-start-time="20" hover-stay-time="70" hover-class="menu-item-hover">
          <text class="menu-text">重新同步房间</text>
          <view class="ui-icon ui-icon-right ui-icon-24 menu-arrow" aria-hidden="true"></view>
        </view>
        <view class="menu-item" bindtap="exportData" aria-role="button" aria-label="导出数据" hover-start-time="20" hover-stay-time="70" hover-class="menu-item-hover">
          <text class="menu-text">导出数据</text>
          <view class="ui-icon ui-icon-right ui-icon-24 menu-arrow" aria-hidden="true"></view>
        </view>
      </view>
    </view>

    <view class="settings-group">
      <text class="settings-group-title">关于</text>
      <view class="premium-card glass-surface quiet-card">
        <view class="menu-item non-interactive">
          <text class="menu-text">版本</text>
          <text class="settings-version">v1.0.0</text>
        </view>
        <view class="menu-item" bindtap="openHelp" aria-role="button" aria-label="使用说明" hover-start-time="20" hover-stay-time="70" hover-class="menu-item-hover">
          <text class="menu-text">使用说明</text>
          <view class="ui-icon ui-icon-right ui-icon-24 menu-arrow" aria-hidden="true"></view>
        </view>
      </view>
    </view>

    <view class="settings-danger-zone">
      <view wx:if="{{roomCode}}" class="menu-item danger button-danger" hover-start-time="20" hover-stay-time="70" hover-class="danger-hover" bindtap="unbind" aria-role="button" aria-label="解除绑定">
        <text class="menu-text">解除绑定</text>
        <view class="ui-icon ui-icon-right ui-icon-24 menu-arrow" aria-hidden="true"></view>
      </view>
    </view>
  </view>

  <template is="sharedBottomSheet" data="{{sheetId: 'help', sheetMounted: helpMounted, sheetPhase: helpPhase, sheetHostClass: '', sheetPanelClass: 'help-sheet', sheetName: '使用说明', sheetTitle: '使用说明', sheetSubtitle: '', maskHandler: 'closeHelp', closeHandler: 'closeHelp', bodyTemplate: 'settingsHelpSheetBody', sheetDragClear: helpDragClear, helpTopics: helpTopics}}" />
  <template is="sharedBottomSheet" data="{{sheetId: 'confirmation', sheetMounted: confirmationMounted, sheetPhase: confirmationPhase, sheetHostClass: '', sheetPanelClass: 'confirmation-panel', sheetName: confirmationName, sheetTitle: confirmationTitle, sheetSubtitle: '', maskHandler: 'onConfirmationMask', closeHandler: 'onConfirmationClose', bodyTemplate: 'confirmationSheetBody', sheetDragClear: confirmationDragClear, confirmationDateText: confirmationDateText, confirmationContent: confirmationContent, confirmationActions: confirmationActions}}" />
</view>
