/* ===== Aurora Bloom: Bind Page ===== */
.content {
  padding: 60rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* Hero Section */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}
.hero-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  animation: bounceIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  filter: drop-shadow(0 0 20px rgba(232,144,158,0.3));
}
@keyframes bounceIn {
  from { opacity: 0; transform: scale(0.9); }
  60% { transform: scale(1.05); }
  to { opacity: 1; transform: scale(1); }
}
.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #E8909E;
  letter-spacing: 2rpx;
  text-shadow: 0 0 24rpx rgba(232,144,158,0.28);
}
.hero-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 16rpx;
  text-align: center;
  line-height: 1.8;
}

.premium-card {
  width: 100%;
  padding: 40rpx;
  margin-top: 30rpx;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.15);
  margin-bottom: 30rpx;
  background: rgba(255,255,255,0.05), rgba(18,22,61,0.92);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
.tab {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  font-weight: 500;
  transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
}
.tab.active {
  background: #E8909E;
  color: #0A0E27;
  font-weight: 600;
}
.info-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 30rpx;
  text-align: center;
}

/* Code Input – Dark Glass */
.code-input {
  width: 60%;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  font-size: 40rpx;
  text-align: center;
  letter-spacing: 12rpx;
  text-indent: 12rpx;
  margin-bottom: 30rpx;
  background: var(--glass-bg), rgba(18,22,61,0.92);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  font-weight: 700;
  color: #fff;
}
.code-input:focus {
  border-color: rgba(232,144,158,0.4);
  box-shadow: 0 0 20px rgba(232,144,158,0.1);
}

/* Bound Status — 柔和成功绿，不再霓虹 */
.bound-status {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 20rpx;
  color: #9ED6AE;
}
.bound-code {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  text-align: center;
  display: block;
  margin-bottom: 30rpx;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
}
.btn-danger {
  margin-top: 16rpx;
}
.error-msg {
  font-size: 24rpx;
  color: #F97373;
  margin-top: 20rpx;
  text-align: center;
  background: rgba(249,115,115,0.1);
  padding: 16rpx 30rpx;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(249,115,115,0.24);
}
