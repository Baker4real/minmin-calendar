/* ===== Aurora Bloom: Bind Page ===== */

.content {
  padding: 60rpx 30rpx calc(60rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* Hero Section */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 100%;
  margin-bottom: 20rpx;
}
.hero-icon {
  font-size: 120rpx;
  /* 品牌心：玫瑰文本字形，不再用红色心形表情（issue #77） */
  color: #E8909E;
  margin-bottom: 20rpx;
  animation: heroIn 0.6s var(--ease-out) both;
  /* ♥ 字形只留一层浅粉字阴影。不可点元素不再叠远层光晕（issue #146）。
     heroIn 无回弹入场保留，辉光本身无持续动画，减弱动效由 app.wxss 全局名单静止 */
  text-shadow: 0 0 18rpx rgba(240,196,192,0.32);
}
/* 入场只做淡入 + 轻微放大，不做 overshoot 回弹（issue #58） */
@keyframes heroIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
.hero-title {
  max-width: 100%;
  font-size: 48rpx;
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-title);
  /* 大标题不可点，用中性文字色，不用玫瑰（issue #77） */
  color: rgba(255,255,255,0.92);
}
.hero-desc {
  max-width: 100%;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.78);
  margin-top: 16rpx;
  text-align: center;
}

/* issue #115：第一次未绑定或校验失败时，卡片和错误条一起显现。
   静止态不写透明度或位移，减弱动效去掉动画后就是直接出现。 */
.bind-reveal {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: bindReveal var(--duration-enter) var(--ease-out) both;
}
@keyframes bindReveal {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.premium-card {
  width: 100%;
  padding: 40rpx;
  margin-top: 30rpx;
  box-sizing: border-box;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.15);
  margin-bottom: 30rpx;
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
}
.tab {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  padding: 0 20rpx;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.6);
  transition: background-color var(--duration-state) ease, color var(--duration-state) ease;
}
/* 选中 tab 与主按钮同族：实色玫瑰填充 + 画布海军字，字重角色不变 */
.tab.active {
  background: var(--aurora-pink);
  color: #0A0E27;
  font-weight: var(--font-weight-control);
}
.info-text {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  margin-bottom: 30rpx;
  text-align: center;
}

/* Code Input – Dark Glass */
.code-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 40rpx;
  line-height: 88rpx;
  text-align: center;
  letter-spacing: var(--letter-spacing-code-input);
  text-indent: var(--letter-spacing-code-input);
  margin-bottom: 30rpx;
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  font-weight: var(--font-weight-body);
  color: #fff;
}
/* 焦点是登记的 1px 实线玫瑰描边（基线边框本就是 1px solid），不加光晕（issue #81） */
.code-input:focus {
  border-color: #E8909E;
}
.input-placeholder {
  line-height: 88rpx;
}

/* Bound Status — 成功态用主色玫瑰，不引入色板外绿色 */
.bound-status {
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  text-align: center;
  margin-bottom: 20rpx;
  color: #E8909E;
}
/* 房间码是行内项（issue #83）：与复制键同处一行，不再自带块级居中与下方间距；
   字重/字距/数字对齐与 settings 的 .room-code-value 同族，字号保持本页 --font-size-body（settings 的 .room-code-value 为 36rpx）；
   issue #84：纯展示文本，不再承担点按复制职责 */
.bound-code {
  max-width: 100%;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.6);
  letter-spacing: var(--letter-spacing-room-code);
  word-break: break-all;
}
/* 房间码 + 复制键行（issue #83）：整组在卡片内水平居中，
   并承担与「进入应用」主按钮之间 30rpx 的间距（原独立复制行的职责） */
.bound-code-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}
/* 已绑定画面与设置页共用同一种复制小按钮（issue #78 像素同款契约，锚定 settings 的 .copy-btn）：
   玫瑰底、海军字、radius-sm 小操作圆角，横向 padding、玫瑰辉光投影与 box-shadow 过渡全部同款；
   按钮紧随房间码同排（issue #83），不再是独占一行的居中复制行 */
.copy-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
  background: var(--aurora-pink);
  color: #0A0E27;
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  box-shadow: 0 4px 15px rgba(232,144,158,0.28);
  transition: transform var(--duration-press) var(--ease-out);
}
.copy-btn:active {
  transform: scale(0.94);
}
/* 创建/加入被「请先解除绑定」拒绝时，当前屏直接给出的解除绑定入口（needUnbind 中间态，
   错误恢复路径；样式跟随 app 级 .btn-danger 警示红族） */
.unbind-inline {
  margin-top: 30rpx;
}
.error-msg {
  display: block;
  align-self: stretch;
  width: 100%;
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: #F97373;
  margin-top: 20rpx;
  text-align: center;
  background: rgba(249,115,115,0.1);
  padding: 16rpx 30rpx;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(249,115,115,0.24);
}
/* 校验失败的可点重试（issue #102）：警示红族轻量按钮，按下叠同族更深 tint（无 transform 过渡） */
.error-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  color: #F97373;
  background: rgba(249,115,115,0.1);
  border: 1px solid rgba(249,115,115,0.24);
  border-radius: var(--radius-sm);
}
.error-retry:active {
  background: rgba(249,115,115,0.24);
}

/* 减弱动效（app.wxss 全局名单外的页面登记）：复制键按下为立即缩放、无 0.2s 过渡；
   政策见 DESIGN.md「动效与性能边界」——按压 = 即时 scale + 既有底色变化 */
@media (prefers-reduced-motion: reduce) {
  .copy-btn,
  .bind-reveal {
    animation: none;
    transition: none;
  }
}
