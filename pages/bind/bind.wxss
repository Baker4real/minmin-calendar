/* ===== Aurora Bloom: Bind Page ===== */
.content {
  padding: 60rpx 30rpx calc(60rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* Hero Section */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 100%;
  margin-bottom: 20rpx;
}
.hero-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  animation: heroIn 0.6s var(--ease-out) both;
  filter: drop-shadow(0 0 20px rgba(232,144,158,0.3));
}
/* 入场只做淡入 + 轻微放大，不做 overshoot 回弹（issue #58） */
@keyframes heroIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
.hero-title {
  max-width: 100%;
  font-size: 48rpx;
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-title);
  color: #E8909E;
  text-shadow: 0 0 24rpx rgba(232,144,158,0.28);
}
.hero-desc {
  max-width: 100%;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.78);
  margin-top: 16rpx;
  text-align: center;
}

.premium-card {
  width: 100%;
  padding: 40rpx;
  margin-top: 30rpx;
  box-sizing: border-box;
}

/* Tab Bar */
.tab-bar {
  display: flex;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.15);
  margin-bottom: 30rpx;
  background: rgba(255,255,255,0.05), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
.tab {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  padding: 0 20rpx;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.6);
  transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
}
.tab.active {
  background: var(--aurora-pink);
  color: #0A0E27;
  font-weight: var(--font-weight-control);
}
.info-text {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  margin-bottom: 30rpx;
  text-align: center;
}

/* Code Input – Dark Glass */
.code-input {
  width: 60%;
  box-sizing: border-box;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  font-size: 40rpx;
  text-align: center;
  letter-spacing: var(--letter-spacing-code-input);
  text-indent: var(--letter-spacing-code-input);
  margin-bottom: 30rpx;
  background: var(--glass-bg), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  font-weight: var(--font-weight-body);
  color: #fff;
}
.code-input:focus {
  border-color: rgba(232,144,158,0.4);
  box-shadow: 0 0 20px rgba(232,144,158,0.1);
}

/* Bound Status — 成功态用主色玫瑰，不引入色板外绿色 */
.bound-status {
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  text-align: center;
  margin-bottom: 20rpx;
  color: #E8909E;
}
.bound-code {
  max-width: 100%;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.6);
  text-align: center;
  display: block;
  margin-bottom: 30rpx;
  letter-spacing: var(--letter-spacing-room-code);
  text-indent: var(--letter-spacing-room-code);
  word-break: break-all;
}
.btn-danger {
  margin-top: 16rpx;
}
.error-msg {
  display: block;
  align-self: stretch;
  width: 100%;
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: #F97373;
  margin-top: 20rpx;
  text-align: center;
  background: rgba(249,115,115,0.1);
  padding: 16rpx 30rpx;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(249,115,115,0.24);
}
