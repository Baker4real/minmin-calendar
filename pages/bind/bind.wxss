/* ===== Aurora Bloom: Bind Page ===== */

/* ===== 绑定页紫域试点（issue #87 画布/玻璃，issue #88 粉按钮族，issue #89 未绑定表单域）：页面级 token，
   app 级画布与全局 page 底色不动；紫/粉色板、紫玻璃回退与例外范围登记见 DESIGN.md「绑定页紫域试点」节 ===== */
.page {
  --bind-canvas-top: #2E2350;
  --bind-canvas-bottom: #1A1433;
  --bind-glass-tint: rgba(196,160,210,0.14);
  --bind-glass-fallback: rgba(26,20,51,0.92);
  /* 粉按钮族（issue #88）：胶囊实色粉 + 幽灵粉（更深一档会跌破真实合成面 4.5:1，见 DESIGN.md 账本） */
  --bind-cta-pink: #FF7FB0;
  --bind-ghost-pink: #FF8FBE;
  /* 成功标题玫瑰（issue #89 换装复核）：卡面换紫域三层后主色玫瑰 #E8909E 在合成面 ≈#433A5A 上
     只有约 4.48:1，升一档更亮玫瑰保住 4.5:1 下限（实测约 5.3:1，账本见 DESIGN.md 紫域试点节） */
  --bind-status-rose: #F2A3B0;
}
/* 画布：本页把 app 级 .page::before 极光层覆盖为深紫渐变，并保持静态（不参与 auroraPulse）；
   仍是视口固定层，滚动不出现底部色带分层（同 README 2026-09-01 的固定层策略） */
.page::before {
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, var(--bind-canvas-top), var(--bind-canvas-bottom));
  animation: none;
}

.content {
  padding: 60rpx 30rpx calc(60rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* Hero Section */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 100%;
  margin-bottom: 20rpx;
}
.hero-icon {
  font-size: 120rpx;
  /* 品牌心：玫瑰文本字形，不再用红色心形表情（issue #77） */
  color: #E8909E;
  margin-bottom: 20rpx;
  animation: heroIn 0.6s var(--ease-out) both;
  /* 紫域试点（issue #87）：♥ 字形多层静态辉光（浅粉近层 + 玫瑰远层两层，共三层），
     透明度都落在 DESIGN.md 已登记的浅粉 0.28–0.32 / 玫瑰 0.1–0.45 辉光区间；
     heroIn 无回弹入场保留，辉光本身无持续动画 */
  text-shadow:
    0 0 18rpx rgba(240,196,192,0.32),
    0 0 44rpx rgba(232,144,158,0.45),
    0 0 90rpx rgba(232,144,158,0.26);
}
/* 入场只做淡入 + 轻微放大，不做 overshoot 回弹（issue #58） */
@keyframes heroIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
.hero-title {
  max-width: 100%;
  font-size: 48rpx;
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-title);
  /* 大标题不可点，用中性文字色，不用玫瑰（issue #77） */
  color: rgba(255,255,255,0.92);
}
.hero-desc {
  max-width: 100%;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.78);
  margin-top: 16rpx;
  text-align: center;
}

.premium-card {
  width: 100%;
  padding: 40rpx;
  margin-top: 30rpx;
  box-sizing: border-box;
  /* 紫域试点（issue #87）：玻璃面切紫调 tint 叠深紫实底回退，回退实色唯一来源 --bind-glass-fallback；
     blur 与 -webkit-backdrop-filter 成对声明仍由 app 级 .premium-card 承担，本页不新增玻璃面 */
  background: var(--glass-bg), var(--bind-glass-tint), var(--bind-glass-fallback);
}
/* 两张卡（创建/加入表单卡、已绑定状态卡）本身没有点按操作：按下不缩放（issue #81 同款覆盖）；
   卡内控件保持各自登记的按压缩放 */
.premium-card:active {
  transform: none;
}

/* 粉胶囊主按钮族（issue #88）：进入应用/创建我的房间/加入房间统一实色粉胶囊，
   页面级覆盖 app 级玫瑰基类——粉底/深紫字/胶囊圆角/88rpx 触控高度在本页登记；
   玫瑰辉光投影、0.96 按压缩放、loading/disabled 形态与减弱动效登记仍由 app 级 .btn-premium 承担 */
.btn-premium {
  min-height: 88rpx;
  padding: 0;
  background: var(--bind-cta-pink);
  color: var(--bind-canvas-bottom);
  border-radius: var(--radius-full);
}

/* Tab Bar */
/* issue #89：玻璃面随未绑定表单域切紫域——白玻璃层保持本条更淡的一档，海军回退换紫 tint + 深紫回退 */
.tab-bar {
  display: flex;
  border-radius: var(--radius-sm);
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.15);
  margin-bottom: 30rpx;
  background: rgba(255,255,255,0.05), var(--bind-glass-tint), var(--bind-glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
.tab {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  padding: 0 20rpx;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  color: rgba(255,255,255,0.6);
  transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
}
/* 选中 tab（issue #89）：与主按钮同族的实色粉块 + 深紫字，字重角色不变 */
.tab.active {
  background: var(--bind-cta-pink);
  color: var(--bind-canvas-bottom);
  font-weight: var(--font-weight-control);
}
.info-text {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  margin-bottom: 30rpx;
  text-align: center;
}

/* Code Input – Dark Glass */
/* issue #89：输入框玻璃面与表单卡同配方切紫域；6 位上限、等宽数字、逐字槽位等输入行为零变化 */
.code-input {
  width: 60%;
  box-sizing: border-box;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  font-size: 40rpx;
  text-align: center;
  letter-spacing: var(--letter-spacing-code-input);
  text-indent: var(--letter-spacing-code-input);
  margin-bottom: 30rpx;
  background: var(--glass-bg), var(--bind-glass-tint), var(--bind-glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  font-weight: var(--font-weight-body);
  color: #fff;
}
/* 焦点是登记的 1px 实线描边（基线边框本就是 1px solid），不加光晕（issue #81）；
   issue #89：描边色随紫粉域换装映射为粉域主色，描边形态与聚焦行为不变 */
.code-input:focus {
  border-color: var(--bind-cta-pink);
}

/* Bound Status — 成功态用玫瑰表达，不引入色板外绿色；
   紫域试点（issue #89 换装复核）卡面换装后升一档 --bind-status-rose，主色玫瑰在紫卡上不达 4.5:1 */
.bound-status {
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  text-align: center;
  margin-bottom: 20rpx;
  color: var(--bind-status-rose);
}
/* 房间码是行内项（issue #83）：与复制键同处一行，不再自带块级居中与下方间距；
   字重/字距/数字对齐与 settings 的 .room-code-value 同族，字号保持本页 --font-size-body（settings 的 .room-code-value 为 36rpx）；
   issue #84：纯展示文本，不再承担点按复制职责 */
.bound-code {
  max-width: 100%;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.6);
  letter-spacing: var(--letter-spacing-room-code);
  word-break: break-all;
}
/* 解除绑定粉幽灵（issue #88）：移出警示红族——透明底 + 粉描边 + 粉字，
   在实际合成面（紫画布最亮端叠紫卡三层）上 ≥4.5:1（账本见 DESIGN.md 紫域试点节）；
   原生二次确认弹窗仍在 bind.js，零 JS 改动。Pressed 不再继承 app 级红 tint、改叠粉 tint，
   0.95 按压缩放与减弱动效登记沿用 app 级 .btn-danger 基类 */
.btn-danger {
  margin-top: 16rpx;
  background: transparent;
  color: var(--bind-ghost-pink);
  border: 1px solid rgba(255,143,190,0.45);
}
.btn-danger:active {
  background: rgba(255,143,190,0.12);
}
/* 房间码 + 复制键行（issue #83）：整组在卡片内水平居中，
   并承担与「进入应用」主按钮之间 30rpx 的间距（原独立复制行的职责） */
.bound-code-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}
/* 已绑定画面复制键（issue #88）：与主按钮同族的实色粉胶囊（--radius-full + 深紫字）。
   issue #78 的「与设置页 .copy-btn 像素同款」契约已随整页粉域换装解除：
   设置页保持玫瑰底海军字 radius-sm 不动，两页各自按真实底色验收（见 DESIGN.md #78 解除记录）；
   88rpx 触控高度、玫瑰辉光投影与按压缩放保留，按钮紧随房间码同排（issue #83 布局不回退） */
.copy-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;
  background: var(--bind-cta-pink);
  color: var(--bind-canvas-bottom);
  padding: 0 28rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  box-shadow: 0 4px 15px rgba(232,144,158,0.28);
  transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
}
.copy-btn:active {
  transform: scale(0.94);
}
/* 创建/加入被「请先解除绑定」拒绝时，当前屏直接给出的解除绑定入口 */
.unbind-inline {
  margin-top: 30rpx;
}
.error-msg {
  display: block;
  align-self: stretch;
  width: 100%;
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: #F97373;
  margin-top: 20rpx;
  text-align: center;
  background: rgba(249,115,115,0.1);
  padding: 16rpx 30rpx;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(249,115,115,0.24);
}

/* 减弱动效（app.wxss 全局名单外的页面登记）：复制键按下为立即缩放、无 0.2s 过渡；
   政策见 DESIGN.md「动效与性能边界」——按压 = 即时 scale + 既有底色变化 */
@media (prefers-reduced-motion: reduce) {
  .copy-btn {
    animation: none;
    transition: none;
  }
}
