@import '../shared/confirmation-sheet.wxss';
@import '../shared/form-control.wxss';
@import '../shared/room-code.wxss';
@import '../shared/segmented-control.wxss';
@import '../shared/retry-row.wxss';

/* ===== Aurora Bloom: Bind Page ===== */

.content {
  padding: 60rpx 30rpx calc(60rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* Hero Section */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 100%;
  margin-bottom: 20rpx;
}
.hero-icon {
  position: relative;
  font-size: 120rpx;
  /* 品牌心：玫瑰文本字形，不再用红色心形表情（issue #77） */
  color: var(--aurora-pink);
  margin-bottom: 20rpx;
  animation: heroIn 0.6s var(--ease-out) both;
  /* ♥ 字形只留一层浅粉字阴影。不可点元素不再叠远层光晕（issue #146）。
     heroIn 无回弹入场保留，辉光本身无持续动画，减弱动效由本页文件末尾的减弱动效块静止 */
  text-shadow: 0 0 18rpx rgba(240,196,192,0.32);
}
/* 入场只做淡入 + 轻微放大，不做 overshoot 回弹（issue #58） */
@keyframes heroIn {
  from { opacity: 0; transform: scale(0.92); }
  to { opacity: 1; transform: scale(1); }
}
/* 刚建好房间（issue #167）：♥ 向外漾开一次。回声是同一个字形的半透明副本，从心上放大淡出，
   播完即透明；不带字阴影，心仍只有那一层浅粉辉光（issue #146）。动画挂在伪元素上，
   再次校验去掉 hero-bloom 时心本身的 heroIn 不重播 */
.hero.hero-bloom .hero-icon::after {
  content: '♥';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  text-align: center;
  text-shadow: none;
  opacity: 0;
  pointer-events: none;
  animation: heroBloom var(--duration-emphasis) var(--ease-out) both;
}
@keyframes heroBloom {
  from { opacity: 0.6; transform: scale(1); }
  to { opacity: 0; transform: scale(1.6); }
}
.hero-title {
  max-width: 100%;
  font-size: 48rpx;
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-title);
  letter-spacing: var(--letter-spacing-display);
  text-indent: var(--letter-spacing-display);
  /* 大标题不可点，用中性文字色，不用玫瑰（issue #77） */
  color: rgba(255,255,255,0.92);
}
.hero-desc {
  max-width: 100%;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  text-indent: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  margin-top: 16rpx;
  text-align: center;
}

/* issue #115：第一次未绑定或校验失败时，卡片和错误条一起显现。
   静止态不写透明度或位移，减弱动效去掉动画后就是直接出现。 */
.bind-reveal {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: bindReveal var(--duration-enter) var(--ease-out) both;
}
@keyframes bindReveal {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
/* 刚建好房间（issue #167）：已绑定卡换下创建表单时用同一个显现进来，不硬切；外层 .bind-reveal 早已播完，
   两段不叠加。再次校验清掉 justCreated 后不重播 */
.premium-card.bound-reveal {
  animation: bindReveal var(--duration-enter) var(--ease-out) both;
}

.premium-card {
  width: 100%;
  padding: 40rpx;
  margin-top: 30rpx;
  box-sizing: border-box;
}

/* 创建/加入与记录、设置共用 shared/segmented-control.wxss；本页只保留卡内容器的下间距。 */
.tab-bar {
  margin-bottom: 30rpx;
}
.tab-bar.tab-bar-unselected {
  margin-bottom: 0;
}
.info-text {
  display: block;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  text-indent: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.72);
  margin-bottom: 30rpx;
  text-align: center;
}

/* Code Input – Dark Glass */
.code-input {
  height: 88rpx;
  border: 1px solid rgba(255,255,255,0.15);
  padding: 0 20rpx;
  font-size: 40rpx;
  line-height: 88rpx;
  text-align: center;
  margin-bottom: 30rpx;
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  font-weight: var(--font-weight-body);
  color: rgba(255,255,255,0.92);
}
.code-input.code-input-empty {
  letter-spacing: 2rpx;
  text-indent: 2rpx;
  font-weight: var(--font-weight-body);
}
.code-input.code-input-filled {
  letter-spacing: var(--letter-spacing-code-input);
  text-indent: var(--letter-spacing-code-input);
}
/* R10：焦点描边由 shared/form-control.wxss 的 form-control-focused 统一绘制，不加光晕。 */
.input-placeholder {
  line-height: 88rpx;
}

/* Bound Status — 成功态用主色玫瑰，不引入色板外绿色 */
.bound-status {
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  text-align: center;
  margin-bottom: 20rpx;
  color: var(--aurora-pink);
}
/* 房间码是行内纯展示文本（issue #83/#84），展示样式与设置页共用 shared/room-code.wxss（#232）。 */
/* 建房成功凭证票根（issue #252）：房间码左对齐，紧凑复制胶囊嵌在深色凹槽右侧。 */
.bound-code-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 30rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: rgba(10,14,39,0.52);
  border: 1px solid rgba(232,144,158,0.20);
}
.bound-code-row .room-code-value {
  flex: 1;
  min-width: 0;
  text-align: left;
}
.bound-code-row .copy-btn {
  padding: 0 24rpx;
  background: rgba(232,144,158,0.14);
  color: var(--aurora-pink);
  border: 1px solid rgba(232,144,158,0.45);
  border-radius: var(--radius-full);
}
.bound-code-row .copy-btn::before {
  border-radius: inherit;
}
/* 复制键的触控高度、按压与减弱动效仍共用 shared/room-code.wxss（#232）。 */
/* 原生分享按钮的玫瑰主操作与按压样式在 app.wxss，由绑定和设置共用（issue #218）。 */
/* 刚创建房间时的次操作「进入应用」（issue #149）：DESIGN.md button-ghost——透明底、玫瑰描边和玫瑰字，
   居中胶囊，视觉权重低于整宽实底的「发给 TA」，不加投影。上下 12px 内边距让 320px 宽下触控高度仍 ≥44px */
.btn-ghost {
  width: fit-content;
  margin: 0 auto;
  padding: 12px 28px;
  box-sizing: border-box;
  background: transparent;
  color: var(--aurora-pink);
  border: 1.5px solid var(--aurora-pink);
  border-radius: var(--radius-full);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  transition: transform var(--duration-press) var(--ease-out);
}
.btn-ghost:active,
.btn-ghost.btn-ghost-hover {
  transform: scale(0.95);
}
/* 创建/加入被「请先解除绑定」拒绝时，当前屏直接给出的解除绑定入口（needUnbind 中间态，
   错误恢复路径；样式跟随 app 级 .btn-danger 警示红族） */
.unbind-inline {
  margin-top: 30rpx;
}
.error-msg {
  display: block;
  align-self: stretch;
  width: 100%;
  box-sizing: border-box;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  text-indent: var(--letter-spacing-assist);
  color: var(--color-danger);
  margin-top: 20rpx;
  text-align: center;
  /* 错误条压在极光上：10% 红是叠在海军回退上的平涂层（issue #163），否则极光最亮处红字不到 4.5:1 */
  background: linear-gradient(rgba(249,115,115,0.1), rgba(249,115,115,0.1)), var(--glass-fallback);
  padding: 16rpx 30rpx;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(249,115,115,0.24);
}
/* 校验失败重试与首页、记录 tab 共用 shared/retry-row.wxss（#234）；本页只留与错误条的间距。 */
.error-retry {
  margin-top: 16rpx;
}

/* 减弱动效：本页声明的动画和过渡都在这里覆盖，写在文件末尾才压得住它们（app.wxss 的同名覆盖会被本页规则盖过）。
   幽灵「进入应用」、创建/加入 tab 按下为立即缩放、无过渡；♥ 不播 heroIn，直接出现；复制键由共享样式覆盖。
   政策见 DESIGN.md「动效与性能边界」——按压 = 即时 scale + 既有底色变化 */
@media (prefers-reduced-motion: reduce) {
  .btn-ghost,
  .bind-reveal,
  .hero-icon {
    animation: none;
    transition: none;
  }
  /* 刚建好房间（issue #167）：♥ 不漾开（回声静止透明），已绑定卡直接出现 */
  .hero.hero-bloom .hero-icon::after,
  .premium-card.bound-reveal {
    animation: none;
  }
}
