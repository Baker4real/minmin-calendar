<view class="page safe-top" style="--safe-top: {{safeTop}}px; --safe-bottom: {{safeBottom}}px">
  <view class="content">
    <view class="hero">
      <!-- 品牌心是文本字形（颜色走 wxss），不用红色心形表情（issue #77） -->
      <view class="hero-icon">♥</view>
      <text class="hero-title">美少女的日历</text>
      <text class="hero-desc">两个人的专属空间<br/>共享经期与欢乐时光</text>
    </view>

    <view wx:if="{{bound}}" class="premium-card">
      <view class="bound-status">已绑定房间</view>
      <!-- issue #83：复制键紧贴房间码同一行，整组在卡片内水平居中；
           issue #84：房间码回归纯展示文本，复制键是唯一复制入口 -->
      <view class="bound-code-row">
        <text class="bound-code">房间码：{{roomCode}}</text>
        <view class="copy-btn" bindtap="copyRoomCode" aria-role="button" aria-label="复制房间码">复制</view>
      </view>
      <!-- issue #102：创建成功后的下一步引导；复制键仍是唯一复制入口，不新增第二个 -->
      <text wx:if="{{justCreated}}" class="info-text">把房间码发给 TA</text>
      <!-- issue #102：已绑定冷启动由 checkRoom 自动进首页，「进入应用」只在跳转失败或刚创建房间时出现；
           「解除绑定」移到设置页房间卡，本卡不再提供 -->
      <view wx:if="{{justCreated || homeJumpFailed}}" class="btn-premium" bindtap="goHome" aria-role="button" aria-label="进入应用">进入应用</view>
    </view>

    <view wx:else class="premium-card">
      <view class="tab-bar">
        <view class="tab {{tab==='create' ? 'active' : ''}}" bindtap="switchTab" data-tab="create" aria-role="radio" aria-label="创建房间" aria-checked="{{tab==='create'}}">创建房间</view>
        <view class="tab {{tab==='join' ? 'active' : ''}}" bindtap="switchTab" data-tab="join" aria-role="radio" aria-label="加入房间" aria-checked="{{tab==='join'}}">加入房间</view>
      </view>

      <view wx:if="{{tab === 'create'}}">
        <text class="info-text">生成房间码，把码发给对方加入</text>
        <view wx:if="{{loading}}" class="btn-premium loading" aria-role="button" aria-disabled="true">创建中...</view>
        <view wx:else class="btn-premium" bindtap="createRoom" aria-role="button" aria-label="创建我的房间">创建我的房间</view>
      </view>

      <view wx:if="{{tab === 'join'}}">
        <text class="info-text">输入对方给你的房间码</text>
        <input class="code-input" placeholder-class="input-placeholder" placeholder="输入6位码" value="{{joinCode}}" bindinput="onCodeInput" maxlength="6" confirm-type="done" bindconfirm="joinRoom" aria-label="输入6位房间码"/>
        <view wx:if="{{joinCode.length < 6 && !loading}}" class="btn-premium disabled" aria-role="button" aria-disabled="true">请输入6位房间码</view>
        <view wx:elif="{{loading}}" class="btn-premium loading" aria-role="button" aria-disabled="true">加入中...</view>
        <view wx:elif="{{joinCode.length === 6}}" class="btn-premium" bindtap="joinRoom" aria-role="button" aria-label="加入房间">加入房间</view>
      </view>

      <view wx:if="{{needUnbind}}" class="btn-danger unbind-inline" bindtap="unbind" aria-role="button" aria-label="解除绑定">解除绑定</view>
    </view>

    <text wx:if="{{errorMsg}}" class="error-msg">{{errorMsg}}</text>
    <!-- issue #102：房间校验失败给出可点重试（重跑校验），停留在本页，不导向重新绑定 -->
    <view wx:if="{{checkFailed}}" class="error-retry" bindtap="retryCheck" aria-role="button" aria-label="重试">重试</view>
  </view>
</view>
