/* ===== Aurora Bloom: Memory ===== */
/* 导航标题不可点：中性文字色（共享基类在 app.wxss，页面侧覆盖颜色，issue #77） */
.nav-title {
  color: rgba(255,255,255,0.92);
}
.content {
  padding: 0 24rpx calc(30rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  position: relative;
  z-index: 1;
}

/* Btn Premium */
.btn-premium {
  margin: 24rpx 0 20rpx;
  line-height: var(--line-height-assist);
}

/* List Items – Timeline */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
  position: relative;
}
/* 欢乐时光列表行只有浅色心，不再另放玫瑰圆点——玫瑰点只表经期（issue #77） */
.list-item:last-child {
  border-bottom: none;
}
.list-item:active,
.list-item.list-item-hover {
  background: rgba(255,255,255,0.05);
}

.memory-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.memory-info {
  min-width: 0;
}
.memory-heart {
  font-size: 36rpx;
  color: #F0C4C0;
  filter: drop-shadow(0 0 10px rgba(240,196,192,0.3));
}
.memory-date {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.85);
}
.memory-note {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.memory-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

/* Skeleton Loading – 列表条目形状的哑光占位 */
.skeleton-card {
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-card);
  overflow: hidden;
}
.skeleton-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.skeleton-item:last-child {
  border-bottom: none;
}
.skeleton-dot {
  width: 36rpx;
  height: 36rpx;
  margin-left: 20rpx;
  border-radius: var(--radius-circle);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}
.skeleton-body {
  flex: 1;
  margin-left: 16rpx;
}
.skeleton-line {
  height: 28rpx;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}
.skeleton-line-title {
  width: 42%;
}
.skeleton-line-sub {
  width: 62%;
  height: 22rpx;
  margin-top: 12rpx;
}
@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}
@media (prefers-reduced-motion: reduce) {
  .skeleton-dot,
  .skeleton-line {
    animation: none;
  }
  .load-failed {
    transition: none;
  }
}

/* Empty State */
.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: rgba(255,255,255,0.5);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-card);
}

/* Load Failure —— 重试是可识别的操作（玫瑰小操作按钮），不是空列表的安静说明 */
.load-failed {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  transition: transform var(--duration-press) var(--ease-out);
}
.load-failed:active,
.load-failed.load-failed-hover {
  transform: scale(0.98);
}
.retry-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  border-radius: var(--radius-sm);
  background: var(--aurora-pink);
  color: #0A0E27;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
}
.retry-btn:active,
.retry-btn.retry-btn-hover {
  transform: scale(0.96);
}
