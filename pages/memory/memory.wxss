/* ===== Aurora Bloom: Memory ===== */
.content {
  padding: 0 24rpx calc(30rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  position: relative;
  z-index: 1;
}

/* Btn Premium */
.btn-premium {
  margin: 24rpx 0 20rpx;
  line-height: var(--line-height-assist);
}

/* List Items – Timeline */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color 0.3s ease, transform 0.3s ease;
  position: relative;
}
/* Timeline dot on left — 静态柔光玫瑰点 */
.list-item::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  background: #E8909E;
  border-radius: var(--radius-circle);
  box-shadow: 0 0 10rpx rgba(232,144,158,0.45);
  transform: translateY(-50%);
}
.list-item:last-child {
  border-bottom: none;
}
.list-item:active {
  background: rgba(255,255,255,0.05);
}

.memory-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 20rpx;
}
.memory-heart {
  font-size: 36rpx;
  color: #F0C4C0;
  filter: drop-shadow(0 0 10px rgba(240,196,192,0.3));
}
.memory-date {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.85);
}
.memory-note {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
}
.memory-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

/* Skeleton Loading – 列表条目形状的哑光占位 */
.skeleton-card {
  background: var(--glass-bg), var(--glass-fallback);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-card);
  overflow: hidden;
}
.skeleton-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.skeleton-item:last-child {
  border-bottom: none;
}
.skeleton-dot {
  width: 36rpx;
  height: 36rpx;
  margin-left: 20rpx;
  border-radius: var(--radius-circle);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}
.skeleton-body {
  flex: 1;
  margin-left: 16rpx;
}
.skeleton-line {
  height: 28rpx;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.08);
  animation: skeletonPulse 2.4s ease-in-out infinite;
}
.skeleton-line-title {
  width: 42%;
}
.skeleton-line-sub {
  width: 62%;
  height: 22rpx;
  margin-top: 12rpx;
}
@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}
@media (prefers-reduced-motion: reduce) {
  .skeleton-dot,
  .skeleton-line {
    animation: none;
  }
}

/* Empty State */
.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: rgba(255,255,255,0.5);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  background: rgba(255,255,255,0.05), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--radius-card);
}
