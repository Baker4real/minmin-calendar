/* ===== Aurora Bloom: Memory ===== */
.content {
  padding: 0 24rpx 30rpx;
  position: relative;
  z-index: 1;
}

/* Btn Premium */
.btn-premium {
  margin: 24rpx 0 20rpx;
}

/* List Items – Timeline */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  transition: background-color 0.3s ease, transform 0.3s ease;
  position: relative;
}
/* Timeline dot on left — 静态柔光玫瑰点 */
.list-item::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  background: #E8909E;
  border-radius: 50%;
  box-shadow: 0 0 10rpx rgba(232,144,158,0.45);
  transform: translateY(-50%);
}
.list-item:last-child {
  border-bottom: none;
}
.list-item:active {
  background: rgba(255,255,255,0.05);
}

.memory-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 20rpx;
}
.memory-heart {
  font-size: 36rpx;
  filter: drop-shadow(0 0 10px rgba(232,144,158,0.3));
}
.memory-date {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  font-weight: 600;
}
.memory-note {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  margin-top: 4rpx;
}
.memory-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

/* Empty State */
.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  color: rgba(255,255,255,0.5);
  font-size: 28rpx;
  line-height: 1.8;
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
}
