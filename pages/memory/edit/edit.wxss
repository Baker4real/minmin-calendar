/* ===== Aurora Bloom: Memory Edit ===== */
/* 导航标题不可点：中性文字色（共享基类在 app.wxss，页面侧覆盖颜色，issue #77） */
.nav-title {
  color: rgba(255,255,255,0.92);
}
.content {
  padding: 24rpx 24rpx calc(24rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  position: relative;
  z-index: 1;
}

/* Form Card */
.premium-card {
  padding: 36rpx;
  box-sizing: border-box;
}
/* 表单卡片本身没有点按操作：按下不缩放（issue #81）；卡内控件保持各自登记的按压缩放 */
.premium-card:active {
  transform: none;
}

/* Form Items */
.form-item {
  margin-bottom: 36rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  font-size: var(--font-size-caption);
  color: rgba(255,255,255,0.6);
  display: block;
  margin-bottom: 12rpx;
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  font-size: var(--font-size-input);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  padding: 22rpx;
  background: rgba(255,255,255,0.06), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: var(--radius-sm);
  border: 1px solid rgba(255,255,255,0.12);
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}
.form-picker-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
  line-height: 1;
}
.form-picker:active {
  border-color: rgba(232,144,158,0.4);
  box-shadow: 0 0 20px rgba(232,144,158,0.1);
}
.form-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  font-size: var(--font-size-input);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  padding: 22rpx;
  background: rgba(255,255,255,0.06), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: var(--radius-sm);
  border: 1px solid rgba(255,255,255,0.12);
  transition: border-color 0.3s ease;
}
/* 备注输入焦点：登记的 1px 实线玫瑰描边（基线边框本就是 1px solid），不加光晕（issue #81） */
.form-input:focus {
  border-color: #E8909E;
}
.input-placeholder {
  line-height: var(--line-height-body);
}

/* 草稿恢复说明：表单上常驻可见，不只靠一闪而过的提示 */
.draft-notice {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--aurora-pink);
  margin-bottom: 24rpx;
}

/* Buttons */
.btns {
  margin-top: 30rpx;
}
.btn-premium,
.btn-danger {
  line-height: var(--line-height-assist);
}
.btn-premium {
  margin-bottom: 20rpx;
}

/* 减弱动效：边框过渡即时切换，不做渐进
   （issue #106；DESIGN.md 动效政策——状态反馈走无位移通道） */
@media (prefers-reduced-motion: reduce) {
  .form-picker,
  .form-input {
    transition: none;
  }
}
