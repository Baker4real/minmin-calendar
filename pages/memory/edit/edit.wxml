<view class="page safe-top">
  <view class="nav-bar header-gradient">
    <view class="nav-back" bindtap="goBack">
      <view class="nav-back-surface"></view>
      <text class="nav-back-icon">‹</text>
    </view>
    <view class="nav-title">欢乐时光</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="content">
    <view class="premium-card fade-in">
      <view class="form-item">
        <text class="form-label">日期</text>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="form-picker">{{date}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="记录你们的特别时刻..." value="{{note}}" bindinput="onNoteInput"/>
      </view>
    </view>

    <view class="btns fade-in fade-in-d1">
      <view wx:if="{{!saving}}" class="btn-premium" bindtap="save">保存</view>
      <view wx:else class="btn-premium loading">保存中...</view>
      <view wx:if="{{isEdit}}" class="btn-danger" bindtap="delete">删除此记录</view>
    </view>
  </view>
</view>
