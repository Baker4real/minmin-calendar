<import src="/pages/shared/confirmation-sheet.wxml" />
<import src="/pages/shared/nav-bar.wxml" />
<import src="/pages/shared/form-controls.wxml" />
<page-meta page-style="{{pageObscured ? 'overflow: hidden;' : ''}}"></page-meta>
<template is="sharedSheetPage" data="{{sheetExitGuard: sheetExitGuard}}" />
<view class="page safe-top {{pageObscured ? 'page-obscured' : ''}} {{pageHidden ? 'page-hidden' : ''}}" style="--safe-top: {{safeTop}}px; --safe-bottom: {{safeBottom}}px; --nav-bar-height: {{navBarHeight}}px; --capsule-right: {{capsuleRight}}px">
  <wxs module="sheetDrag" src="../../../utils/sheetDrag.wxs"></wxs>
  <include src="/pages/shared/aurora.wxml" />
  <template is="sharedNavbar" data="{{variant: 'back', title: pageTitle, pageObscured: pageObscured}}" />

  <view class="content" aria-hidden="{{pageObscured}}">
    <view class="premium-card glass-surface">
      <view wx:if="{{authorLabel}}" class="record-author">{{authorLabel}}</view>
      <view wx:if="{{draftRestored}}" class="draft-notice" aria-role="alert">
        <text>{{draftNoticeText}} · </text>
        <text class="draft-discard" hover-class="draft-discard-hover" bindtap="discardDraft" aria-role="button" aria-label="{{draftDiscardText}}">{{draftDiscardText}}</text>
      </view>
      <view class="form-item" id="field-date">
        <template is="sharedDateField" data="{{label: '日期', value: date, displayValue: dateLabel, placeholder: '', ariaLabel: '日期，' + dateLabel + '，点按修改', error: fieldErrors.date, maxDate: maxDate, saving: saving, tapHandler: 'openMemoryDatePicker'}}" />
      </view>
      <view class="form-item">
        <text class="form-label">内容</text>
        <textarea class="form-input form-control{{noteFocused ? ' form-control-focused' : ''}}" placeholder-class="input-placeholder" placeholder="记录这一天的欢乐时光..." value="{{note}}" bindinput="onNoteInput" bindfocus="onNoteFocus" bindblur="onNoteBlur" maxlength="500" auto-height disabled="{{saving}}" aria-label="内容"/>
      </view>
    </view>

    <template is="sharedRecordActions" data="{{saving: saving, deleting: deleting, submitted: submitted, isEdit: isEdit}}" />
  </view>
  <template is="sharedBottomSheet" data="{{sheetId: 'confirmation', sheetMounted: confirmationMounted, sheetPhase: confirmationPhase, sheetHostClass: '', sheetPanelClass: 'confirmation-panel', sheetName: confirmationName, sheetTitle: confirmationTitle, sheetSubtitle: '', maskHandler: 'onConfirmationMask', closeHandler: 'onConfirmationClose', bodyTemplate: 'confirmationSheetBody', sheetDragClear: confirmationDragClear, confirmationDateText: confirmationDateText, confirmationContent: confirmationContent, confirmationActions: confirmationActions}}" />
  <template is="sharedBottomSheet" data="{{sheetId: 'datePicker', sheetMounted: datePickerMounted, sheetPhase: datePickerPhase, sheetHostClass: '', sheetPanelClass: 'date-picker-panel', sheetName: datePickerName, sheetTitle: datePickerTitle, sheetSubtitle: datePickerSubtitle, maskHandler: 'onDatePickerMask', closeHandler: 'onDatePickerClose', bodyTemplate: 'datePickerSheetBody', sheetDragClear: datePickerDragClear, datePickerYears: datePickerYears, datePickerMonths: datePickerMonths, datePickerDays: datePickerDays, datePickerValue: datePickerValue, datePickerYearAria: datePickerYearAria, datePickerMonthAria: datePickerMonthAria, datePickerDayAria: datePickerDayAria, datePickerConfirmAria: datePickerConfirmAria}}" />
</view>
