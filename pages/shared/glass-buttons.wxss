/* 玻璃面只共享层叠与裁切结构；各选择器保留自己的透明度、描边、圆角和阴影档。 */
.glass-surface {
  position: relative;
  overflow: hidden;
}

/* 信息容器的高级卡保留棱镜顶线；重复年月与普通设置组使用同族安静面，把焦点还给记录。 */
.quiet-card {
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.14);
}
.quiet-card::after {
  content: none;
}

/* 玫瑰实色按钮只共享布局与柔光锚点；填充、文字、圆角、尺寸和按压值留在修饰类。 */
.button-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 警示红按钮和危险菜单行共用平涂层的定位结构；红色、描边与按压档留在各自修饰类。 */
.button-danger {
  position: relative;
  z-index: 0;
}
.button-danger::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  z-index: -1;
}

/* 次级描边按钮共用布局与定位；幽灵、确认和房间操作各自的填充、描边和形状不变。 */
.button-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
