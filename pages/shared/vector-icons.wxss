/* Five inline SVG masks: no icon font, image request, runtime dependency, or platform glyph metrics. */
.ui-icon {
  position: relative;
  display: inline-block;
  flex: 0 0 auto;
  box-sizing: border-box;
  background-color: currentColor;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
  pointer-events: none;
}
.ui-icon-36 {
  width: 36rpx;
  height: 36rpx;
}
.ui-icon-28 {
  width: 28rpx;
  height: 28rpx;
}
.ui-icon-24 {
  width: 24rpx;
  height: 24rpx;
}
