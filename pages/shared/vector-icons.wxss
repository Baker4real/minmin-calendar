/* Chevrons optically face into circular hit areas instead of sitting on their mathematical box center. */
.ui-icon-circle.ui-icon-left {
  left: -1.5rpx;
}
.ui-icon-circle.ui-icon-right {
  right: -1.5rpx;
}
