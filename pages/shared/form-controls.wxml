<template name="sharedDateField">
  <text wx:if="{{!journal}}" class="form-label">{{label}}</text>
  <view class="form-picker form-control{{focused ? ' form-control-focused' : ''}}{{saving ? ' disabled' : ''}}{{journal ? ' memory-date-letter' : ''}}" hover-start-time="20" hover-stay-time="70" hover-class="form-picker-hover" bindtap="{{tapHandler}}" aria-role="button" aria-disabled="{{saving}}" aria-label="{{ariaLabel}}{{error ? '，' + error : ''}}">
    <block wx:if="{{journal}}">
      <text class="memory-heart" aria-hidden="true">♥</text>
      <view class="memory-date-copy">
        <text class="memory-date-value">{{value ? displayValue : placeholder}}</text>
      </view>
      <text class="memory-date-action">改日期</text>
    </block>
    <block wx:else>
      <text class="{{value ? '' : 'input-placeholder'}}">{{value ? displayValue : placeholder}}</text>
      <view class="ui-icon ui-icon-right ui-icon-24 form-picker-arrow" aria-hidden="true"></view>
    </block>
  </view>
  <text wx:if="{{error}}" class="field-error" aria-role="alert">{{error}}</text>
</template>

<template name="sharedChoiceChip">
  <view
    class="{{checked ? 'active' : ''}}{{saving ? ' disabled' : ''}} {{chipClass}}"
    data-value="{{item.value}}"
    bindtap="{{tapHandler}}"
    aria-role="{{role}}"
    aria-label="{{ariaLabel}}"
    aria-checked="{{checked}}"
    aria-disabled="{{saving}}" hover-start-time="20" hover-stay-time="70" hover-class="{{chipClass}}-hover">
    <text class="choice-chip-label">{{item.label}}</text>
    <view wx:if="{{degreeDots}}" class="flow-degree" aria-hidden="true">
      <view wx:for="{{degreeDots}}" wx:key="*this" class="flow-degree-dot"></view>
    </view>
  </view>
</template>

<template name="sharedRecordActions">
  <view class="record-actions {{actionsClass}}{{actionsHidden ? ' record-actions-hidden' : ''}}">
    <view class="btns">
      <view wx:if="{{!saving && !deleting && !submitted}}" class="btn-premium button-primary" bindtap="save" aria-role="button" aria-label="保存" hover-start-time="20" hover-stay-time="70" hover-class="btn-premium-hover">保存</view>
      <view wx:elif="{{saving}}" class="btn-premium loading button-primary" aria-role="button" aria-disabled="true">保存中...</view>
      <view wx:else class="btn-premium disabled button-primary" aria-role="button" aria-disabled="true">保存</view>
    </view>
  </view>
</template>

<template name="sharedRecordDelete">
  <view wx:if="{{isEdit}}" class="delete-zone">
    <view wx:if="{{isEdit && !deleting && !saving && !submitted}}" class="btn-danger button-danger" hover-start-time="20" hover-stay-time="70" hover-class="btn-danger-hover" bindtap="delete" aria-role="button" aria-label="删除此记录">删除此记录</view>
    <view wx:elif="{{isEdit && deleting}}" class="btn-danger loading button-danger" aria-role="button" aria-disabled="true">删除中...</view>
    <view wx:elif="{{isEdit}}" class="btn-danger disabled button-danger" aria-role="button" aria-disabled="true">删除此记录</view>
  </view>
</template>
