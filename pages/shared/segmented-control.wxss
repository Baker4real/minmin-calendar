/* issue #233：绑定方式、记录分类与日历密度共用同一种分段控件。
   页面只保留容器外边距；选项、按压、选中态与减弱动效均以此文件为唯一来源。 */
.segment-control,
.density-control,
.tab-bar {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  box-sizing: border-box;
  position: relative;
}

.segment-control.segment-columns-3,
.density-control.segment-columns-3,
.tab-bar.segment-columns-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

/* 卡内变体：绑定与设置共用内凹深色轻玻璃轨道。 */
.density-control,
.tab-bar {
  padding: 6rpx;
  border-radius: var(--radius-card);
  background: rgba(10,14,39,0.45);
  border: 1px solid rgba(255,255,255,0.07);
}

/* 画布上变体：记录 tab 直接压在极光上，海军回退保证文字对比度。 */
.segment-control {
  padding: 4rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(rgba(255,255,255,0.055), rgba(255,255,255,0.055)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.11);
}

/* #270：同一枚实体滑块按选中索引滑移；连点只改 transform，过渡从当前帧自然折返。 */
.segment-thumb {
  position: absolute;
  z-index: 0;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  box-sizing: border-box;
  background: rgba(232,144,158,0.14);
  border: 1px solid rgba(232,144,158,0.48);
  border-radius: var(--radius-md);
  pointer-events: none;
  transition: transform var(--duration-state) var(--ease-out);
}
.tab-bar .segment-thumb,
.density-control .segment-thumb {
  width: calc((100% - 22rpx) / 2);
}
.segment-control .segment-thumb {
  top: 4rpx;
  bottom: 4rpx;
  left: 4rpx;
  width: calc((100% - 18rpx) / 2);
}
.tab-bar .segment-thumb.segment-thumb-columns-3,
.density-control .segment-thumb.segment-thumb-columns-3 {
  width: calc((100% - 32rpx) / 3);
}
.segment-control .segment-thumb.segment-thumb-columns-3 {
  width: calc((100% - 28rpx) / 3);
}
.segment-thumb.segment-thumb-index-0 {
  transform: translateX(0);
}
.segment-thumb.segment-thumb-index-1 {
  transform: translateX(calc(100% + 10rpx));
}
.segment-thumb.segment-thumb-index-2 {
  transform: translateX(calc(200% + 20rpx));
}

.segment-option,
.density-option,
.tab {
  min-height: 88rpx;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  letter-spacing: var(--letter-spacing-control-sm);
  text-indent: var(--letter-spacing-control-sm);
  color: rgba(255,255,255,0.72);
  border: 1px solid transparent;
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}

/* 绑定首屏尚未选择入口时，两枚入口以等权玫瑰轻玻璃呈现；选择后由 active 接管。 */
.tab.tab-equal {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(232,144,158,0.28);
  color: rgba(255,255,255,0.92);
}

.segment-option.active,
.density-option.active,
.tab.active {
  color: var(--aurora-pink);
  background: transparent;
  border-color: transparent;
  font-weight: var(--font-weight-control);
  box-shadow: none;
  transition: background-color var(--duration-press) ease, border-color var(--duration-press) ease, color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}

.segment-option:active,
.segment-option.segment-option-hover,
.density-option:active,
.density-option.density-option-hover,
.tab:active,
.tab.tab-hover {
  transform: scale(0.98);
  background: rgba(255,255,255,0.1);
  transition: background-color var(--duration-press-in) ease, transform var(--duration-press-in) var(--ease-out);
}

.segment-option:active.active,
.segment-option.segment-option-hover.active,
.density-option:active.active,
.density-option.density-option-hover.active,
.tab:active.active,
.tab.tab-hover.active {
  transform: scale(0.98);
  background: rgba(232,144,158,0.14);
  border-color: rgba(232,144,158,0.58);
  transition: background-color var(--duration-press-in) ease, border-color var(--duration-press-in) ease, transform var(--duration-press-in) var(--ease-out);
}

@media (prefers-reduced-motion: reduce) {
  .segment-thumb,
  .segment-option,
  .segment-option.active,
  .density-option,
  .density-option.active,
  .tab,
  .tab.active {
    animation: none;
    transition: none;
  }
  .segment-option:active,
  .segment-option.segment-option-hover,
  .density-option:active,
  .density-option.density-option-hover,
  .tab:active,
  .tab.tab-hover,
  .segment-option:active.active,
  .segment-option.segment-option-hover.active,
  .density-option:active.active,
  .density-option.density-option-hover.active,
  .tab:active.active,
  .tab.tab-hover.active {
    transition: none;
  }
}
