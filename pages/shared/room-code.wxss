/* 设置页与绑定页共用房间码展示：不可点文本用主文字色，不用玫瑰色。 */
.room-code-value {
  max-width: 100%;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  font-variant-numeric: tabular-nums;
  color: var(--text-primary);
  letter-spacing: var(--letter-spacing-room-code);
  word-break: normal;
}
.room-code-value.muted {
  color: var(--text-secondary);
  font-weight: var(--font-weight-body);
  letter-spacing: 0;
  text-indent: 0;
}

/* #271：两页共用深海内凹凭证票根，房间码在左、复制操作在右。 */
.room-credential-ticket {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 30rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-md);
  background: rgba(10,14,39,0.52);
  border: 1px solid rgba(232,144,158,0.20);
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.28);
}
.room-credential-ticket .room-code-value {
  flex: 1;
  min-width: 0;
  text-align: left;
}

/* 88rpx 透明触控热区包裹 60rpx 淡玫瑰胶囊；两层都不投柔光，根除票根外粉雾。 */
.copy-btn {
  flex-shrink: 0;
  height: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  white-space: nowrap;
  background: transparent;
  color: var(--aurora-pink);
  padding: 0;
  border-radius: var(--radius-full);
  box-shadow: none;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  transition: transform var(--duration-press) var(--ease-out);
}
.copy-btn-surface {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  min-height: 60rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  background: rgba(232,144,158,0.14);
  color: var(--aurora-pink);
  border: 1px solid rgba(232,144,158,0.45);
  border-radius: var(--radius-full);
  box-shadow: none;
  white-space: nowrap;
  pointer-events: none;
}
.copy-btn::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  opacity: 0;
  box-shadow: none;
  transition: opacity var(--duration-press) ease;
  pointer-events: none;
}
.copy-btn:active,
.copy-btn.copy-btn-hover {
  transform: scale(0.94);
  transition: transform var(--duration-press-in) var(--ease-out);
}
.copy-btn:active::before,
.copy-btn.copy-btn-hover::before {
  opacity: 0;
  transition: opacity var(--duration-press-in) ease;
}

@media (prefers-reduced-motion: reduce) {
  .copy-btn,
  .copy-btn::before {
    animation: none;
    transition: none;
  }
  .copy-btn:active,
  .copy-btn.copy-btn-hover,
  .copy-btn:active::before,
  .copy-btn.copy-btn-hover::before {
    transition: none;
  }
}
