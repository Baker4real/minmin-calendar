/* 设置页与绑定页共用房间码展示：不可点文本用主文字色，不用玫瑰色。 */
.room-code-value {
  max-width: 100%;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  font-variant-numeric: tabular-nums;
  color: var(--text-primary);
  letter-spacing: var(--letter-spacing-room-code);
  word-break: break-all;
}
.room-code-value.muted {
  color: var(--text-secondary);
  font-weight: var(--font-weight-body);
  letter-spacing: 0;
  text-indent: 0;
}

/* 两页复制键共用同一种玫瑰小按钮；flex-shrink 在两页都固定为 0。 */
.copy-btn {
  flex-shrink: 0;
  min-height: 88rpx;
  box-sizing: border-box;
  white-space: nowrap;
  background: var(--aurora-pink);
  color: var(--text-on-accent);
  padding: 0 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  transition: transform var(--duration-press) var(--ease-out);
}
/* 柔光层同 .btn-premium（issue #166）：按下沉到 0.5，和缩放同一拍。 */
.copy-btn::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: var(--radius-sm);
  box-shadow: 0 8rpx 30rpx rgba(232,144,158,0.28);
  transition: opacity var(--duration-press) ease;
  pointer-events: none;
}
.copy-btn:active,
.copy-btn.copy-btn-hover {
  transform: scale(0.94);
}
.copy-btn:active::before,
.copy-btn.copy-btn-hover::before {
  opacity: 0.5;
}

@media (prefers-reduced-motion: reduce) {
  .copy-btn,
  .copy-btn::before {
    animation: none;
    transition: none;
  }
}
