/* #271 / #265: zero-request inline SVG glass hearts, sharing invitation geometry and materials. */
.brand-glass-hearts {
  position: relative;
  width: 220rpx;
  height: 190rpx;
  flex: 0 0 auto;
  pointer-events: none;
}
.brand-heart-frame,
.brand-heart-ring-echo {
  position: absolute;
  left: 35rpx;
  top: 16rpx;
  width: 150rpx;
  height: 150rpx;
  box-sizing: border-box;
  border: 1px solid rgba(196,160,210,0.22);
  border-radius: var(--radius-circle);
  box-shadow: 0 0 24rpx rgba(232,144,158,0.14);
  pointer-events: none;
}
.brand-heart-frame {
  opacity: 0.72;
}
.brand-heart {
  position: absolute;
  width: 160rpx;
  height: 164rpx;
  background-position: center;
  background-repeat: no-repeat;
  background-size: 100% 100%;
  pointer-events: none;
}
