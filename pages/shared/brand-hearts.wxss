.brand-heart-secondary-echo,
.brand-heart-ring-echo {
  opacity: 0;
  pointer-events: none;
}
.brand-heart-secondary-echo {
  position: absolute;
  left: 54rpx;
  top: 0;
  z-index: 3;
  width: 160rpx;
  height: 164rpx;
}
.brand-heart-secondary-echo .brand-heart-echo-asset {
  left: 0;
  top: 0;
}
.hero.hero-bloom .brand-heart-secondary-echo,
.hero.hero-bloom .brand-heart-ring-echo {
  opacity: 0;
  pointer-events: none;
  animation: heroBloom var(--duration-emphasis) var(--ease-out) both;
}
@keyframes heroBloom {
  from {
    opacity: 0.6;
    transform: scale(1);
  }
  to {
    opacity: 0;
    transform: scale(1.6);
  }
}
@media (prefers-reduced-motion: reduce) {
  .hero.hero-bloom .brand-heart-secondary-echo,
  .hero.hero-bloom .brand-heart-ring-echo {
    animation: none;
  }
}
