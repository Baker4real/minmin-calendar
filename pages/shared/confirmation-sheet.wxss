/* 全部底部弹层的共享几何与标题 chrome；正文样式仍归各页面。 */
.sheet-host {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  padding: 0 20rpx;
  box-sizing: border-box;
  pointer-events: none;
}
.sheet-host.month-jump-mask {
  z-index: 62;
}
.sheet-host.calendar-info-sheet {
  z-index: 64;
}
.day-sheet-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: auto;
  box-sizing: border-box;
  background: rgba(10,14,39,0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  opacity: 0;
  transition: opacity var(--duration-exit) var(--ease-out);
}
.day-sheet-mask::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(10,14,39,0);
  transition: background-color var(--duration-press) ease;
  pointer-events: none;
}
.day-sheet-mask:active::after,
.day-sheet-mask.day-sheet-mask-hover::after {
  background-color: rgba(10,14,39,0.28);
}
.day-sheet-mask.sheet-open {
  opacity: 1;
  transition: opacity var(--duration-enter) var(--ease-out);
}
.day-sheet-mask.sheet-leaving,
.sheet-slide.sheet-leaving {
  pointer-events: none;
}
.sheet-slide {
  position: relative;
  z-index: 1;
  width: 100%;
  padding-bottom: 20rpx;
  box-sizing: border-box;
  pointer-events: auto;
  transform: translateY(100%);
  transition: transform var(--duration-exit) var(--ease-out);
}
.sheet-slide.sheet-open {
  transform: translateY(0);
  transition: transform var(--duration-sheet) var(--ease-out);
}
.sheet-slide.sheet-open.sheet-reset {
  transition: transform var(--duration-exit) var(--ease-out);
}
.day-action-sheet,
.confirmation-panel {
  width: 100%;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 18rpx 28rpx 22rpx;
  padding-bottom: calc(22rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  box-sizing: border-box;
  background:
    linear-gradient(160deg, rgba(232,144,158,0.12), rgba(196,160,210,0.08) 42%, rgba(18,22,61,0.94) 100%),
    rgba(18,22,61,0.94);
  border: 1px solid rgba(255,255,255,0.16);
  border-radius: var(--radius-xl) var(--radius-xl) var(--radius-lg) var(--radius-lg);
  box-shadow:
    0 -18rpx 48rpx rgba(0,0,0,0.34),
    inset 0 1rpx 0 rgba(255,255,255,0.18);
}
.calendar-jump-sheet {
  max-height: 86vh;
  padding-bottom: calc(24rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  background:
    linear-gradient(160deg, rgba(232,144,158,0.14), rgba(196,160,210,0.08) 45%, rgba(18,22,61,0.96) 100%),
    rgba(18,22,61,0.96);
}
.calendar-info-panel {
  max-height: 84vh;
}
.sheet-drag-zone {
  flex: 0 0 auto;
}
.sheet-handle {
  width: 70rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.22);
  transition: background-color var(--duration-press) ease;
}
.sheet-drag-zone:active .sheet-handle,
.sheet-drag-zone.sheet-drag-zone-hover .sheet-handle {
  background-color: rgba(232,144,158,0.55);
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.sheet-date-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.sheet-title {
  min-width: 0;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-title);
  line-height: var(--line-height-snug);
  letter-spacing: var(--letter-spacing-display);
  color: rgba(255,255,255,0.92);
  word-break: normal;
  overflow-wrap: normal;
}
.sheet-subtitle {
  min-width: 0;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.72);
  overflow-wrap: normal;
}
.sheet-close {
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: transparent;
  transition: transform var(--duration-press) var(--ease-out);
}
.sheet-close-surface {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: 1;
  text-align: center;
  border-radius: var(--radius-circle);
  color: rgba(255,255,255,0.92);
  background: var(--glass-bg);
  border: 1px solid rgba(255,255,255,0.12);
  transition: background-color var(--duration-press) ease;
}
.sheet-close:active,
.sheet-close.sheet-close-hover {
  transform: scale(0.96);
}
.sheet-close:active .sheet-close-surface,
.sheet-close.sheet-close-hover .sheet-close-surface {
  background: rgba(255,255,255,0.14);
}
.confirmation-date {
  display: block;
  margin-bottom: 12rpx;
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-assist);
  font-variant-numeric: tabular-nums;
  color: rgba(255,255,255,0.92);
}
.confirmation-copy {
  display: block;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: var(--text-secondary);
  overflow-wrap: normal;
}
.confirmation-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 32rpx;
}
.confirmation-action {
  width: 100%;
  box-sizing: border-box;
}
.confirmation-secondary {
  min-height: 88rpx;
  padding: 20rpx 28rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-title);
  color: var(--aurora-pink);
  background: transparent;
  border: 1px solid rgba(232,144,158,0.45);
  transition: background-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.confirmation-secondary:active,
.confirmation-secondary.confirmation-secondary-hover {
  transform: scale(0.96);
  background-color: rgba(232,144,158,0.08);
}
.date-picker-columns {
  position: relative;
  overflow: hidden;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: linear-gradient(rgba(255,255,255,0.06), rgba(255,255,255,0.06)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.12);
}
.date-picker-columns::before,
.date-picker-columns::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  z-index: 1;
  height: var(--date-picker-mask-height);
  background-repeat: no-repeat;
  pointer-events: none;
}
.date-picker-columns::before {
  top: 0;
  background-image: linear-gradient(to bottom, var(--glass-fallback) 0%, rgba(18,22,61,0) 100%);
}
.date-picker-columns::after {
  bottom: 0;
  background-image: linear-gradient(to top, var(--glass-fallback) 0%, rgba(18,22,61,0) 100%);
}
.date-picker-view {
  position: relative;
  width: 100%;
}
.date-picker-column {
  text-align: center;
}
.date-picker-option {
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-body);
  font-variant-numeric: tabular-nums;
  color: var(--text-primary);
}
button.date-picker-confirm {
  width: 100%;
  box-sizing: border-box;
  margin: 24rpx 0 0;
  line-height: var(--line-height-body);
  border: 0;
  background: var(--aurora-pink);
  color: var(--text-on-accent);
  overflow: visible;
}
button.date-picker-confirm[disabled] {
  background: var(--aurora-pink);
  color: var(--text-on-accent);
}
button.date-picker-confirm::after {
  border: 0;
}
.reduced-motion-probe {
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
  pointer-events: none;
}
@media (prefers-reduced-motion: reduce) {
  .reduced-motion-probe {
    width: 1px;
  }
  .day-sheet-mask,
  .day-sheet-mask::after,
  .day-sheet-mask.sheet-open,
  .sheet-slide,
  .sheet-slide.sheet-open,
  .sheet-slide.sheet-open.sheet-reset,
  .sheet-close,
  .sheet-close-surface,
  .sheet-handle,
  .confirmation-secondary {
    transition: none;
  }
}
