@import './form-control.wxss';

/* 两个编辑页逐字相同的表单、草稿与保存/删除规则（issue #236）。 */
.form-item {
  margin-bottom: 36rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
}
.form-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.form-label-row .form-label {
  margin-bottom: 0;
}
.note-count {
  flex-shrink: 0;
  font-size: var(--font-size-caption);
  font-variant-numeric: tabular-nums;
  line-height: var(--line-height-assist);
  color: var(--text-secondary);
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  padding: 22rpx;
  background: linear-gradient(rgba(255,255,255,0.06), rgba(255,255,255,0.06)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.12);
  transition: border-color var(--duration-press) ease;
}
.form-picker-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
  line-height: 1;
}
/* 按下只换玫瑰描边，和输入框焦点同一种 1px 实线、不加光晕（issue #81、#166） */
.form-picker:active,
.form-picker.form-picker-hover {
  border-color: rgba(232,144,158,0.4);
}
/* 保存中日期选择器停用：字段跟着变淡、不再亮描边，和状态芯片同一档（issue #166） */
.form-picker.disabled {
  opacity: 0.5;
  pointer-events: none;
}
.form-input {
  min-height: 88rpx;
  font-size: var(--font-size-body-lg);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  padding: 22rpx;
  background: linear-gradient(rgba(255,255,255,0.06), rgba(255,255,255,0.06)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.12);
  transition: border-color var(--duration-state) ease;
}
.form-input.disabled {
  opacity: 0.5;
  pointer-events: none;
}
/* R10：焦点描边由 shared/form-control.wxss 的 form-control-focused 统一绘制，不加光晕。 */
.input-placeholder {
  line-height: var(--line-height-body);
}

/* 草稿恢复与开始日归属共用玫瑰微提示条；操作热区不撑开正文行。 */
.micro-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  background: rgba(232,144,158,0.08);
  border: 1px solid rgba(232,144,158,0.24);
  border-radius: var(--radius-md);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--text-secondary);
}
.micro-notice-text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.micro-notice-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  min-height: 88rpx;
  margin: -16rpx;
  padding: 16rpx;
  color: var(--aurora-pink);
}
.draft-notice {
  margin-bottom: 24rpx;
}
.draft-discard,
.start-date-owner-action {
  transition: transform var(--duration-press) var(--ease-out);
}
.draft-discard {
  color: var(--aurora-pink);
}
.draft-discard:active,
.draft-discard.draft-discard-hover {
  transform: scale(0.96);
}

/* Buttons：删除留在滚动流末尾；保存使用两页共用的单按钮固定栏。 */
.btns {
  margin-top: var(--space-page-block-gap);
}
.record-actions-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: var(--space-page-block-gap) var(--space-page-gutter) calc(24rpx + var(--safe-bottom, env(safe-area-inset-bottom, 0px)));
  background: linear-gradient(180deg, rgba(10,14,39,0.96) 0%, var(--aurora-bg) 48rpx, var(--aurora-bg) 100%);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 -12rpx 32rpx rgba(5,8,22,0.55);
}
.record-actions-fixed .btns {
  margin-top: 0;
}
.record-actions-fixed.record-actions-hidden {
  display: none;
}
.btn-premium,
.btn-danger {
  line-height: var(--line-height-assist);
}
.delete-zone {
  margin-top: var(--space-xxl);
  padding-top: var(--space-md);
  border-top: 1px solid var(--glass-border);
}

@media (prefers-reduced-motion: reduce) {
  .form-picker,
  .form-input,
  .draft-discard,
  .start-date-owner-action {
    transition: none;
  }
}
