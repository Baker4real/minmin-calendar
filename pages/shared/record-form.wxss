@import './form-control.wxss';

/* 两个编辑页逐字相同的表单、草稿与保存/删除规则（issue #236）。 */
.form-item {
  margin-bottom: 36rpx;
}
.form-item:last-child {
  margin-bottom: 0;
}
.form-label {
  font-size: var(--font-size-caption);
  color: var(--text-secondary);
  display: block;
  margin-bottom: 12rpx;
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  font-size: var(--font-size-input);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  padding: 22rpx;
  background: linear-gradient(rgba(255,255,255,0.06), rgba(255,255,255,0.06)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.12);
  transition: border-color var(--duration-press) ease;
}
.form-picker-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
  line-height: 1;
}
/* 按下只换玫瑰描边，和输入框焦点同一种 1px 实线、不加光晕（issue #81、#166） */
.form-picker:active,
.form-picker.form-picker-hover {
  border-color: rgba(232,144,158,0.4);
}
/* 保存中日期选择器停用：字段跟着变淡、不再亮描边，和状态芯片同一档（issue #166） */
.form-picker.disabled {
  opacity: 0.5;
  pointer-events: none;
}
.form-input {
  min-height: 88rpx;
  font-size: var(--font-size-input);
  font-weight: var(--font-weight-body);
  line-height: var(--line-height-body);
  color: rgba(255,255,255,0.85);
  padding: 22rpx;
  background: linear-gradient(rgba(255,255,255,0.06), rgba(255,255,255,0.06)), var(--glass-fallback);
  border: 1px solid rgba(255,255,255,0.12);
  transition: border-color var(--duration-state) ease;
}
/* 备注输入焦点：登记的 1px 实线玫瑰描边（基线边框本就是 1px solid），不加光晕（issue #81） */
.form-input:focus {
  border-color: #E8909E;
}
.input-placeholder {
  line-height: var(--line-height-body);
}

/* 草稿恢复说明常驻并主动播报；只有可点的放弃操作使用玫瑰色 */
.draft-notice {
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  color: var(--text-secondary);
  margin-bottom: 24rpx;
}
.draft-discard {
  display: inline-block;
  color: var(--aurora-pink);
  transition: transform var(--duration-press) var(--ease-out);
}
.draft-discard:active,
.draft-discard.draft-discard-hover {
  transform: scale(0.96);
}

/* Buttons：保存紧跟表单卡，一个块间距；删除另在下方危险区（issue #164） */
.btns {
  margin-top: 20rpx;
}
.btn-premium,
.btn-danger {
  line-height: var(--line-height-assist);
}
.delete-zone {
  margin-top: var(--space-xxl);
  padding-top: var(--space-md);
  border-top: 1px solid var(--glass-border);
}

@media (prefers-reduced-motion: reduce) {
  .form-picker,
  .form-input,
  .draft-discard {
    transition: none;
  }
}
