/* Shared fixed navbar for all seven pages. */
.nav-bar {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  height: var(--nav-bar-height, calc(env(safe-area-inset-top, 44px) + 44px));
  padding-top: var(--safe-top, env(safe-area-inset-top, 44px));
  padding-right: var(--capsule-right, 96px);
  padding-bottom: 0;
  padding-left: 30rpx;
}
.nav-title {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  padding-left: var(--nav-title-padding-left, 0px);
  padding-right: var(--nav-title-padding-right, 0px);
  text-align: center;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-title);
  letter-spacing: var(--letter-spacing-display);
  text-indent: var(--letter-spacing-display);
  color: rgba(255,255,255,0.92);
}
.nav-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  text-align: center;
  line-height: 1;
  color: rgba(255,255,255,0.92);
  background: transparent;
  transition: transform var(--duration-press) var(--ease-out);
  position: relative;
  z-index: 11;
}
.nav-back-surface {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  left: 12rpx;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  background: var(--glass-bg);
  border: 1px solid rgba(255,255,255,0.28);
  pointer-events: none;
  transition: background-color var(--duration-press) ease, border-color var(--duration-press) ease;
  z-index: 0;
}
.nav-back-icon {
  position: relative;
  z-index: 1;
  display: block;
  line-height: 1;
  transform: translateY(-1rpx);
}
.nav-back:active,
.nav-back.nav-back-hover {
  transform: scale(0.94);
}
.nav-back:active .nav-back-surface,
.nav-back.nav-back-hover .nav-back-surface {
  background: rgba(255,255,255,0.12);
  border-color: rgba(255,255,255,0.42);
}
.nav-placeholder { width: 0; flex-shrink: 0; }

/* The fixed transparent ledger slot (at least 88rpx) owns interaction; only the inner capsule paints. */
.nav-tool {
  min-width: 88rpx;
  width: calc(96rpx + 2px);
  height: 88rpx;
  flex-shrink: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 0;
  background: transparent;
  color: rgba(255,255,255,0.92);
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-control);
  line-height: 1;
  transition: transform var(--duration-press) var(--ease-out);
}
.nav-tool-surface {
  height: 64rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--radius-full);
  border: 1px solid rgba(255,255,255,0.28);
  background: var(--glass-bg);
  white-space: nowrap;
  pointer-events: none;
  transition: background-color var(--duration-press) ease;
}
.nav-tool:active,
.nav-tool.nav-tool-hover {
  transform: scale(0.96);
}
.nav-tool:active .nav-tool-surface,
.nav-tool.nav-tool-hover .nav-tool-surface {
  background: rgba(255,255,255,0.12);
}

.header-gradient {
  background: linear-gradient(180deg, rgba(10,14,39,0.92) 0%, rgba(18,22,61,0.88) 100%);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  overflow: hidden;
  z-index: 10;
}
.header-gradient.nav-bar-immersive {
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border-bottom: 0;
}
.header-gradient.nav-bar-immersive::before,
.header-gradient.nav-bar-immersive::after {
  content: none;
  display: none;
}
.header-gradient::before {
  content: '';
  pointer-events: none;
  position: absolute;
  top: -40%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(232,144,158,0.2) 0%, transparent 60%);
  border-radius: var(--radius-circle);
  animation: float 8s ease-in-out infinite alternate;
}
.header-gradient::after {
  content: '';
  pointer-events: none;
  position: absolute;
  bottom: -20%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(196,160,210,0.1) 0%, transparent 60%);
  border-radius: var(--radius-circle);
  animation: float 6s ease-in-out infinite alternate-reverse;
}
@keyframes float {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(20rpx, -20rpx) scale(1.1); }
}

.page.page-obscured .header-gradient::before,
.page.page-obscured .header-gradient::after,
.page.page-hidden .header-gradient::before,
.page.page-hidden .header-gradient::after {
  animation-play-state: paused;
}

/* The page root injects these values from utils/safeArea.js. */
.safe-top { padding-top: var(--nav-bar-height, calc(env(safe-area-inset-top, 44px) + 44px)); }

@media (prefers-reduced-motion: reduce) {
  .header-gradient::before,
  .header-gradient::after {
    animation: none;
  }
  .nav-back,
  .nav-back-surface,
  .nav-tool,
  .nav-tool-surface {
    animation: none;
    transition: none;
  }
}
