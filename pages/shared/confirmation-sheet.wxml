<wxs module="sheetDrag" src="../../utils/sheetDrag.wxs"></wxs>
<template name="sharedBottomSheet">
  <view wx:if="{{sheetMounted}}" class="sheet-host {{sheetHostClass}}">
    <view class="day-sheet-mask sheet-{{sheetPhase}}" bindtap="{{maskHandler}}" catchtouchmove="noop" aria-role="button" aria-label="关闭{{sheetName}}" hover-start-time="20" hover-stay-time="70" hover-class="day-sheet-mask-hover"></view>
    <view class="sheet-slide sheet-slide-{{sheetId}} sheet-{{sheetPhase}}" change:reset="{{sheetDrag.clearInline}}" reset="{{sheetDragClear}}">
      <view class="day-action-sheet {{sheetPanelClass}}" catchtap="noop" aria-label="{{sheetName}}">
        <view class="sheet-drag-zone" data-sheet="{{sheetId}}" bindtouchstart="{{sheetDrag.touchStart}}" bindtouchmove="{{sheetDrag.touchMove}}" bindtouchend="{{sheetDrag.touchEnd}}" bindtouchcancel="{{sheetDrag.touchCancel}}" hover-start-time="20" hover-stay-time="70" hover-class="sheet-drag-zone-hover">
          <view class="sheet-handle" aria-hidden="true"></view>
          <view class="sheet-head">
            <view class="sheet-date-copy">
              <text class="text-pair-title sheet-title">{{sheetTitle}}</text>
              <text wx:if="{{sheetSubtitle}}" class="text-pair-desc sheet-subtitle">{{sheetSubtitle}}</text>
            </view>
            <view class="sheet-close" bindtap="{{closeHandler}}" aria-role="button" aria-label="关闭{{sheetName}}" hover-start-time="20" hover-stay-time="70" hover-class="sheet-close-hover">
              <view class="sheet-close-surface">
                <view class="ui-icon ui-icon-close ui-icon-36" aria-hidden="true"></view>
              </view>
            </view>
          </view>
        </view>
        <scroll-view class="sheet-body" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
          <template is="{{bodyTemplate}}" data="{{year: year, month: month, jumpYear: jumpYear, jumpMonth: jumpMonth, jumpYearAtMin: jumpYearAtMin, jumpYearAtMax: jumpYearAtMax, jumpMonths: jumpMonths, selectedDayDetail: selectedDayDetail, daySheetMode: daySheetMode, dayDetailFade: dayDetailFade, periodBandSample: periodBandSample, calendarDensity: calendarDensity, infoSheetMode: infoSheetMode, predictionExplanation: predictionExplanation, monthlyRecap: monthlyRecap, legendItems: legendItems, helpTopics: helpTopics, confirmationDateText: confirmationDateText, confirmationContent: confirmationContent, confirmationActions: confirmationActions, datePickerName: datePickerName, datePickerYears: datePickerYears, datePickerMonths: datePickerMonths, datePickerDays: datePickerDays, datePickerValue: datePickerValue, datePickerPicking: datePickerPicking, datePickerRowHeight: datePickerRowHeight, datePickerHeight: datePickerHeight, datePickerMaskHeight: datePickerMaskHeight, datePickerIndicatorTop: datePickerIndicatorTop, datePickerYearAria: datePickerYearAria, datePickerMonthAria: datePickerMonthAria, datePickerDayAria: datePickerDayAria, datePickerConfirmAria: datePickerConfirmAria}}" />
        </scroll-view>
      </view>
    </view>
  </view>
</template>

<!-- 每页只挂一份：减弱动效探针，以及任一弹层卸载前的系统返回拦截。page-meta 不能放进 <template>，由各页直接写在根节点首位。 -->
<template name="sharedSheetPage">
  <view class="reduced-motion-probe" aria-hidden="true"></view>
  <page-container
    wx:if="{{sheetExitGuard}}"
    show="{{true}}"
    overlay="{{false}}"
    duration="0"
    z-index="1"
    position="bottom"
    custom-style="height:0;width:0;overflow:hidden;opacity:0;pointer-events:none;background:transparent;"
    bindbeforeleave="onSheetSystemBack"
  ></page-container>
</template>

<template name="monthPickerSheetBody">
  <view
    class="jump-today"
    bindtap="jumpToToday"
    aria-role="button"
    aria-label="回到今天所在月份" hover-start-time="20" hover-stay-time="70" hover-class="jump-today-hover">
    <text class="jump-today-label">回到今天</text>
    <text class="jump-today-date">定位到当前月份</text>
  </view>

  <view class="jump-section">
    <text class="jump-section-title">年份</text>
    <view class="jump-year-stepper">
      <view
        class="jump-year-step {{jumpYearAtMin ? 'disabled' : ''}}"
        data-delta="-1"
        bindtap="shiftJumpYear"
        aria-role="button"
        aria-label="上一年"
        aria-disabled="{{jumpYearAtMin}}" hover-start-time="20" hover-stay-time="70" hover-class="jump-year-step-hover">
        <view class="ui-icon ui-icon-left ui-icon-28 ui-icon-circle" aria-hidden="true"></view>
      </view>
      <text class="jump-year-value">{{jumpYear}}年</text>
      <view
        class="jump-year-step {{jumpYearAtMax ? 'disabled' : ''}}"
        data-delta="1"
        bindtap="shiftJumpYear"
        aria-role="button"
        aria-label="下一年"
        aria-disabled="{{jumpYearAtMax}}" hover-start-time="20" hover-stay-time="70" hover-class="jump-year-step-hover">
        <view class="ui-icon ui-icon-right ui-icon-28 ui-icon-circle" aria-hidden="true"></view>
      </view>
    </view>
  </view>

  <view class="jump-section">
    <text class="jump-section-title">月份</text>
    <view class="jump-month-grid" aria-role="radiogroup" aria-label="月份">
      <view
        class="jump-option {{jumpYear == year && item.value == jumpMonth ? 'active' : ''}} {{item.isRealTodayMonth ? 'real-today' : ''}}"
        wx:for="{{jumpMonths}}"
        wx:key="value"
        data-month="{{item.value}}"
        bindtap="selectJumpMonth"
        aria-role="radio"
        aria-label="选择{{item.label}}{{item.isRealTodayMonth ? '，本月' : ''}}"
        aria-checked="{{jumpYear == year && item.value == jumpMonth}}" hover-start-time="20" hover-stay-time="70" hover-class="jump-option-hover">{{item.label}}<view wx:if="{{item.isRealTodayMonth}}" class="jump-real-today-dot" aria-hidden="true"></view></view>
    </view>
  </view>
</template>

<template name="dayActionsSheetBody">
  <view wx:if="{{(selectedDayDetail.meanings && selectedDayDetail.meanings.length) || selectedDayDetail.futureNotice}}" class="detail-meaning-list">
    <view
      wx:for="{{selectedDayDetail.meanings}}"
      wx:key="key"
      class="detail-meaning {{item.key}}"
    >
      <text class="text-pair-title detail-meaning-title">{{item.title}}</text>
      <text class="text-pair-desc detail-meaning-text">{{item.text}}</text>
    </view>
    <view wx:if="{{selectedDayDetail.futureNotice}}" class="empty-state day-detail-empty future-notice">
      <text class="text-pair-title detail-empty-title">{{selectedDayDetail.futureNotice.title}}</text>
      <text class="text-pair-desc detail-empty-desc">{{selectedDayDetail.futureNotice.text}}</text>
    </view>
  </view>

  <view wx:if="{{daySheetMode == 'detail'}}" class="day-detail-list {{dayDetailFade ? 'day-detail-fade' : ''}}">
    <view
      wx:for="{{selectedDayDetail.periods}}"
      wx:key="key"
      class="day-detail-row period-detail"
      data-kind="period"
      data-id="{{item.recordId}}"
      bindtap="onDayRecordTap"
      aria-role="button"
      aria-label="{{item.ariaLabel}}"
      hover-start-time="20" hover-stay-time="70" hover-class="day-detail-row-hover"
    >
      <view class="detail-rail"></view>
      <view class="detail-copy">
        <text class="text-pair-title detail-title">经期</text>
        <text class="text-pair-desc detail-main">{{item.range}}</text>
        <text wx:if="{{item.metaText}}" class="text-pair-desc detail-meta">{{item.metaText}}</text>
        <text wx:if="{{item.note}}" class="text-pair-desc detail-meta detail-note">{{item.note}}</text>
        <text wx:if="{{item.authorLabel}}" class="text-pair-desc detail-meta">{{item.authorLabel}}</text>
      </view>
      <view class="ui-icon ui-icon-right ui-icon-24 detail-arrow" aria-hidden="true"></view>
    </view>

    <view
      wx:for="{{selectedDayDetail.memories}}"
      wx:key="key"
      class="day-detail-row memory-detail"
      data-kind="memory"
      data-id="{{item.recordId}}"
      bindtap="onDayRecordTap"
      aria-role="button"
      aria-label="{{item.ariaLabel}}"
      hover-start-time="20" hover-stay-time="70" hover-class="day-detail-row-hover"
    >
      <view class="detail-rail"></view>
      <view class="detail-copy">
        <text class="text-pair-title detail-title">欢乐时光</text>
        <text class="text-pair-desc detail-main">{{item.note}}</text>
        <text wx:if="{{item.authorLabel}}" class="text-pair-desc detail-meta">{{item.authorLabel}}</text>
      </view>
      <view class="ui-icon ui-icon-right ui-icon-24 detail-arrow" aria-hidden="true"></view>
    </view>
  </view>

  <view wx:if="{{selectedDayDetail.actions && selectedDayDetail.actions.length}}" class="sheet-actions {{daySheetMode == 'detail' ? 'compact-actions' : ''}}">
    <view
      wx:for="{{selectedDayDetail.actions}}"
      wx:key="key"
      class="sheet-action {{daySheetMode == 'detail' ? 'compact' : ''}}"
      data-action="{{item.key}}"
      bindtap="onDayActionTap"
      aria-role="button"
      aria-label="{{item.label}}"
      hover-start-time="20" hover-stay-time="70" hover-class="sheet-action-hover"
    >
      <view wx:if="{{item.key == 'period'}}" class="sheet-action-icon sample-plate">
        <template is="periodBandSample" data="{{...periodBandSample, calendarDensity: calendarDensity}}" />
      </view>
      <text wx:else class="sheet-action-icon memory-tone">♥</text>
      <view class="sheet-action-copy">
        <text class="sheet-action-title">{{item.label}}</text>
      </view>
      <view wx:if="{{daySheetMode != 'detail'}}" class="ui-icon ui-icon-right ui-icon-24 sheet-action-arrow" aria-hidden="true"></view>
    </view>
  </view>
</template>

<template name="infoSheetBody">
  <view wx:if="{{infoSheetMode == 'legend'}}" class="legend-list">
    <view wx:for="{{legendItems}}" wx:key="key" class="legend-row">
      <view class="legend-sample day-cell {{item.cellClass}} calendar-density-{{calendarDensity}}">
        <block wx:for="{{item.parts}}" wx:for-item="part" wx:key="className">
          <view wx:if="{{part.kind == 'band' || part.kind == 'num' || part.kind == 'mark'}}" class="{{part.className}}">{{part.text}}</view>
          <text wx:elif="{{part.kind == 'tag'}}" class="{{part.className}}">{{part.text}}</text>
        </block>
      </view>
      <view class="legend-copy">
        <text class="text-pair-title legend-title">{{item.title}}</text>
        <text class="text-pair-desc legend-text">{{item.text}}</text>
      </view>
    </view>
    <text class="text-pair-desc explain-line legend-help">更多用法请前往「设置 → 使用说明」。</text>
  </view>

  <view wx:elif="{{infoSheetMode == 'prediction'}}" class="prediction-explanation">
    <view class="prediction-hero">
      <text class="text-pair-title prediction-summary">{{predictionExplanation.summary}}</text>
    </view>
    <text
      wx:for="{{predictionExplanation.lineItems}}"
      wx:key="key"
      class="text-pair-desc explain-line"
    >{{item.text}}</text>
    <view
      wx:if="{{predictionExplanation.periodAction}}"
      class="btn-premium prediction-period-action button-primary"
      bindtap="quickPeriod"
      aria-role="button"
      aria-label="{{predictionExplanation.periodAction.label}}"
      hover-start-time="20" hover-stay-time="70" hover-class="btn-premium-hover"
    >{{predictionExplanation.periodAction.label}}</view>
  </view>

  <view wx:elif="{{infoSheetMode == 'recap' && monthlyRecap}}" class="monthly-recap">
    <view class="recap-overview">
      <text class="text-pair-title recap-summary recap-main">{{monthlyRecap.periodSummary}}</text>
      <text class="text-pair-desc recap-summary">{{monthlyRecap.memorySummary}}</text>
      <text class="text-pair-desc recap-summary">{{monthlyRecap.predictionSummary}}</text>
    </view>
    <view wx:if="{{monthlyRecap.highlightItems.length}}" class="recap-highlights">
      <view
        wx:for="{{monthlyRecap.highlightItems}}"
        wx:key="key"
        class="recap-highlight-row recap-highlight-{{item.kind}}"
        aria-label="{{item.text}}"
      >
        <text class="recap-date-badge" aria-hidden="true">{{item.dateBadge}}</text>
        <text class="text-pair-desc recap-highlight" aria-hidden="true">{{item.summary}}</text>
      </view>
    </view>
    <view class="copy-recap button-primary" bindtap="copyMonthlyRecap" aria-role="button" aria-label="复制小结" hover-start-time="20" hover-stay-time="70" hover-class="copy-recap-hover">复制小结</view>
  </view>
</template>

<template name="settingsHelpSheetBody">
  <view wx:for="{{helpTopics}}" wx:key="key" class="help-topic">
    <text class="help-topic-title">{{item.title}}</text>
    <text wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="help-copy">{{paragraph}}</text>
  </view>
</template>

<template name="datePickerSheetBody">
  <view class="date-picker-columns" style="height: {{datePickerHeight}}px; --date-picker-mask-height: {{datePickerMaskHeight}}px;">
    <picker-view class="date-picker-view" style="height: {{datePickerHeight}}px;" value="{{datePickerValue}}" bindchange="onDatePickerChange" bindpickstart="onDatePickerPickStart" bindpickend="onDatePickerPickEnd" immediate-change="{{true}}" mask-style="background-image: none; border: 0;" indicator-style="height: {{datePickerRowHeight}}px; top: {{datePickerIndicatorTop}}px; box-sizing: border-box; background-color: rgba(232,144,158,0.10); border: 0; border-top: 1px solid rgba(232,144,158,0.32); border-bottom: 1px solid rgba(232,144,158,0.32);" aria-role="listbox" aria-label="{{datePickerName}}">
      <picker-view-column class="date-picker-column" aria-label="{{datePickerYearAria}}">
        <view wx:for="{{datePickerYears}}" wx:key="value" class="date-picker-option" style="height: {{datePickerRowHeight}}px; line-height: {{datePickerRowHeight}}px;">{{item.label}}</view>
      </picker-view-column>
      <picker-view-column class="date-picker-column" aria-label="{{datePickerMonthAria}}">
        <view wx:for="{{datePickerMonths}}" wx:key="value" class="date-picker-option" style="height: {{datePickerRowHeight}}px; line-height: {{datePickerRowHeight}}px;">{{item.label}}</view>
      </picker-view-column>
      <picker-view-column class="date-picker-column" aria-label="{{datePickerDayAria}}">
        <view wx:for="{{datePickerDays}}" wx:key="value" class="date-picker-option" style="height: {{datePickerRowHeight}}px; line-height: {{datePickerRowHeight}}px;">{{item.label}}</view>
      </picker-view-column>
    </picker-view>
  </view>
  <button class="btn-premium button-primary date-picker-confirm {{datePickerPicking ? 'disabled' : ''}}" bindtap="onDatePickerConfirm" disabled="{{datePickerPicking}}" aria-role="button" aria-disabled="{{datePickerPicking}}" aria-label="{{datePickerConfirmAria}}" hover-start-time="20" hover-stay-time="70" hover-class="btn-premium-hover">确定</button>
</template>

<template name="confirmationSheetBody">
  <text wx:if="{{confirmationDateText}}" class="confirmation-date">{{confirmationDateText}}</text>
  <text class="confirmation-copy">{{confirmationContent}}</text>
  <view class="confirmation-actions">
    <block wx:for="{{confirmationActions}}" wx:key="id">
      <view wx:if="{{item.kind === 'danger'}}" class="btn-danger confirmation-action button-danger" bindtap="onConfirmationAction" data-action="{{item.id}}" aria-role="button" aria-label="{{item.text}}" hover-start-time="20" hover-stay-time="70" hover-class="btn-danger-hover">{{item.text}}</view>
      <view wx:elif="{{item.kind === 'primary'}}" class="btn-premium confirmation-action button-primary" bindtap="onConfirmationAction" data-action="{{item.id}}" aria-role="button" aria-label="{{item.text}}" hover-start-time="20" hover-stay-time="70" hover-class="btn-premium-hover">{{item.text}}</view>
      <view wx:else class="confirmation-secondary confirmation-action button-outline" bindtap="onConfirmationAction" data-action="{{item.id}}" aria-role="button" aria-label="{{item.text}}" hover-start-time="20" hover-stay-time="70" hover-class="confirmation-secondary-hover">{{item.text}}</view>
    </block>
  </view>
</template>

<!-- 记经期动作的图标：首页记录入口与当日动作共用同一段单日色带。 -->
<template name="periodBandSample">
  <view class="action-sample day-cell {{cellClass}} calendar-density-{{calendarDensity}}">
    <view wx:for="{{parts}}" wx:for-item="part" wx:key="className" class="{{part.className}}"></view>
  </view>
</template>
