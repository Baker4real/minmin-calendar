/* 输入控件共同盒结构；字号、颜色、边框、背景与间距由使用方修饰类保留（issue #236）。 */
.form-control {
  box-sizing: border-box;
  width: 100%;
  border-radius: var(--radius-sm);
  transition: border-color var(--duration-state) ease, box-shadow var(--duration-state) ease;
}

/* R10：原生 :focus 未稳定画出描边，由控件自己的 bindfocus/bindblur 切换此类。
   默认态承担双向过渡，聚焦与失焦都不另换时序。 */
.form-control.form-control-focused {
  border-color: var(--aurora-pink);
}

@media (prefers-reduced-motion: reduce) {
  .form-control {
    transition: none;
  }
}
