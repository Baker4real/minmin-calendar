#!/bin/sh
# Pre-commit guardrail: the same checks CI runs on push to main, run before the commit lands.
# Enable once per clone: git config core.hooksPath .githooks
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# --tracked checks only files in the index, so another session's untracked files in a shared work tree stay out.
npm run verify -- --tracked

echo "pre-commit: git diff --cached --check"
git diff --cached --check
