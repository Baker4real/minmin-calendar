// 全部底部弹层共用跟手。只在视图层改面板 transform，松手把位移、最近 80ms 瞬时速度、面板高度交给页面。

var START_PX = 10
var RUBBER = 0.55
var VELOCITY_WINDOW_MS = 80
var pendingClearBySheet = {}

function touchStart(event, ownerInstance) {
  var panel = findPanel(event, ownerInstance)
  if (!panel) return
  var state = panel.getState()
  if (state.dragging || state.tracking) return
  var touch = event.touches && event.touches[0]
  if (!touch) return
  state.tracking = true
  state.dragging = false
  state.identifier = touch.identifier
  state.startY = touch.pageY
  state.startTime = event.timeStamp
  state.samples = [{ y: touch.pageY, time: event.timeStamp }]
  state.sheet = sheetName(event)
  // A new gesture owns the panel now; any clear queued by the previous gesture is stale.
  pendingClearBySheet[state.sheet] = null
  state.panelHeight = readHeight(panel)
  state.displacement = 0
}

function touchMove(event, ownerInstance) {
  var panel = findPanel(event, ownerInstance)
  if (!panel) return
  var state = panel.getState()
  if (!state.tracking) return
  var touch = findTouch(event.touches, state.identifier)
  if (!touch) return
  recordSample(state, touch.pageY, event.timeStamp)
  var delta = touch.pageY - state.startY
  if (!state.dragging) {
    if (!(delta > START_PX || delta < -START_PX)) return
    state.dragging = true
    if (!(state.panelHeight > 0)) state.panelHeight = readHeight(panel)
  }
  var displacement = delta > 0 ? delta : rubberBand(delta, state.panelHeight)
  state.displacement = displacement
  panel.setStyle({
    transform: 'translateY(' + displacement + 'px)',
    '-webkit-transform': 'translateY(' + displacement + 'px)',
    transition: 'none',
    '-webkit-transition': 'none'
  })
  return false
}

function touchEnd(event, ownerInstance) {
  var panel = findPanel(event, ownerInstance)
  if (!panel) return
  var state = panel.getState()
  if (!state.tracking) return
  var dragging = state.dragging
  state.tracking = false
  state.dragging = false
  state.displacement = 0
  var touch = findTouch(event.changedTouches, state.identifier)
  if (!touch) return
  var velocity = recentVelocity(state, touch.pageY, event.timeStamp)
  var delta = touch.pageY - state.startY
  if (!dragging && (delta > START_PX || delta < -START_PX)) {
    dragging = true
    if (!(state.panelHeight > 0)) state.panelHeight = readHeight(panel)
  }
  var displacement = delta > 0 ? delta : rubberBand(delta, state.panelHeight)
  var elapsed = event.timeStamp - state.startTime
  var sheet = state.sheet
  var panelHeight = state.panelHeight
  if (!dragging) return
  ownerInstance.callMethod('onSheetDragRelease', {
    sheet: sheet,
    displacement: displacement,
    elapsed: elapsed,
    velocity: velocity,
    panelHeight: panelHeight
  })
}

function touchCancel(event, ownerInstance) {
  var panel = findPanel(event, ownerInstance)
  if (!panel) return
  var state = panel.getState()
  if (!state.tracking) return
  var sheet = state.sheet
  state.tracking = false
  state.dragging = false
  state.displacement = 0
  ownerInstance.callMethod('onSheetDragCancel', { sheet: sheet })
}

function recordSample(state, y, time) {
  var samples = state.samples || []
  samples.push({ y: y, time: time })
  var cutoff = time - VELOCITY_WINDOW_MS
  var previous = null
  var recent = []
  for (var index = 0; index < samples.length; index++) {
    if (samples[index].time >= cutoff) recent.push(samples[index])
    else previous = samples[index]
  }
  // Keep one older point for a no-move release; recentVelocity prefers points inside the window.
  state.samples = previous ? [previous].concat(recent) : recent
}

function recentVelocity(state, y, time) {
  recordSample(state, y, time)
  var samples = state.samples
  var end = samples[samples.length - 1]
  var cutoff = time - VELOCITY_WINDOW_MS
  var baseline = null
  for (var index = 0; index < samples.length - 1; index++) {
    if (samples[index].time >= cutoff) {
      baseline = samples[index]
      break
    }
  }
  // A direct start/end gesture has no move sample. Otherwise an old identical point yields zero,
  // so a stationary hold cannot inherit speed from the whole drag.
  if (!baseline && samples.length > 1) baseline = samples[samples.length - 2]
  if (!baseline || !(end.time > baseline.time)) return 0
  return (end.y - baseline.y) / (end.time - baseline.time)
}

function clearInline(newValue, oldValue, ownerInstance, instance) {
  if (!newValue || !newValue.token || !newValue.sheet) return
  if (newValue.action !== 'reset' && newValue.action !== 'close') return
  if (newValue.action === 'reset') instance.addClass('sheet-reset')
  else instance.removeClass('sheet-reset')
  instance.setStyle({
    transition: '',
    '-webkit-transition': ''
  })
  var sheet = newValue.sheet
  var pending = { token: newValue.token, instance: instance }
  pendingClearBySheet[sheet] = pending
  instance.requestAnimationFrame(function() {
    flushPendingClear(sheet, pending)
  })
}

function flushPendingClear(sheet, expected) {
  var pending = pendingClearBySheet[sheet]
  if (!pending || pending.token !== expected.token || pending.instance !== expected.instance) return
  pendingClearBySheet[sheet] = null
  pending.instance.setStyle({
    transform: '',
    '-webkit-transform': ''
  })
}

function sheetName(event) {
  var current = event.currentTarget && event.currentTarget.dataset
  if (current && current.sheet) return current.sheet
  var dataset = event.instance && event.instance.getDataset()
  if (dataset && dataset.sheet) return dataset.sheet
  return ''
}

function findPanel(event, ownerInstance) {
  var sheet = sheetName(event)
  if (!sheet) return null
  return ownerInstance.selectComponent('.sheet-slide-' + sheet)
}

function findTouch(touches, identifier) {
  if (!touches) return null
  var index = 0
  for (index = 0; index < touches.length; index++) {
    if (touches[index].identifier === identifier) return touches[index]
  }
  return null
}

function readHeight(panel) {
  var rect = panel.getBoundingClientRect()
  if (rect && rect.height > 0) return rect.height
  return 0
}

function rubberBand(overshoot, panelHeight) {
  if (!(panelHeight > 0)) return 0
  var magnitude = overshoot < 0 ? -overshoot : overshoot
  return overshoot * panelHeight * RUBBER / (panelHeight + RUBBER * magnitude)
}

module.exports = {
  touchStart: touchStart,
  touchMove: touchMove,
  touchEnd: touchEnd,
  touchCancel: touchCancel,
  clearInline: clearInline
}
