/* ===== Aurora Bloom: Rose + Glassmorphism ===== */
page {
  /* Aurora Dark Theme */
  --aurora-bg: #0A0E27;
  --aurora-bg2: #1A0A2E;
  --aurora-bg3: #2D1B69;

  /* Aurora Colors */
  --aurora-pink: #E8909E;
  --aurora-purple: #C4A0D2;
  --aurora-gold: #D4A574;

  /* Glass */
  --glass-bg: rgba(255,255,255,0.08);
  --glass-border: rgba(255,255,255,0.12);
  --glass-glow: rgba(232,144,158,0.15);
  --glass-inset: inset 0 1px 0 rgba(255,255,255,0.15);
  --glass-fallback: rgba(18,22,61,0.92);

  /* Font Roles — 共享字号角色，页面 WXSS 只允许引用角色 token（glyph/display 例外登记在 tests/typography-roles.test.js） */
  --font-size-month-title: 40rpx;
  --font-size-title: 34rpx;
  --font-size-body-lg: 32rpx;
  --font-size-body: 28rpx;
  --font-size-caption: 26rpx;
  --font-size-calendar-date: 28rpx;
  --font-size-calendar-date-compact: 30rpx;
  --font-size-calendar-micro: 24rpx;
  --font-size-button: 30rpx;
  --font-size-input: 32rpx;

  /* 共享文字字重、行高、字距。页面只引用这些 token，不另写同义数字。 */
  --font-weight-body: 400;
  --font-weight-assist: 500;
  --font-weight-control: 600;
  --font-weight-title: 700;
  --line-height-body: 1.6;
  --line-height-assist: 1.4;
  --line-height-title: 1.2;
  --letter-spacing-assist: 1rpx;
  --letter-spacing-room-code: 6rpx;
  --letter-spacing-code-input: 12rpx;

  /* Spacing — DESIGN.md 名义 px 刻度（4/8/16/24/32/48）以 rpx 记，数值 ×2 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 32rpx;
  --space-lg: 48rpx;
  --space-xl: 64rpx;
  --space-xxl: 96rpx;

  /* Text on Dark */
  --text-white: #FFFFFF;
  --text-primary: rgba(255,255,255,0.85);
  --text-secondary: rgba(255,255,255,0.6);
  --text-placeholder: rgba(255,255,255,0.6);
  --text-tertiary: rgba(255,255,255,0.35);

  /* Gradients 已全部退役：--gradient-gold（玫瑰 → 金，CTA 误用形态，issue #55）、
     --gradient-pink（玫瑰 → 薰衣草，无屏上引用，issue #59）。渐变填充不再以 token 提供 */

  /* Sizes */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-card: 24rpx;
  --radius-full: 999rpx;
  --radius-circle: 50%;

  /* Transitions — 逐属性声明，禁止 all；缓动只有 --ease-out。一次性时长用 --duration-*（issue #111） */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --duration-press: 160ms;
  --duration-state: 200ms;
  --duration-enter: 240ms;
  --duration-exit: 200ms;
  --duration-sheet: 280ms;
  /* 弹层内容块进场晚标题一拍（issue #166），只给 .sheet-body 的打开姿态用；40 + 240 = 面板的 280，内容和面板一起落定 */
  --delay-stagger: 40ms;

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ===== Aurora Background ===== */
page {
  /* 实色基底；极光画在视口固定层上，滚动时底部不出现色带分层 */
  background: #0A0E27;
  color: var(--text-primary);
  min-height: 100vh;
}

/* ===== Aurora（issue #163）— 一层静止基底 + 三个有边界的色团 =====
   基底 .page::before 只画海军 → 深蓝 → 深梅的纵向过渡，不动。动感交给每页根下 .aurora 里的三个色团：
   每个色团一层动画（位移、轻微缩放、透明度），周期 12s / 10s / 8s，负延迟错开起点，往返呼吸；
   不再整页缩放。色团的颜色只取玫瑰、薰衣草和蓝紫，柔金留给预测与节日。 */
.page {
  position: relative;
  min-height: 100vh;
  /* 页面入场动画 */
  animation: pageEnter var(--duration-enter) var(--ease-out) both;
}
.page::before {
  content: '';
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(168deg, #0A0E27 0%, #0A0E27 28%, #12163D 62%, #1A0A2E 100%);
  pointer-events: none;
  z-index: 0;
}
.aurora {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}
.aurora-bloom {
  position: absolute;
  pointer-events: none;
}
/* 蓝紫深处：大而暗的色团压在下半屏，给画面纵深 */
.aurora-bloom-violet {
  left: -30%;
  top: 38%;
  width: 160%;
  height: 80%;
  background: radial-gradient(closest-side, rgba(45,27,105,0.75), rgba(45,27,105,0.36) 48%, rgba(45,27,105,0));
  animation: auroraViolet 12s ease-in-out -6s infinite alternate;
}
/* 玫瑰：左上的暖光 */
.aurora-bloom-rose {
  left: -40%;
  top: -12%;
  width: 120%;
  height: 62%;
  background: radial-gradient(closest-side, rgba(232,144,158,0.14), rgba(232,144,158,0.06) 50%, rgba(232,144,158,0));
  animation: auroraRose 10s ease-in-out -3s infinite alternate;
}
/* 薰衣草：右侧中段的冷光 */
.aurora-bloom-lavender {
  left: 30%;
  top: 20%;
  width: 110%;
  height: 56%;
  background: radial-gradient(closest-side, rgba(196,160,210,0.11), rgba(196,160,210,0.05) 50%, rgba(196,160,210,0));
  animation: auroraLavender 8s ease-in-out -5s infinite alternate;
}
@keyframes auroraViolet {
  from { opacity: 0.7; transform: translate(-4%, 3%) scale(1); }
  to { opacity: 1; transform: translate(4%, -3%) scale(1.06); }
}
@keyframes auroraRose {
  from { opacity: 0.55; transform: translate(0, 0) scale(0.96); }
  to { opacity: 1; transform: translate(9%, 7%) scale(1.08); }
}
@keyframes auroraLavender {
  from { opacity: 1; transform: translate(0, 0) scale(1.04); }
  to { opacity: 0.6; transform: translate(-10%, 6%) scale(0.94); }
}

/* 页面入场动画：只淡入。位移动画会让 .page 永久保留 transform（fill-mode both），
   使 position:fixed 的 .page::before 与 .aurora 退化为相对文档定位，滚动时背景跟着滚动出现分层 */
@keyframes pageEnter {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== Custom Nav Bar ===== */
.nav-bar {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  height: var(--nav-bar-height, calc(env(safe-area-inset-top, 44px) + 44px));
  padding-top: var(--safe-top, env(safe-area-inset-top, 44px));
  padding-right: var(--capsule-right, 96px);
  padding-bottom: 0;
  padding-left: 30rpx;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-title);
  color: #E8909E;
}
.nav-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  text-align: center;
  font-size: 46rpx;
  line-height: 1;
  color: rgba(255,255,255,0.94);
  text-shadow: 0 2rpx 10rpx rgba(10,14,39,0.35);
  transition: transform var(--duration-press) var(--ease-out);
  position: relative;
  z-index: 11;
}
.nav-back-surface {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  border-radius: var(--radius-card);
  background: var(--glass-fallback);
  border: 1px solid rgba(232,144,158,0.28);
  box-shadow:
    0 6rpx 18rpx rgba(10,14,39,0.18),
    inset 0 1rpx 0 rgba(255,255,255,0.18);
  transition: border-color var(--duration-press) ease;
  z-index: 0;
}
.nav-back-surface::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: var(--radius-card);
  background-color: rgba(255,255,255,0.09);
  transition: background-color var(--duration-press) ease;
  pointer-events: none;
  z-index: -1;
}
.nav-back-icon {
  position: relative;
  z-index: 1;
  display: block;
  line-height: 1;
  transform: translateY(-1rpx);
}
.nav-back:active,
.nav-back.nav-back-hover {
  transform: scale(0.94);
}
.nav-back:active .nav-back-surface,
.nav-back.nav-back-hover .nav-back-surface {
  border-color: rgba(232,144,158,0.42);
  box-shadow:
    0 4rpx 12rpx rgba(10,14,39,0.16),
    inset 0 1rpx 0 rgba(255,255,255,0.22);
}
.nav-back:active .nav-back-surface::before,
.nav-back.nav-back-hover .nav-back-surface::before {
  background-color: rgba(255,255,255,0.14);
}
.nav-placeholder { width: 88rpx; }

/* ===== Premium Card (Glass) ===== */
.premium-card {
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  border-radius: var(--radius-card);
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: 0 8px 32px rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.15);
  position: relative;
  overflow: hidden;
  color: var(--text-primary);
}
.premium-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
}
/* ===== Premium Button — 实色玫瑰，不再常驻发光 ===== */
.btn-premium {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--aurora-pink);
  color: #0A0E27;
  border-radius: var(--radius-md);
  padding: 26rpx 0;
  font-size: var(--font-size-button);
  font-weight: var(--font-weight-control);
  box-shadow: 0 4px 15px rgba(232,144,158,0.28);
  transition: transform var(--duration-press) var(--ease-out), background-color var(--duration-state) ease;
  position: relative;
}
.btn-premium:active,
.btn-premium.btn-premium-hover {
  transform: scale(0.96);
  box-shadow: 0 2px 8px rgba(232,144,158,0.2);
}
.btn-premium.loading,
.btn-premium.disabled {
  opacity: 0.55;
}
.btn-premium:active.loading,
.btn-premium.btn-premium-hover.loading,
.btn-premium:active.disabled,
.btn-premium.btn-premium-hover.disabled{
  transform: none;
}

/* ===== Danger Button — 柔红，与玫瑰体系同族 ===== */
.btn-danger {
  position: relative;
  z-index: 0;
  background: var(--glass-fallback);
  color: #F97373;
  text-align: center;
  padding: 26rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-button);
  font-weight: var(--font-weight-control);
  border: 1px solid rgba(249,115,115,0.28);
  transition: border-color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.btn-danger::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: var(--radius-md);
  background-color: var(--glass-bg);
  transition: background-color var(--duration-press) ease;
  pointer-events: none;
  z-index: -1;
}
.btn-danger:active,
.btn-danger.btn-danger-hover {
  transform: scale(0.95);
}
.btn-danger:active::before,
.btn-danger.btn-danger-hover::before {
  background-color: rgba(249,115,115,0.12);
}

/* ===== Field Error（issue #156）— 经期、欢乐时光编辑页共用 =====
   警示红族「字段错误」形态：红字一句，紧贴所属 picker 下方常驻，改对即消失；
   不铺底、不描边、不做过渡（DESIGN.md「警示红语义」） */
.field-error {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: #F97373;
}

/* ===== Header Gradient ===== */
.header-gradient {
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  border-bottom: 1px solid rgba(255,255,255,0.1);
  overflow: hidden;
  z-index: 10;
}
.header-gradient::before {
  content: '';
  pointer-events: none;
  position: absolute;
  top: -40%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(232,144,158,0.2) 0%, transparent 60%);
  border-radius: var(--radius-circle);
  animation: float 8s ease-in-out infinite alternate;
}
.header-gradient::after {
  content: '';
  pointer-events: none;
  position: absolute;
  bottom: -20%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(196,160,210,0.1) 0%, transparent 60%);
  border-radius: var(--radius-circle);
  animation: float 6s ease-in-out infinite alternate-reverse;
}
@keyframes float {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(20rpx, -20rpx) scale(1.1); }
}

/* ===== 常驻装饰暂停（issue #118 → #163）=====
   弹层开着时页面根带 page-obscured，页面不可见（onHide 到下一次 onShow）时带 page-hidden。
   两种标记下，注册表里的装饰性常驻动画都暂停在当前帧，去掉标记后从这一帧继续，动画名和周期不变。
   只暂停、不写 animation: none（那会丢掉当前帧）；状态指示（spin、syncDotPulse、skeletonPulse）照常播放。 */
.page.page-obscured .aurora-bloom-violet,
.page.page-obscured .aurora-bloom-rose,
.page.page-obscured .aurora-bloom-lavender,
.page.page-obscured .header-gradient::before,
.page.page-obscured .header-gradient::after,
.page.page-obscured .no-room-icon,
.page.page-hidden .aurora-bloom-violet,
.page.page-hidden .aurora-bloom-rose,
.page.page-hidden .aurora-bloom-lavender,
.page.page-hidden .header-gradient::before,
.page.page-hidden .header-gradient::after,
.page.page-hidden .no-room-icon {
  animation-play-state: paused;
}

/* ===== Loading Spinner ===== */
.loading-view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255,255,255,0.1);
  border-top-color: #E8909E;
  border-radius: var(--radius-circle);
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* reduced-motion 下的加载替代反馈：透明度脉冲，无位移/旋转 */
@keyframes loadingPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

/* ===== Pulse Animation（仅空态心跳使用） ===== */
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

/* ===== List/Menu Item Press ===== */
.list-item:not(.non-interactive):active,
.list-item:not(.non-interactive).list-item-hover,
.menu-item:not(.non-interactive):active,
.menu-item:not(.non-interactive).menu-item-hover {
  transform: scale(0.97);
}

/* ===== Calendar Grid Transition ===== */
.calendar-grid {
  transition: opacity var(--duration-state) ease;
}

/* 共享顶栏：--safe-top、--nav-bar-height、--capsule-right、--safe-bottom
   由页面根节点内联注入（utils/safeArea.js）。顶栏固定，内容从顶栏底边开始。
   env() 在部分 Android 设备解析为 0，仅作兜底 */
.safe-top { padding-top: var(--nav-bar-height, calc(env(safe-area-inset-top, 44px) + 44px)); }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom, 20rpx); }

/* ===== Input Placeholder ===== */
.input-placeholder {
  color: var(--text-placeholder);
  font-size: var(--font-size-input);
}

/* ===== Reduced Motion — 全局兜底 =====
   政策（issue #58）：移除位移/缩放/旋转与装饰动画；状态反馈走颜色/透明度等无位移通道。
   加载中不静默：spinner 的旋转替换为 loadingPulse 透明度脉冲。 */
@media (prefers-reduced-motion: reduce) {
  .page,
  .aurora-bloom-violet,
  .aurora-bloom-rose,
  .aurora-bloom-lavender,
  .header-gradient::before,
  .header-gradient::after {
    animation: none;
  }
  .premium-card,
  .btn-premium,
  .btn-danger,
  .btn-danger::before,
  .nav-btn,
  .nav-back,
  .nav-back-surface,
  .nav-back-surface::before,
  .list-item,
  .menu-item,
  .calendar-grid {
    animation: none;
    transition: none;
  }
  .cycle-card,
  .hero-icon,
  .tab {
    animation: none;
    transition: none;
  }
  .loading-spinner {
    animation: loadingPulse 1.6s ease-in-out infinite;
  }
}
