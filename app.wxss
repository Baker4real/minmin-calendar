@import './pages/shared/nav-bar.wxss';
@import './pages/shared/vector-icons.wxss';
@import './pages/shared/brand-hearts.wxss';
@import './pages/shared/glass-buttons.wxss';
@import './pages/shared/text-pair.wxss';

/* ===== Aurora Bloom: Rose + Glassmorphism ===== */
page {
  /* Aurora Dark Theme */
  --aurora-bg: #0A0E27;
  --aurora-bg2: #1A0A2E;
  --aurora-bg3: #2D1B69;

  /* Aurora Colors */
  --aurora-pink: #E8909E;
  --aurora-purple: #C4A0D2;
  --aurora-gold: #D4A574;

  /* Semantic Colors — 实色字面量只留在 token 定义块（issue #245） */
  --color-danger: #F97373;
  --color-memory: #F0C4C0;
  --memory-gold: var(--aurora-gold);
  --text-on-accent: #0A0E27;

  /* Glass */
  --glass-bg: rgba(255,255,255,0.08);
  --glass-border: rgba(255,255,255,0.12);
  --glass-fallback: rgba(15,19,52,0.88);

  /* Font Roles — 共享字号角色，页面 WXSS 只允许引用角色 token（glyph/display/scale-hold 例外登记在 tests/typography-roles.test.js） */
  --font-size-month-title: 44rpx;
  --font-size-title: 38rpx;
  --font-size-body-lg: 34rpx;
  --font-size-body: 30rpx;
  --font-size-caption: 26rpx;
  --font-size-calendar-date: 28rpx;
  --font-size-calendar-date-compact: 30rpx;
  --font-size-calendar-micro: 24rpx;

  /* 共享文字字重、行高、字距。页面只引用这些 token，不另写同义数字。 */
  --font-weight-body: 400;
  --font-weight-assist: 500;
  --font-weight-control: 600;
  --font-weight-title: 700;
  --line-height-body: 1.6;
  --line-height-assist: 1.4;
  --line-height-title: 1.2;
  --line-height-snug: 1.32;
  --letter-spacing-assist: 1rpx;
  --letter-spacing-display: 1rpx;
  --letter-spacing-control-sm: 0.5rpx;
  --letter-spacing-room-code: 6rpx;
  --letter-spacing-code-input: 12rpx;

  /* Spacing — DESIGN.md 名义 px 刻度（4/8/16/24/32/48）以 rpx 记，数值 ×2 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 32rpx;
  --space-lg: 48rpx;
  --space-xl: 64rpx;
  --space-xxl: 96rpx;

  /* Page Rhythm — 已登记的页面留白角色（issue #164 / #245） */
  --space-page-gutter: 24rpx;
  --space-page-first-block: 24rpx;
  --space-page-block-gap: 20rpx;
  --space-page-row-inset: 30rpx;
  --space-settings-group-gap: 28rpx;

  /* Text on Dark */
  --text-primary: rgba(255,255,255,0.85);
  --text-secondary: rgba(255,255,255,0.6);
  --text-placeholder: rgba(255,255,255,0.6);
  --text-tertiary: rgba(255,255,255,0.35);

  /* Gradients 已全部退役：--gradient-gold（玫瑰 → 金，CTA 误用形态，issue #55）、
     --gradient-pink（玫瑰 → 薰衣草，无屏上引用，issue #59）。渐变填充不再以 token 提供 */

  /* Sizes */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-card: 24rpx;
  --radius-full: 999rpx;
  --radius-circle: 50%;

  /* Transitions — 逐属性声明，禁止 all；缓动只有 --ease-out。一次性时长用 --duration-*（issue #111） */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --duration-press-in: 90ms;
  --duration-press: 180ms;
  --duration-state: 200ms;
  --duration-enter: 240ms;
  --duration-exit: 200ms;
  --duration-sheet: 280ms;
  /* 一次性状态强调（今天、「预」的光晕；记录成功的 ♥ 与色带，issue #167）：只播一次（issue #165） */
  --duration-emphasis: 600ms;
  /* 弹层内容块进场晚标题一拍（issue #166），只给 .sheet-body 的打开姿态用；40 + 240 = 面板的 280，内容和面板一起落定 */
  --delay-stagger: 40ms;
  /* 记录成功反馈等编辑页退场、首页滑回来再播（issue #167）：onShow 在返回转场开始时就到了 */
  --delay-return: 300ms;

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ===== Aurora Background ===== */
page {
  /* 实色基底；极光画在视口固定层上，滚动时底部不出现色带分层 */
  background: var(--aurora-bg);
  color: var(--text-primary);
  min-height: 100vh;
}

/* ===== Aurora（issue #163）— 一层静止基底 + 三个有边界的色团 =====
   基底 .page::before 只画海军 → 深蓝 → 深梅的纵向过渡，不动。动感交给每页根下 .aurora 里的三个色团：
   每个色团一层动画（位移、轻微缩放、透明度），周期 12s / 10s / 8s，负延迟错开起点，往返呼吸；
   不再整页缩放。色团的颜色只取玫瑰、薰衣草和蓝紫，柔金留给预测与节日。 */
.page {
  position: relative;
  min-height: 100vh;
  /* 页面入场动画 */
  animation: fadeIn var(--duration-enter) var(--ease-out) both;
}
.page::before {
  content: '';
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(168deg, var(--aurora-bg) 0%, var(--aurora-bg) 28%, #12163D 62%, #1A0A2E 100%);
  pointer-events: none;
  z-index: 0;
}
.aurora {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}
.aurora-bloom {
  position: absolute;
  pointer-events: none;
}
/* 蓝紫深处：大而暗的色团压在下半屏，给画面纵深 */
.aurora-bloom-violet {
  left: -30%;
  top: 38%;
  width: 160%;
  height: 80%;
  background: radial-gradient(closest-side, rgba(45,27,105,0.75), rgba(45,27,105,0.36) 48%, rgba(45,27,105,0));
  animation: auroraViolet 12s ease-in-out -6s infinite alternate;
}
/* 玫瑰：左上的暖光 */
.aurora-bloom-rose {
  left: -40%;
  top: -12%;
  width: 120%;
  height: 62%;
  background: radial-gradient(closest-side, rgba(232,144,158,0.14), rgba(232,144,158,0.06) 50%, rgba(232,144,158,0));
  animation: auroraRose 10s ease-in-out -3s infinite alternate;
}
/* 薰衣草：右侧中段的冷光 */
.aurora-bloom-lavender {
  left: 30%;
  top: 20%;
  width: 110%;
  height: 56%;
  background: radial-gradient(closest-side, rgba(196,160,210,0.11), rgba(196,160,210,0.05) 50%, rgba(196,160,210,0));
  animation: auroraLavender 8s ease-in-out -5s infinite alternate;
}
@keyframes auroraViolet {
  from { opacity: 0.7; transform: translate(-4%, 3%) scale(1); }
  to { opacity: 1; transform: translate(4%, -3%) scale(1.06); }
}
@keyframes auroraRose {
  from { opacity: 0.55; transform: translate(0, 0) scale(0.96); }
  to { opacity: 1; transform: translate(9%, 7%) scale(1.08); }
}
@keyframes auroraLavender {
  from { opacity: 1; transform: translate(0, 0) scale(1.04); }
  to { opacity: 0.6; transform: translate(-10%, 6%) scale(0.94); }
}

/* 页面入场、记录出现与当日详情共用这一份淡入关键帧。页面入场不做位移：
   位移动画会让 .page 永久保留 transform（fill-mode both），使 position:fixed 的
   .page::before 与 .aurora 退化为相对文档定位，滚动时背景跟着滚动出现分层 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== Shared navbar lives in pages/shared/nav-bar.wxss ===== */

/* ===== Premium Card (Glass) ===== */
.premium-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(rgba(255,255,255,0.095), rgba(255,255,255,0.035)), var(--glass-fallback);
  border-radius: var(--radius-card);
  border-top: 1px solid rgba(255,255,255,0.16);
  border-right: 1px solid rgba(255,255,255,0.08);
  border-bottom: 1px solid rgba(255,255,255,0.04);
  border-left: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 16rpx 64rpx rgba(0,0,0,0.2);
  color: var(--text-primary);
}
.premium-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(232,144,158,0.42) 24%, rgba(255,255,255,0.30) 50%, rgba(196,160,210,0.32) 76%, transparent 100%);
}
/* ===== Premium Button — 实色玫瑰，不再常驻发光 ===== */
.btn-premium {
  gap: 12rpx;
  background: var(--aurora-pink);
  color: var(--text-on-accent);
  border-radius: var(--radius-md);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.30);
  padding: 26rpx 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  transition: transform var(--duration-press) var(--ease-out), background-color var(--duration-state) ease;
}
/* 柔光层（issue #166 / #269）：玫瑰实色按钮的光画在 ::before 上，按钮自身只保留顶缘内高光。
   柔光层铺满按钮、跟按钮同一个圆角、不拦点按；静止 0.35，按下沉到 0.15，和缩放同一拍。
   主按钮、首页记录入口和本月小结的复制键共用这一层，各自只写光的大小（box-shadow）；
   绑定页与设置页的复制键是另一份同款契约（DESIGN.md「按压的四路」），不在这组。主按钮禁用和加载中没有柔光 */
.btn-premium::before,
.quick-btn::before,
.copy-recap::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  opacity: 0.35;
  transition: opacity var(--duration-press) ease;
  pointer-events: none;
}
.btn-premium:active::before,
.btn-premium.btn-premium-hover::before,
.quick-btn:active::before,
.quick-btn.quick-btn-hover::before,
.copy-recap:active::before,
.copy-recap.copy-recap-hover::before {
  opacity: 0.15;
  transition: opacity var(--duration-press-in) ease;
}
.btn-premium::before {
  box-shadow: 0 8rpx 30rpx rgba(232,144,158,0.28);
}
.btn-premium:active,
.btn-premium.btn-premium-hover {
  transform: scale(0.96);
  transition: transform var(--duration-press-in) var(--ease-out);
}
.btn-premium.loading,
.btn-premium.disabled {
  opacity: 0.55;
}
.btn-premium:active.loading,
.btn-premium.btn-premium-hover.loading,
.btn-premium:active.disabled,
.btn-premium.btn-premium-hover.disabled{
  transform: none;
}
.btn-premium.loading::before,
.btn-premium.disabled::before,
.btn-premium:active.loading::before,
.btn-premium.btn-premium-hover.loading::before,
.btn-premium:active.disabled::before,
.btn-premium.btn-premium-hover.disabled::before {
  opacity: 0;
}

/* 原生分享按钮（issue #140 / #218）：绑定与设置共用同一枚玫瑰主按钮。
   特异性高于 .btn-premium，盖住组件自带灰底、5px 圆角和 ::after 描边；
   overflow 放开以免裁掉柔光，按压类让柔光和缩放一起沉。 */
button.share-invite {
  margin: 0 0 30rpx;
  width: 100%;
  padding: 26rpx 0;
  box-sizing: border-box;
  border: none;
  border-radius: var(--radius-md);
  background: var(--aurora-pink);
  color: var(--text-on-accent);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  line-height: var(--line-height-body);
  overflow: visible;
}
button.share-invite::after {
  border: none;
}
.share-invite.share-invite-hover {
  transform: scale(0.96);
  transition: transform var(--duration-press-in) var(--ease-out);
}
.share-invite.share-invite-hover::before {
  opacity: 0.15;
  transition: opacity var(--duration-press-in) ease;
}

/* ===== Danger Button — 柔红，与玫瑰体系同族 ===== */
.btn-danger {
  background: var(--glass-fallback);
  color: var(--color-danger);
  text-align: center;
  padding: 26rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-control);
  border: 1px solid rgba(249,115,115,0.28);
  transition: border-color var(--duration-press) ease, transform var(--duration-press) var(--ease-out);
}
.btn-danger::before {
  border-radius: var(--radius-md);
  background-color: var(--glass-bg);
  transition: background-color var(--duration-press) ease;
}
/* 平涂层盖不到描边带：按下时描边同色提亮，和红色平涂层一起亮（issue #166） */
.btn-danger:active,
.btn-danger.btn-danger-hover {
  transform: scale(0.95);
  border-color: rgba(249,115,115,0.4);
  transition: border-color var(--duration-press-in) ease, transform var(--duration-press-in) var(--ease-out);
}
.btn-danger:active::before,
.btn-danger.btn-danger-hover::before {
  background-color: rgba(249,115,115,0.12);
  transition: background-color var(--duration-press-in) ease;
}
/* 删除中与不可删（issue #166）：用类名表达，不写内联透明度；按下不缩放、描边和平涂层停在静止值 */
.btn-danger.loading,
.btn-danger.disabled {
  opacity: 0.5;
}
.btn-danger:active.loading,
.btn-danger.btn-danger-hover.loading,
.btn-danger:active.disabled,
.btn-danger.btn-danger-hover.disabled {
  transform: none;
  border-color: rgba(249,115,115,0.28);
}
.btn-danger:active.loading::before,
.btn-danger.btn-danger-hover.loading::before,
.btn-danger:active.disabled::before,
.btn-danger.btn-danger-hover.disabled::before {
  background-color: var(--glass-bg);
}

/* ===== 平涂层（issue #163、#166、#234）=====
   压在极光上的重试行，底是海军回退 var(--glass-fallback)，淡白只是 ::before 上的平涂层
   （宿主自己带 position: relative 与 z-index: 0）：铺满内边距盒、跟宿主同一个圆角、不拦点按，按压加深这一层，
   background-color 和按压同一拍。平涂层盖不到描边带，宿主按下时描边提亮。首页、记录 tab、
   绑定页三处重试共用这一层，外观和平涂色只写在 pages/shared/retry-row.wxss */
.refresh-retry::before,
.list-retry::before,
.error-retry::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  transition: background-color var(--duration-press) ease;
  pointer-events: none;
  z-index: -1;
}

/* ===== 弹层内容块（issue #166）=====
   标题与内容错相：标题行（把手、标题、关闭）随面板升降，自己不另动；下面的内容块晚一拍跟上。
   收起时透明、低 16rpx；打开时等 --delay-stagger，再用进场时长到位，和面板同时落定；离场不等，和面板一起走。
   全是 transition，中途反向从当前帧接着走。不拦点按、不改显隐：内容里的操作从第一帧起就能点。
   首页、设置「使用说明」与确认面板都挂在共享 .sheet-slide 上 */
.sheet-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  scrollbar-width: none;
  scrollbar-color: transparent transparent;
  opacity: 0;
  transform: translateY(16rpx);
  transition: opacity var(--duration-exit) var(--ease-out), transform var(--duration-exit) var(--ease-out);
}
.sheet-body::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}
.sheet-slide.sheet-open .sheet-body {
  opacity: 1;
  transform: translateY(0);
  transition: opacity var(--duration-enter) var(--ease-out) var(--delay-stagger), transform var(--duration-enter) var(--ease-out) var(--delay-stagger);
}

/* ===== Field Error（issue #156）— 经期、欢乐时光编辑页共用 =====
   警示红族「字段错误」形态：红字一句，紧贴所属 picker 下方常驻，改对即消失；
   不铺底、不描边、不做过渡（DESIGN.md「警示红语义」） */
.field-error {
  display: block;
  margin-top: 12rpx;
  font-size: var(--font-size-caption);
  font-weight: var(--font-weight-assist);
  line-height: var(--line-height-assist);
  letter-spacing: var(--letter-spacing-assist);
  color: var(--color-danger);
}

/* ===== Header gradient lives in the shared navbar stylesheet ===== */

/* ===== 常驻装饰暂停（issue #118 → #163）=====
   弹层开着时页面根带 page-obscured，页面不可见（onHide 到下一次 onShow）时带 page-hidden。
   两种标记下，注册表里的装饰性常驻动画都暂停在当前帧，去掉标记后从这一帧继续，动画名和周期不变。
   只暂停、不写 animation: none（那会丢掉当前帧）；状态指示（syncDotPulse、skeletonPulse）照常播放。
   色团写它们共有的 .aurora-bloom（共享标记里每个色团都带这个类），增减色团不用改这里。 */
.page.page-obscured .aurora-bloom,
.page.page-obscured .no-room-icon,
.page.page-hidden .aurora-bloom,
.page.page-hidden .no-room-icon {
  animation-play-state: paused;
}

/* ===== Pulse Animation（仅空态心跳使用） ===== */
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

/* 首页与记录页共用同一份骨架脉冲；几何和挂载节点仍由各页保留。 */
@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

/* ===== List/Menu Item Press ===== */
.list-item:not(.non-interactive):active,
.list-item:not(.non-interactive).list-item-hover,
.menu-item:not(.non-interactive):active,
.menu-item:not(.non-interactive).menu-item-hover {
  transform: scale(0.97);
  transition: transform var(--duration-press-in) var(--ease-out);
}

/* ===== Calendar Grid Transition ===== */
.calendar-grid {
  transition: opacity var(--duration-state) ease;
}

/* --safe-bottom 由页面根节点内联注入（utils/safeArea.js）；顶栏安全区在共享顶栏样式里。 */

/* ===== Input Placeholder ===== */
.input-placeholder {
  color: var(--text-placeholder);
  font-size: var(--font-size-body-lg);
}

/* ===== Reduced Motion — 全局兜底 =====
   政策（issue #58）：移除位移/缩放/旋转与装饰动画；状态反馈走颜色/透明度等无位移通道。
   这里只管 app.wxss 自己声明的动画和过渡：页面 wxss 里的同名选择器会盖过这里，
   页面声明的写在本页文件末尾的减弱动效块里。 */
@media (prefers-reduced-motion: reduce) {
  .page,
  .aurora-bloom {
    animation: none;
  }
  .premium-card,
  .btn-premium,
  .btn-premium::before,
  .quick-btn::before,
  .copy-recap::before,
  .refresh-retry::before,
  .list-retry::before,
  .error-retry::before,
  .sheet-body,
  .sheet-slide.sheet-open .sheet-body,
  .btn-danger,
  .btn-danger::before,
  .nav-btn,
  .calendar-grid {
    animation: none;
    transition: none;
  }
  .btn-premium:active::before,
  .btn-premium.btn-premium-hover::before,
  .quick-btn:active::before,
  .quick-btn.quick-btn-hover::before,
  .copy-recap:active::before,
  .copy-recap.copy-recap-hover::before,
  .btn-premium:active,
  .btn-premium.btn-premium-hover,
  .btn-premium:active.loading,
  .btn-premium.btn-premium-hover.loading,
  .btn-premium:active.disabled,
  .btn-premium.btn-premium-hover.disabled,
  .btn-premium:active.loading::before,
  .btn-premium.btn-premium-hover.loading::before,
  .btn-premium:active.disabled::before,
  .btn-premium.btn-premium-hover.disabled::before,
  .share-invite.share-invite-hover,
  .share-invite.share-invite-hover::before,
  .btn-danger:active,
  .btn-danger.btn-danger-hover,
  .btn-danger:active::before,
  .btn-danger.btn-danger-hover::before,
  .btn-danger:active.loading,
  .btn-danger.btn-danger-hover.loading,
  .btn-danger:active.disabled,
  .btn-danger.btn-danger-hover.disabled,
  .btn-danger:active.loading::before,
  .btn-danger.btn-danger-hover.loading::before,
  .btn-danger:active.disabled::before,
  .btn-danger.btn-danger-hover.disabled::before,
  .list-item:not(.non-interactive):active,
  .list-item:not(.non-interactive).list-item-hover,
  .menu-item:not(.non-interactive):active,
  .menu-item:not(.non-interactive).menu-item-hover {
    transition: none;
  }
}
