/* ===== Aurora Bloom: Rose + Glassmorphism ===== */
page {
  /* Aurora Dark Theme */
  --aurora-bg: #0A0E27;
  --aurora-bg2: #1A0A2E;
  --aurora-bg3: #2D1B69;

  /* Aurora Colors */
  --aurora-pink: #E8909E;
  --aurora-purple: #C4A0D2;
  --aurora-gold: #D4A574;

  /* Glass */
  --glass-bg: rgba(255,255,255,0.08);
  --glass-border: rgba(255,255,255,0.12);
  --glass-glow: rgba(232,144,158,0.15);
  --glass-inset: inset 0 1px 0 rgba(255,255,255,0.15);
  --glass-fallback: rgba(18,22,61,0.92);

  /* Font Roles — 共享字号角色，页面 WXSS 只允许引用角色 token（glyph/display 例外登记在 tests/typography-roles.test.js） */
  --font-size-month-title: 40rpx;
  --font-size-title: 34rpx;
  --font-size-body-lg: 32rpx;
  --font-size-body: 28rpx;
  --font-size-caption: 26rpx;
  --font-size-calendar-date: 28rpx;
  --font-size-calendar-date-compact: 30rpx;
  --font-size-calendar-micro: 24rpx;
  --font-size-button: 30rpx;
  --font-size-input: 32rpx;

  /* 共享文字字重、行高、字距。页面只引用这些 token，不另写同义数字。 */
  --font-weight-body: 400;
  --font-weight-assist: 500;
  --font-weight-control: 600;
  --font-weight-title: 700;
  --line-height-body: 1.6;
  --line-height-assist: 1.4;
  --line-height-title: 1.2;
  --letter-spacing-assist: 1rpx;
  --letter-spacing-room-code: 6rpx;
  --letter-spacing-code-input: 12rpx;

  /* Spacing — DESIGN.md 名义 px 刻度（4/8/16/24/32/48）以 rpx 记，数值 ×2 */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 32rpx;
  --space-lg: 48rpx;
  --space-xl: 64rpx;
  --space-xxl: 96rpx;

  /* Text on Dark */
  --text-white: #FFFFFF;
  --text-primary: rgba(255,255,255,0.85);
  --text-secondary: rgba(255,255,255,0.6);
  --text-tertiary: rgba(255,255,255,0.35);

  /* Gradients 已全部退役：--gradient-gold（玫瑰 → 金，CTA 误用形态，issue #55）、
     --gradient-pink（玫瑰 → 薰衣草，无屏上引用，issue #59）。渐变填充不再以 token 提供 */

  /* Sizes */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-card: 24rpx;
  --radius-full: 999rpx;
  --radius-circle: 50%;

  /* Transitions — 逐属性声明，禁止 all；缓动只有 --ease-out。一次性时长用 --duration-*（issue #111） */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --duration-press: 160ms;
  --duration-state: 200ms;
  --duration-enter: 240ms;
  --duration-exit: 200ms;
  --duration-sheet: 280ms;

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ===== Aurora Background ===== */
page {
  /* 实色基底；极光渐变在 .page::before 上按视口固定，滚动时底部不再出现色带分层 */
  background: #0A0E27;
  color: var(--text-primary);
  min-height: 100vh;
}

/* ===== Aurora Overlay — 只用玫瑰/薰衣草/柔金三音色 ===== */
.page {
  position: relative;
  min-height: 100vh;
  /* 页面入场动画 */
  animation: pageEnter var(--duration-enter) var(--ease-out) both;
}
.page::before {
  content: '';
  position: fixed;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background:
    radial-gradient(ellipse at 30% 20%, rgba(232,144,158,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at 70% 80%, rgba(196,160,210,0.09) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 50%, rgba(212,165,116,0.05) 0%, transparent 50%),
    linear-gradient(135deg, #0A0E27, #1A0A2E, #2D1B69, #0A0E27);
  pointer-events: none;
  animation: auroraPulse 8s ease infinite;
  z-index: 0;
}

@keyframes auroraPulse {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}

/* 页面入场动画：只淡入。位移动画会让 .page 永久保留 transform（fill-mode both），
   使 position:fixed 的 .page::before 退化为相对文档定位，滚动时背景跟着滚动出现分层 */
@keyframes pageEnter {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ===== Glow Orbs — 每个 orb 只保留一层持续动画（orbFloat）；orbRotate 第二层随 issue #58 退役 ===== */
.glow-orb {
  position: absolute;
  border-radius: var(--radius-circle);
  pointer-events: none;
  z-index: 0;
  animation: orbFloat 6s ease-in-out infinite;
}
.glow-orb-1 {
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, rgba(232,144,158,0.2), transparent);
  top: -100rpx; right: -80rpx;
}
.glow-orb-2 {
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, rgba(196,160,210,0.13), transparent);
  bottom: 100rpx; left: -60rpx;
  animation-duration: 8s;
  animation-direction: reverse;
}
@keyframes orbFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20rpx) scale(1.1); }
}

/* ===== Custom Nav Bar ===== */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  height: 88rpx;
  position: relative;
  z-index: 10;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-size-title);
  font-weight: var(--font-weight-title);
  color: #E8909E;
}
.nav-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  text-align: center;
  font-size: 46rpx;
  line-height: 1;
  color: rgba(255,255,255,0.94);
  text-shadow: 0 2rpx 10rpx rgba(10,14,39,0.35);
  transition: transform var(--duration-press) var(--ease-out);
  position: relative;
  z-index: 11;
}
.nav-back-surface {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(rgba(255,255,255,0.09), rgba(255,255,255,0.09)), var(--glass-fallback);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(232,144,158,0.28);
  box-shadow:
    0 6rpx 18rpx rgba(10,14,39,0.18),
    inset 0 1rpx 0 rgba(255,255,255,0.18);
  transition: background var(--duration-press) ease, border-color var(--duration-press) ease;
  z-index: 0;
}
.nav-back-icon {
  position: relative;
  z-index: 1;
  display: block;
  line-height: 1;
  transform: translateY(-1rpx);
}
.nav-back:active,
.nav-back.nav-back-hover {
  transform: scale(0.94);
}
.nav-back:active .nav-back-surface,
.nav-back.nav-back-hover .nav-back-surface {
  background: linear-gradient(rgba(255,255,255,0.14), rgba(255,255,255,0.14)), var(--glass-fallback);
  border-color: rgba(232,144,158,0.42);
  box-shadow:
    0 4rpx 12rpx rgba(10,14,39,0.16),
    inset 0 1rpx 0 rgba(255,255,255,0.22);
}
.nav-placeholder { width: 88rpx; }

/* ===== Premium Card (Glass) ===== */
.premium-card {
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: var(--radius-card);
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: 0 8px 32px rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.15);
  position: relative;
  overflow: hidden;
  color: var(--text-primary);
}
.premium-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
}
/* ===== Premium Button — 实色玫瑰，不再常驻发光 ===== */
.btn-premium {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--aurora-pink);
  color: #0A0E27;
  border-radius: var(--radius-md);
  padding: 26rpx 0;
  font-size: var(--font-size-button);
  font-weight: var(--font-weight-control);
  box-shadow: 0 4px 15px rgba(232,144,158,0.28);
  transition: transform var(--duration-press) var(--ease-out), background-color var(--duration-state) ease;
  position: relative;
}
.btn-premium:active {
  transform: scale(0.96);
  box-shadow: 0 2px 8px rgba(232,144,158,0.2);
}
.btn-premium.loading,
.btn-premium.disabled {
  opacity: 0.55;
}
.btn-premium.loading:active,
.btn-premium.disabled:active {
  transform: none;
}

/* ===== Danger Button — 柔红，与玫瑰体系同族 ===== */
.btn-danger {
  background: linear-gradient(var(--glass-bg), var(--glass-bg)), var(--glass-fallback);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: #F97373;
  text-align: center;
  padding: 26rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-size-button);
  font-weight: var(--font-weight-control);
  border: 1px solid rgba(249,115,115,0.28);
  transition: background-color var(--duration-press) ease, border-color var(--duration-state) ease, transform var(--duration-press) var(--ease-out);
}
.btn-danger:active,
.btn-danger.btn-danger-hover {
  transform: scale(0.95);
  background: linear-gradient(rgba(249,115,115,0.12), rgba(249,115,115,0.12)), var(--glass-fallback);
}

/* ===== Header Gradient ===== */
.header-gradient {
  background: linear-gradient(rgba(255,255,255,0.05), rgba(255,255,255,0.05)), var(--glass-fallback);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,0.1);
  position: relative;
  overflow: hidden;
  z-index: 10;
}
.header-gradient::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(232,144,158,0.2) 0%, transparent 60%);
  border-radius: var(--radius-circle);
  animation: float 8s ease-in-out infinite alternate;
}
.header-gradient::after {
  content: '';
  position: absolute;
  bottom: -20%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(196,160,210,0.1) 0%, transparent 60%);
  border-radius: var(--radius-circle);
  animation: float 6s ease-in-out infinite alternate-reverse;
}
@keyframes float {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(20rpx, -20rpx) scale(1.1); }
}

/* ===== Loading Spinner ===== */
.loading-view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255,255,255,0.1);
  border-top-color: #E8909E;
  border-radius: var(--radius-circle);
  animation: spin 0.8s linear infinite;
  box-shadow: 0 0 20px rgba(232,144,158,0.2);
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* reduced-motion 下的加载替代反馈：透明度脉冲，无位移/旋转 */
@keyframes loadingPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

/* ===== Pulse Animation（仅空态心跳使用） ===== */
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

/* ===== List/Menu Item Press ===== */
.list-item:not(.non-interactive):active,
.menu-item:not(.non-interactive):active {
  transform: scale(0.97);
}

/* ===== Calendar Grid Transition ===== */
.calendar-grid {
  transition: opacity var(--duration-state) ease;
}

/* Safe Area：--safe-top 由页面根节点内联注入（utils/safeArea.js），
   env() 在部分 Android 设备解析为 0，仅作兜底 */
.safe-top { padding-top: var(--safe-top, env(safe-area-inset-top, 88rpx)); }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom, 20rpx); }

/* ===== Input Placeholder ===== */
.input-placeholder {
  color: var(--text-tertiary);
}

/* ===== Reduced Motion — 全局兜底 =====
   政策（issue #58）：移除位移/缩放/旋转与装饰动画；状态反馈走颜色/透明度等无位移通道。
   加载中不静默：spinner 的旋转替换为 loadingPulse 透明度脉冲。 */
@media (prefers-reduced-motion: reduce) {
  .page,
  .page::before,
  .glow-orb,
  .header-gradient::before,
  .header-gradient::after {
    animation: none;
  }
  .premium-card,
  .btn-premium,
  .btn-danger,
  .nav-btn,
  .nav-back,
  .nav-back-surface,
  .list-item,
  .menu-item,
  .calendar-grid {
    animation: none;
    transition: none;
  }
  .cycle-card,
  .profile-card,
  .hero-icon,
  .tab {
    animation: none;
    transition: none;
  }
  .loading-spinner {
    animation: loadingPulse 1.6s ease-in-out infinite;
  }
}
