/* ===== Aurora Bloom: Rose + Glassmorphism ===== */
page {
  /* Aurora Dark Theme */
  --aurora-bg: #0A0E27;
  --aurora-bg2: #1A0A2E;
  --aurora-bg3: #2D1B69;

  /* Aurora Colors */
  --aurora-pink: #E8909E;
  --aurora-purple: #C4A0D2;
  --aurora-gold: #D4A574;

  /* Glass */
  --glass-bg: rgba(255,255,255,0.08);
  --glass-bg-hover: rgba(255,255,255,0.15);
  --glass-border: rgba(255,255,255,0.12);
  --glass-border-hover: rgba(255,255,255,0.25);
  --glass-glow: rgba(232,144,158,0.15);
  --glass-inset: inset 0 1px 0 rgba(255,255,255,0.15);

  /* Text on Dark */
  --text-white: #FFFFFF;
  --text-primary: rgba(255,255,255,0.85);
  --text-secondary: rgba(255,255,255,0.6);
  --text-tertiary: rgba(255,255,255,0.35);

  /* Gradients */
  --gradient-pink: linear-gradient(135deg, #E8909E, #C4A0D2);
  --gradient-gold: linear-gradient(135deg, #D4A574, #E8909E);

  /* Sizes */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;

  /* Transitions — 逐属性声明，禁止 all */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --transition: background-color 0.3s var(--ease-out), border-color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  --transition-spring: transform 0.3s var(--ease-spring), background-color 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);

  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ===== Aurora Background ===== */
page {
  background: linear-gradient(135deg, #0A0E27, #1A0A2E, #2D1B69, #0A0E27);
  background-position: 0% 50%;
  color: var(--text-primary);
  min-height: 100vh;
}

/* ===== Aurora Overlay — 只用玫瑰/薰衣草/柔金三音色 ===== */
.page {
  position: relative;
  min-height: 100vh;
  /* 页面入场动画 */
  animation: pageEnter 0.35s ease-out both;
}
.page::before {
  content: '';
  position: fixed;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background:
    radial-gradient(ellipse at 30% 20%, rgba(232,144,158,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at 70% 80%, rgba(196,160,210,0.09) 0%, transparent 50%),
    radial-gradient(ellipse at 50% 50%, rgba(212,165,116,0.05) 0%, transparent 50%);
  pointer-events: none;
  animation: auroraPulse 8s ease infinite;
  z-index: 0;
}

@keyframes auroraPulse {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}

/* 页面入场动画 */
@keyframes pageEnter {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== Glow Orbs ===== */
.glow-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.glow-orb-1 {
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, rgba(232,144,158,0.2), transparent);
  top: -100rpx; right: -80rpx;
  animation: orbFloat 6s ease-in-out infinite, orbRotate 12s linear infinite;
}
.glow-orb-2 {
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, rgba(196,160,210,0.13), transparent);
  bottom: 100rpx; left: -60rpx;
  animation: orbFloat 8s ease-in-out infinite reverse, orbRotate 15s linear infinite reverse;
}
@keyframes orbFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20rpx) scale(1.1); }
}
@keyframes orbRotate {
  from { transform: rotate(0deg) translateX(30rpx) rotate(0deg); }
  to { transform: rotate(360deg) translateX(30rpx) rotate(-360deg); }
}

/* ===== Custom Nav Bar ===== */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  height: 88rpx;
  position: relative;
  z-index: 10;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #E8909E;
  text-shadow: 0 0 14rpx rgba(232,144,158,0.28);
}
.nav-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0;
  text-align: center;
  font-size: 46rpx;
  line-height: 1;
  color: rgba(255,255,255,0.94);
  text-shadow: 0 2rpx 10rpx rgba(10,14,39,0.35);
  transition: transform 0.22s var(--ease-spring);
  position: relative;
  z-index: 11;
}
.nav-back-surface {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.09);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(232,144,158,0.28);
  box-shadow:
    0 6rpx 18rpx rgba(10,14,39,0.18),
    inset 0 1rpx 0 rgba(255,255,255,0.18);
  transition: background 0.22s var(--ease-out), border-color 0.22s var(--ease-out), box-shadow 0.22s var(--ease-out);
  z-index: 0;
}
.nav-back-icon {
  position: relative;
  z-index: 1;
  display: block;
  line-height: 1;
  transform: translateY(-1rpx);
}
.nav-back:active {
  transform: scale(0.94);
}
.nav-back:active .nav-back-surface {
  background: rgba(255,255,255,0.14);
  border-color: rgba(232,144,158,0.42);
  box-shadow:
    0 4rpx 12rpx rgba(10,14,39,0.16),
    inset 0 1rpx 0 rgba(255,255,255,0.22);
}
.nav-placeholder { width: 88rpx; }

/* ===== Premium Card (Glass) ===== */
.premium-card {
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  border: 1px solid rgba(255,255,255,0.12);
  box-shadow: 0 8px 32px rgba(0,0,0,0.2), inset 0 1px 0 rgba(255,255,255,0.15);
  position: relative;
  overflow: hidden;
  color: var(--text-primary);
  transition: transform 0.2s var(--ease-out);
}
.premium-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
}
.premium-card:active {
  transform: scale(0.97);
}

/* ===== Premium Button — 实色玫瑰，不再常驻发光 ===== */
.btn-premium {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #E8909E;
  color: #fff;
  border-radius: var(--radius-md);
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 4px 15px rgba(232,144,158,0.28);
  transition: var(--transition-spring);
  position: relative;
}
.btn-premium:active {
  transform: scale(0.96);
  box-shadow: 0 2px 8px rgba(232,144,158,0.2);
}
.btn-premium.loading,
.btn-premium.disabled {
  opacity: 0.55;
}
.btn-premium.loading:active,
.btn-premium.disabled:active {
  transform: none;
}

/* ===== Danger Button — 柔红，与玫瑰体系同族 ===== */
.btn-danger {
  background: var(--glass-bg);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: #F97373;
  text-align: center;
  padding: 26rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
  border: 1px solid rgba(249,115,115,0.28);
  transition: var(--transition);
}
.btn-danger:active {
  transform: scale(0.95);
  background: rgba(249,115,115,0.12);
}

/* ===== Header Gradient ===== */
.header-gradient {
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,0.1);
  position: relative;
  overflow: hidden;
  z-index: 10;
}
.header-gradient::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(232,144,158,0.2) 0%, transparent 60%);
  border-radius: 50%;
  animation: float 8s var(--ease-out) infinite alternate;
}
.header-gradient::after {
  content: '';
  position: absolute;
  bottom: -20%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(196,160,210,0.1) 0%, transparent 60%);
  border-radius: 50%;
  animation: float 6s var(--ease-out) infinite alternate-reverse;
}
@keyframes float {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(20rpx, -20rpx) scale(1.1); }
}

/* ===== Fade In ===== */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.fade-in {
  animation: fadeIn 0.5s var(--ease-out) forwards;
}
.fade-in-d1 { animation-delay: 0.1s; }
.fade-in-d2 { animation-delay: 0.2s; }
.fade-in-d3 { animation-delay: 0.3s; }

/* ===== Loading Spinner ===== */
.loading-view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255,255,255,0.1);
  border-top-color: #E8909E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  box-shadow: 0 0 20px rgba(232,144,158,0.2);
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ===== Pulse Animation（仅空态心跳使用） ===== */
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

/* ===== List/Menu Item Press ===== */
.list-item:active, .menu-item:active {
  transform: scale(0.97);
}

/* ===== Calendar Grid Transition ===== */
.calendar-grid {
  transition: opacity 0.25s ease, transform 0.25s ease;
}
.calendar-grid.changing {
  opacity: 0;
  transform: translateY(10rpx) scale(0.98);
}

/* ===== Nav Button Spring ===== */
.nav-btn {
  transition: transform 0.25s var(--ease-spring), background-color 0.25s var(--ease-out);
}
.nav-btn:active {
  transform: scale(0.9);
}

/* Safe Area */
.safe-top { padding-top: env(safe-area-inset-top, 88rpx); }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom, 20rpx); }

/* ===== Input Placeholder ===== */
.input-placeholder {
  color: var(--text-tertiary);
}

/* ===== Reduced Motion — 全局兜底 ===== */
@media (prefers-reduced-motion: reduce) {
  .page,
  .page::before,
  .glow-orb,
  .header-gradient::before,
  .header-gradient::after {
    animation: none;
  }
  .fade-in,
  .fade-in-d1,
  .fade-in-d2,
  .fade-in-d3 {
    animation: none;
  }
  .premium-card,
  .btn-premium,
  .btn-danger,
  .nav-btn,
  .nav-back,
  .nav-back-surface,
  .list-item,
  .menu-item,
  .calendar-grid {
    animation: none;
    transition: none;
  }
  .loading-spinner,
  .cycle-card,
  .profile-card,
  .hero-icon,
  .tab {
    animation: none;
    transition: none;
  }
}
